      "Bash(npm test *)",
      "Bash(npx tsc *)",
      "Bash(gh pr *)",
      "Bash(git add *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
