  "nodes": {
    "var_98b772880011": {
      "type": "variant",
      "label": "Artisan's Patina — Hardware Collection",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Crimson+Pro:ital,wght@0,200..900;1,200..900&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  :root {\n    --beige: #F5F5DC;\n    --brown: #6B4423;\n    --palm: #8A9A5B;\n    --camel: #C19A6B;\n  }\n\n  body {\n    background-color: var(--beige);\n    color: var(--brown);\n    font-family: 'Crimson Pro', serif;\n    overflow-x: clip; /* Fix for position sticky */\n  }\n\n  .font-heading { font-family: 'Newsreader', serif; }\n  .font-body { font-family: 'Crimson Pro', serif; }\n\n  /* Utility shapes */\n  .scoop-mask {\n    border-bottom-left-radius: 50% 120px;\n    border-bottom-right-radius: 50% 120px;\n  }\n\n  .washi-tape {\n    position: absolute;\n    height: 24px;\n    width: 80px;\n    background: rgba(193, 154, 107, 0.35);\n    z-index: 10;\n    pointer-events: none;\n    mix-blend-mode: multiply;\n    mask-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 100 28' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 4 Q2 0 10 2 T25 1 T40 3 T60 2 T80 4 T100 2 L100 24 Q95 28 85 25 T70 27 T50 24 T30 26 T10 24 T0 26 Z' fill='black'/%3E%3C/svg%3E\");\n    mask-size: 100% 100%;\n  }\n\n  .no-scrollbar::-webkit-scrollbar { display: none; }\n  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n\n  /* Letter styling */\n  .letter-paper {\n    background: #fdfdf5;\n    background-image: radial-gradient(#6B4423 0.5px, transparent 0.5px);\n    background-size: 40px 40px;\n    background-position: 0 0;\n    box-shadow: 0 10px 40px -10px rgba(107, 68, 35, 0.08);\n  }\n\n  .handwritten-lines {\n    background-image: repeating-linear-gradient(transparent, transparent 31px, rgba(107, 68, 35, 0.1) 31px, rgba(107, 68, 35, 0.1) 32px);\n    line-height: 32px;\n  }\n\n  .scroll-progress {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 4px;\n    background: var(--brown);\n    transform-origin: left;\n    transform: scaleX(0);\n    z-index: 1000;\n  }\n\n  .hero-img-container, .profile-img {\n    will-change: transform;\n  }\n\n  .profile-img {\n    filter: contrast(1.1) brightness(0.95) sepia(0.2);\n  }\n\n  /* Zigzag spacing */\n  .zigzag-block:nth-child(even) { flex-direction: row-reverse; }\n\n  .leaf-marker {\n    filter: invert(24%) sepia(35%) saturate(1611%) hue-rotate(338deg) brightness(92%) contrast(85%);\n  }\n\n  /* Grain effect */\n  .grain-overlay {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n    z-index: 9999;\n    opacity: 0.04;\n    background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n  }\n</style>\n<link data-kid=\"1\" data-name=\"lenis stylesheet link\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" rel=\"stylesheet\"/>\n<div class=\"grain-overlay\" data-kid=\"2\" data-name=\"grain overlay effect layer\">\n</div>\n<div class=\"scroll-progress\" data-dynamic=\"true\" data-kid=\"3\" data-name=\"scroll progress bar\" data-reason=\"width scaled by scroll event\" id=\"progress-bar\">\n</div>\n<main class=\"w-full max-w-[1280px] mx-auto bg-[var(--beige)] relative overflow-x-clip\" data-kid=\"4\" data-name=\"page layout container\">\n    <!-- Header -->\n    <header class=\"flex justify-between items-baseline px-12 py-8 border-b border-[var(--brown)]/10\" data-kid=\"4-1\" data-name=\"header navigation bar\">\n        <div class=\"font-heading text-3xl font-bold tracking-tight\" data-kid=\"4-1-1\" data-name=\"brand logo text\">\n            HC / FIELD NOTES\n        </div>\n        <div class=\"text-xs uppercase tracking-[0.3em] font-medium opacity-60\" data-kid=\"4-1-2\" data-name=\"issue metadata text\">\n            Issue No. 04 — Aug 2026\n        </div>\n        <nav class=\"flex gap-8 items-center\" data-kid=\"4-1-3\" data-name=\"navigation menu container\">\n            <a class=\"text-xs uppercase tracking-widest hover:italic transition-all\" data-kid=\"4-1-3-1\" data-name=\"browse collection link\" href=\"#\">\n                Browse Collection\n            </a>\n            <div class=\"w-8 h-[1px] bg-[var(--brown)]/30\" data-kid=\"4-1-3-2\" data-name=\"decorative line separator\">\n            </div>\n            <button class=\"ti ti-menu-2 text-xl\" data-kid=\"4-1-3-3\" data-name=\"menu hamburger icon\">\n            </button>\n        </nav>\n    </header>\n    <!-- Hero -->\n    <section class=\"relative px-12 pt-12 pb-32\" data-kid=\"4-2\" data-name=\"hero section\">\n        <div class=\"relative max-w-5xl mx-auto\" data-kid=\"4-2-1\" data-name=\"hero visual container\">\n            <div class=\"hero-img-container relative overflow-hidden scoop-mask h-[800px] shadow-2xl\" data-kid=\"4-2-1-1\" data-name=\"hero image frame\">\n                <img alt=\"Artisan hands polishing a custom brass door knob — photo by Maksim Goncharenok\" class=\"hero-image w-full h-full object-cover\" data-kid=\"4-2-1-1-1\" data-name=\"hero background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/4354626/pexels-photo-4354626.jpeg?auto=compress&cs=tinysrgb&w=1400&q=85\"/>\n                <div class=\"absolute inset-0 bg-black/5\" data-kid=\"4-2-1-1-2\" data-name=\"hero image overlay\">\n                </div>\n            </div>\n            <div class=\"absolute -bottom-24 left-0 z-10 w-full md:w-auto p-4 md:p-0\" data-kid=\"4-2-1-2\" data-name=\"hero content wrapper\">\n                <h1 class=\"font-heading text-8xl md:text-9xl leading-[0.85] font-extralight text-[var(--brown)] drop-shadow-sm\" data-kid=\"4-2-1-2-1\" data-name=\"hero main headline\">\n                    CRAFTED FOR\n                    <br data-kid=\"4-2-1-2-1-1\" data-name=\"headline line break\"/>\n                    <span class=\"italic pl-16 md:pl-32 text-[var(--camel)]\" data-kid=\"4-2-1-2-1-2\" data-name=\"italic headline highlight\">\n                        THE TOUCH\n                    </span>\n                </h1>\n                <div class=\"mt-12 flex flex-col md:flex-row gap-8 md:gap-12 items-start md:items-end relative\" data-kid=\"4-2-1-2-2\" data-name=\"hero call-to-action section\">\n                    <p class=\"max-w-md text-xl md:text-2xl font-light italic leading-relaxed text-[var(--brown)]/90 bg-[var(--beige)]/80 backdrop-blur-sm p-4 rounded-lg border border-[var(--brown)]/5\" data-kid=\"4-2-1-2-2-1\" data-name=\"hero description text\">\n                        Hardware is the first handshake between inhabitant and architecture. Objects designed to age with grace.\n                    </p>\n                    <div class=\"flex flex-col gap-6 items-center\" data-kid=\"4-2-1-2-2-2\" data-name=\"interactive button group\">\n                        <button class=\"group relative px-12 py-5 bg-[var(--brown)] text-[var(--beige)] rounded-full text-sm uppercase tracking-widest overflow-hidden shadow-lg hover:shadow-xl transition-shadow\" data-kid=\"4-2-1-2-2-2-1\" data-name=\"enter workshop button\">\n                            <span class=\"relative z-10\" data-kid=\"4-2-1-2-2-2-1-1\" data-name=\"button label text\">\n                                Enter the Workshop\n                            </span>\n                            <div class=\"absolute inset-0 bg-[var(--camel)] translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-out\" data-kid=\"4-2-1-2-2-2-1-2\" data-name=\"button hover background layer\">\n                            </div>\n                        </button>\n                        <div class=\"animate-bounce opacity-40\" data-kid=\"4-2-1-2-2-2-2\" data-name=\"down arrow icon container\">\n                            <i class=\"ti ti-arrow-down text-xl\" data-kid=\"4-2-1-2-2-2-2-1\" data-name=\"down arrow icon\">\n                            </i>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Philosophy -->\n    <section class=\"px-12 py-40 space-y-48 overflow-hidden\" data-kid=\"4-3\" data-name=\"philosophy section\">\n        <!-- Card 1 -->\n        <div class=\"zigzag-block flex items-center gap-20 mr-auto w-[95%] opacity-0 js-reveal\" data-kid=\"4-3-1\" data-name=\"philosophy card 1\">\n            <div class=\"w-1/2 aspect-[4/5] bg-[var(--camel)]/10 overflow-hidden relative shadow-inner\" data-kid=\"4-3-1-1\" data-name=\"card image container\">\n                <img alt=\"Artisan hands holding delicate hardware — photo by cottonbro studio on Pexels\" class=\"w-full h-full object-cover mix-blend-multiply opacity-90\" data-kid=\"4-3-1-1-1\" data-name=\"card image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/6654801/pexels-photo-6654801.jpeg?auto=compress&cs=tinysrgb&w=1000&q=80\"/>\n            </div>\n            <div class=\"w-1/3 space-y-8\" data-kid=\"4-3-1-2\" data-name=\"card content column\">\n                <span class=\"text-[var(--palm)] font-bold text-lg\" data-kid=\"4-3-1-2-1\" data-name=\"section label text\">\n                    — I. THE RITUAL\n                </span>\n                <h3 class=\"font-heading text-5xl leading-tight\" data-kid=\"4-3-1-2-2\" data-name=\"card headline\">\n                    The Patience of Forging\n                </h3>\n                <p class=\"text-xl leading-relaxed opacity-80\" data-kid=\"4-3-1-2-3\" data-name=\"card description text\">\n                    Every handle begins as a raw billet of recycled brass, heated until it glows with the intensity of a dying sun. We don't rush the flame; the metal dictates its own timing.\n                </p>\n            </div>\n        </div>\n        <!-- Card 2 -->\n        <div class=\"zigzag-block flex items-center gap-20 ml-auto flex-row-reverse w-[95%] opacity-0 js-reveal\" data-kid=\"4-3-2\" data-name=\"philosophy card 2\">\n            <div class=\"w-1/2 aspect-[4/5] bg-[var(--camel)]/10 overflow-hidden relative shadow-inner\" data-kid=\"4-3-2-1\" data-name=\"card image container\">\n                <img alt=\"Detailed view of hardware polishing — photo by Maksim Goncharenok on Pexels\" class=\"w-full h-full object-cover mix-blend-multiply opacity-90\" data-kid=\"4-3-2-1-1\" data-name=\"card image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/4354613/pexels-photo-4354613.jpeg?auto=compress&cs=tinysrgb&w=1000&q=80\"/>\n            </div>\n            <div class=\"w-1/3 space-y-8\" data-kid=\"4-3-2-2\" data-name=\"card content column\">\n                <span class=\"text-[var(--palm)] font-bold text-lg\" data-kid=\"4-3-2-2-1\" data-name=\"section label text\">\n                    — II. INTEGRITY\n                </span>\n                <h3 class=\"font-heading text-5xl leading-tight\" data-kid=\"4-3-2-2-2\" data-name=\"card headline\">\n                    Evidence of the Hand\n                </h3>\n                <p class=\"text-xl leading-relaxed opacity-80\" data-kid=\"4-3-2-2-3\" data-name=\"card description text\">\n                    Machine perfection is sterile. We prefer the micro-variations that make each piece a unique sculpture. Our artisans hand-polish each curve, ensuring every grip feels familiar.\n                </p>\n            </div>\n        </div>\n        <!-- Break Pattern Full Bleed -->\n        <div class=\"w-full h-[600px] overflow-hidden opacity-0 js-reveal\" data-kid=\"4-3-3\" data-name=\"full bleed break image container\">\n            <img alt=\"Molten metal being poured into a mold — photo by Bulat Khamitov on Pexels\" class=\"w-full h-full object-cover grayscale brightness-75 contrast-125\" data-kid=\"4-3-3-1\" data-name=\"full bleed break image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/11020230/pexels-photo-11020230.jpeg?auto=compress&cs=tinysrgb&w=1600&q=85\"/>\n            <div class=\"p-8 text-center mt-8\" data-kid=\"4-3-3-2\" data-name=\"image caption container\">\n                <p class=\"text-xs uppercase tracking-[0.4em] opacity-40\" data-kid=\"4-3-3-2-1\" data-name=\"image caption text\">\n                    Captured at the Foundry, July 2026\n                </p>\n            </div>\n        </div>\n    </section>\n    <!-- Collection Selector -->\n    <section class=\"py-32 overflow-hidden\" data-kid=\"4-4\" data-name=\"collection library section\">\n        <div class=\"px-12 flex justify-between items-end mb-16\" data-kid=\"4-4-1\" data-name=\"section title and instructions\">\n            <div class=\"space-y-4\" data-kid=\"4-4-1-1\" data-name=\"section title group\">\n                <h2 class=\"font-heading text-6xl\" data-kid=\"4-4-1-1-1\" data-name=\"section headline\">\n                    Series Library\n                </h2>\n                <p class=\"text-xl italic opacity-60\" data-kid=\"4-4-1-1-2\" data-name=\"section subheadline\">\n                    A curated taxonomy of form and function.\n                </p>\n            </div>\n            <div class=\"flex items-center gap-4 text-xs uppercase tracking-widest font-bold opacity-40\" data-kid=\"4-4-1-2\" data-name=\"scroll instruction group\">\n                <span data-kid=\"4-4-1-2-1\" data-name=\"scroll instruction text\">\n                    Scroll Horizontal\n                </span>\n                <div class=\"w-12 h-[1px] bg-[var(--brown)]\" data-kid=\"4-4-1-2-2\" data-name=\"instruction line separator\">\n                </div>\n            </div>\n        </div>\n        <div class=\"flex gap-16 overflow-x-auto px-12 pb-12 no-scrollbar cursor-grab active:cursor-grabbing\" data-kid=\"4-4-2\" data-name=\"horizontal scroll collection container\" id=\"horizontal-scroll\">\n            <!-- Collection 1 -->\n            <div class=\"min-w-[500px] group\" data-kid=\"4-4-2-1\" data-name=\"collection card 1\">\n                <div class=\"relative aspect-[3/4] overflow-hidden bg-[var(--camel)]/5\" data-kid=\"4-4-2-1-1\" data-name=\"card visual container\">\n                    <div class=\"washi-tape -top-3 left-12 -rotate-3 bg-[#D4C3A3]/60\" data-kid=\"4-4-2-1-1-1\" data-name=\"decorative washi tape element\">\n                    </div>\n                    <img alt=\"Heritage Series Hardware — photo by Joel Timothy\" class=\"w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700\" data-kid=\"4-4-2-1-1-2\" data-name=\"card background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1565841746841-c8d8a85c3d2b?auto=format&w=800&q=80&fit=crop\"/>\n                    <div class=\"absolute bottom-6 left-6 text-[var(--beige)] z-10\" data-kid=\"4-4-2-1-1-3\" data-name=\"card badge container\">\n                        <span class=\"text-xs tracking-widest uppercase opacity-70\" data-kid=\"4-4-2-1-1-3-1\" data-name=\"card series label\">\n                            Series 01\n                        </span>\n                        <h4 class=\"font-heading text-4xl mt-2\" data-kid=\"4-4-2-1-1-3-2\" data-name=\"card series title\">\n                            Heritage\n                        </h4>\n                    </div>\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-black/60 to-transparent\" data-kid=\"4-4-2-1-1-4\" data-name=\"card gradient overlay\">\n                    </div>\n                </div>\n                <p class=\"mt-6 text-lg italic opacity-70 leading-relaxed max-w-[400px]\" data-kid=\"4-4-2-1-2\" data-name=\"card description text\">\n                    Sand-cast brass with a deep, natural oil finish. Designed to patina quickly, reflecting the life of the home.\n                </p>\n            </div>\n            <!-- Collection 2 -->\n            <div class=\"min-w-[500px] group\" data-kid=\"4-4-2-2\" data-name=\"collection card 2\">\n                <div class=\"relative aspect-[3/4] overflow-hidden bg-[var(--camel)]/5\" data-kid=\"4-4-2-2-1\" data-name=\"card visual container\">\n                    <div class=\"washi-tape -top-3 right-12 rotate-2 bg-[#C19A6B]/50\" data-kid=\"4-4-2-2-1-1\" data-name=\"decorative washi tape element\">\n                    </div>\n                    <img alt=\"Modernist Core Collection — photo by Isaac Burke\" class=\"w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700\" data-kid=\"4-4-2-2-1-2\" data-name=\"card background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1624639945008-aeaab09a9282?auto=format&w=800&q=80&fit=crop\"/>\n                    <div class=\"absolute bottom-6 left-6 text-[var(--beige)] z-10\" data-kid=\"4-4-2-2-1-3\" data-name=\"card badge container\">\n                        <span class=\"text-xs tracking-widest uppercase opacity-70\" data-kid=\"4-4-2-2-1-3-1\" data-name=\"card series label\">\n                            Series 02\n                        </span>\n                        <h4 class=\"font-heading text-4xl mt-2\" data-kid=\"4-4-2-2-1-3-2\" data-name=\"card series title\">\n                            Modernist Core\n                        </h4>\n                    </div>\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-black/60 to-transparent\" data-kid=\"4-4-2-2-1-4\" data-name=\"card gradient overlay\">\n                    </div>\n                </div>\n                <p class=\"mt-6 text-lg italic opacity-70 leading-relaxed max-w-[400px]\" data-kid=\"4-4-2-2-2\" data-name=\"card description text\">\n                    Precision-machined silhouettes with softened edges. A study in geometric reduction and material purity.\n                </p>\n            </div>\n            <!-- Collection 3 -->\n            <div class=\"min-w-[500px] group\" data-kid=\"4-4-2-3\" data-name=\"collection card 3\">\n                <div class=\"relative aspect-[3/4] overflow-hidden bg-[var(--camel)]/5\" data-kid=\"4-4-2-3-1\" data-name=\"card visual container\">\n                    <div class=\"washi-tape -top-4 left-24 -rotate-1 bg-[#8A9A5B]/40\" data-kid=\"4-4-2-3-1-1\" data-name=\"decorative washi tape element\">\n                    </div>\n                    <img alt=\"Soft Geometry Hardware — photo by LOGAN WEAVER\" class=\"w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700\" data-kid=\"4-4-2-3-1-2\" data-name=\"card background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1605256801525-8fda13950b82?auto=format&w=800&q=80&fit=crop\"/>\n                    <div class=\"absolute bottom-6 left-6 text-[var(--beige)] z-10\" data-kid=\"4-4-2-3-1-3\" data-name=\"card badge container\">\n                        <span class=\"text-xs tracking-widest uppercase opacity-70\" data-kid=\"4-4-2-3-1-3-1\" data-name=\"card series label\">\n                            Series 03\n                        </span>\n                        <h4 class=\"font-heading text-4xl mt-2\" data-kid=\"4-4-2-3-1-3-2\" data-name=\"card series title\">\n                            Soft Geometry\n                        </h4>\n                    </div>\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-black/60 to-transparent\" data-kid=\"4-4-2-3-1-4\" data-name=\"card gradient overlay\">\n                    </div>\n                </div>\n                <p class=\"mt-6 text-lg italic opacity-70 leading-relaxed max-w-[400px]\" data-kid=\"4-4-2-3-2\" data-name=\"card description text\">\n                    Organic forms inspired by water-worn pebbles. For those who seek a gentler interface with their environment.\n                </p>\n            </div>\n            <div class=\"min-w-[200px] shrink-0\" data-kid=\"4-4-2-4\" data-name=\"card list padding\">\n            </div>\n            <!-- Peek affordance -->\n        </div>\n    </section>\n    <!-- Maker Profile -->\n    <section class=\"px-12 py-40 border-t border-[var(--brown)]/10\" data-kid=\"4-5\" data-name=\"maker profile section\">\n        <div class=\"max-w-5xl mx-auto flex flex-col md:flex-row gap-20 items-start\" data-kid=\"4-5-1\" data-name=\"profile layout wrapper\">\n            <div class=\"w-full md:w-2/5 relative\" data-kid=\"4-5-1-1\" data-name=\"profile image frame\">\n                <div class=\"aspect-square overflow-hidden border border-[var(--brown)]/10 p-2 bg-white\" data-kid=\"4-5-1-1-1\" data-name=\"profile image container\">\n                    <img alt=\"Mira Sen, Material Editor — photo by Nathalie Jolie\" class=\"profile-img w-full h-full object-cover grayscale\" data-dynamic=\"true\" data-kid=\"4-5-1-1-1-1\" data-name=\"profile portrait image\" data-reason=\"skewX transformed by scroll velocity\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1527417793867-f1597238c028?auto=format&w=800&q=80&fit=crop\"/>\n                </div>\n            </div>\n            <div class=\"w-full md:w-3/5 space-y-8\" data-kid=\"4-5-1-2\" data-name=\"profile text column\">\n                <div data-kid=\"4-5-1-2-1\" data-name=\"profile header group\">\n                    <div class=\"flex items-center gap-4\" data-kid=\"4-5-1-2-1-1\" data-name=\"profile name group\">\n                        <h5 class=\"font-heading text-5xl font-extralight tracking-tight\" data-kid=\"4-5-1-2-1-1-1\" data-name=\"profile name text\">\n                            Mira Sen\n                        </h5>\n                        <div class=\"w-8 h-[1px] bg-[var(--brown)]/20\" data-kid=\"4-5-1-2-1-1-2\" data-name=\"decorative line\">\n                        </div>\n                    </div>\n                    <p class=\"uppercase text-xs tracking-[0.4em] text-[var(--palm)] font-bold mt-2\" data-kid=\"4-5-1-2-1-2\" data-name=\"profile role title\">\n                        Material Editor & Co-Founder\n                    </p>\n                </div>\n                <p class=\"text-3xl font-light italic leading-snug text-[var(--brown)]/90 font-heading border-l-2 border-[var(--camel)]/30 pl-8 py-2\" data-kid=\"4-5-1-2-2\" data-name=\"profile quote\">\n                    \"I believe that the objects we touch every day should have a soul. My work is a constant dialogue between industrial resilience and the poetic fragility of time.\"\n                </p>\n                <p class=\"text-xl opacity-80 leading-relaxed max-w-lg font-body\" data-kid=\"4-5-1-2-3\" data-name=\"profile biography text\">\n                    With a background in both metallurgy and architectural history, Mira oversees every finish that leaves our studio, ensuring the patina journey begins with intent.\n                </p>\n                <div class=\"flex items-center gap-2 opacity-30 italic text-sm\" data-kid=\"4-5-1-2-4\" data-name=\"profile badge container\">\n                    <img class=\"w-4 h-4 leaf-marker\" data-kid=\"4-5-1-2-4-1\" data-name=\"leaf icon\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/solid-leaf.svg\"/>\n                    <span data-kid=\"4-5-1-2-4-2\" data-name=\"correspondent status text\">\n                        Field Note Correspondent since 2021\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Newsletter Invitation -->\n    <section class=\"px-12 py-40\" data-kid=\"4-6\" data-name=\"newsletter section\">\n        <div class=\"max-w-4xl mx-auto letter-paper p-12 md:p-20 relative overflow-hidden border border-[var(--brown)]/5\" data-kid=\"4-6-1\" data-name=\"newsletter form container\">\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-16 relative z-10\" data-kid=\"4-6-1-1\" data-name=\"form layout grid\">\n                <div class=\"space-y-8 handwritten-lines\" data-kid=\"4-6-1-1-1\" data-name=\"newsletter header content\">\n                    <div class=\"space-y-2\" data-kid=\"4-6-1-1-1-1\" data-name=\"newsletter meta group\">\n                        <span class=\"text-xs uppercase tracking-[0.3em] opacity-40 font-bold\" data-kid=\"4-6-1-1-1-1-1\" data-name=\"postmark text\">\n                            Postmarked: London, 2026\n                        </span>\n                        <h3 class=\"font-heading text-5xl italic leading-tight\" data-kid=\"4-6-1-1-1-1-2\" data-name=\"newsletter headline\">\n                            Join our private ledger\n                        </h3>\n                    </div>\n                    <p class=\"text-xl opacity-90 leading-relaxed font-body italic\" data-kid=\"4-6-1-1-1-2\" data-name=\"newsletter body text\">\n                        \"We believe the best stories are written in the objects we use every day. Join our circle of keepers as we document the journey of metal and form.\"\n                    </p>\n                    <div class=\"pt-8 opacity-40 text-sm\" data-kid=\"4-6-1-1-1-3\" data-name=\"newsletter signature\">\n                        Sincerely,\n                        <br data-kid=\"4-6-1-1-1-3-1\" data-name=\"signature line break\"/>\n                        <span class=\"font-heading text-2xl\" data-kid=\"4-6-1-1-1-3-2\" data-name=\"signature name\">\n                            The Founders\n                        </span>\n                    </div>\n                </div>\n                <div class=\"flex flex-col justify-center bg-white/40 p-10 rounded-sm border border-[var(--brown)]/5 backdrop-blur-xs\" data-kid=\"4-6-1-1-2\" data-name=\"newsletter form\">\n                    <p class=\"text-sm uppercase tracking-widest mb-10 opacity-60 font-bold\" data-kid=\"4-6-1-1-2-1\" data-name=\"form title\">\n                        Entry Request\n                    </p>\n                    <form class=\"space-y-12\" data-kid=\"4-6-1-1-2-2\" data-name=\"form fields container\">\n                        <div class=\"relative group\" data-kid=\"4-6-1-1-2-2-1\" data-name=\"email input group\">\n                            <input class=\"w-full bg-transparent border-b-2 border-[var(--brown)]/20 pb-4 outline-none font-heading text-2xl italic placeholder:opacity-50 focus:border-[var(--brown)] transition-colors\" data-kid=\"4-6-1-1-2-2-1-1\" data-name=\"email input field\" placeholder=\"Your email address...\" required=\"\" type=\"email\"/>\n                            <label class=\"absolute -top-8 left-0 text-xs uppercase tracking-widest opacity-60 font-bold\" data-kid=\"4-6-1-1-2-2-1-2\" data-name=\"email field label\">\n                                Correspondence Channel\n                            </label>\n                        </div>\n                        <button class=\"group relative w-full px-8 py-5 bg-[var(--brown)] text-[var(--beige)] text-sm uppercase tracking-widest overflow-hidden transition-all hover:translate-y-[-2px] active:translate-y-0 shadow-md\" data-kid=\"4-6-1-1-2-2-2\" data-name=\"submit button\">\n                            <span class=\"relative z-10 flex items-center justify-center gap-3\" data-kid=\"4-6-1-1-2-2-2-1\" data-name=\"submit button content\">\n                                Send Invitation Request\n                                <i class=\"ti ti-arrow-right\" data-kid=\"4-6-1-1-2-2-2-1-1\" data-name=\"arrow icon\">\n                                </i>\n                            </span>\n                            <div class=\"absolute inset-0 bg-[var(--palm)] translate-x-[-100%] group-hover:translate-x-0 transition-transform duration-500 ease-out\" data-kid=\"4-6-1-1-2-2-2-2\" data-name=\"button hover background layer\">\n                            </div>\n                        </button>\n                        <p class=\"text-[10px] uppercase tracking-widest opacity-40 text-center\" data-kid=\"4-6-1-1-2-2-3\" data-name=\"disclaimer text\">\n                            Privacy is respected by the hand that crafts.\n                        </p>\n                    </form>\n                </div>\n            </div>\n            <!-- Letter stamps -->\n            <div class=\"absolute top-8 right-8 w-20 h-24 border-2 border-dashed border-[var(--brown)]/10 flex flex-col items-center justify-center p-2 opacity-20 rotate-3\" data-kid=\"4-6-1-2\" data-name=\"decorative letter stamp\">\n                <div class=\"text-[10px] uppercase font-bold\" data-kid=\"4-6-1-2-1\" data-name=\"stamp class text\">\n                    1st Class\n                </div>\n                <div class=\"w-10 h-10 my-1 bg-[var(--brown)]/20 rounded-full\" data-kid=\"4-6-1-2-2\" data-name=\"stamp icon placeholder\">\n                </div>\n                <div class=\"text-[8px] uppercase tracking-tighter\" data-kid=\"4-6-1-2-3\" data-name=\"stamp origin text\">\n                    Foundry Works\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Fat Footer -->\n    <footer class=\"bg-[var(--brown)] text-[var(--beige)] px-12 py-24\" data-kid=\"4-7\" data-name=\"footer bar\">\n        <div class=\"grid grid-cols-1 md:grid-cols-4 gap-20 md:gap-12\" data-kid=\"4-7-1\" data-name=\"footer content grid\">\n            <div class=\"space-y-8\" data-kid=\"4-7-1-1\" data-name=\"brand and social column\">\n                <div class=\"font-heading text-3xl font-bold tracking-tighter\" data-kid=\"4-7-1-1-1\" data-name=\"footer brand name\">\n                    HC / FIELD NOTES\n                </div>\n                <p class=\"text-lg opacity-60 italic leading-relaxed\" data-kid=\"4-7-1-1-2\" data-name=\"footer description text\">\n                    A publication of the Hardware Collection studio. Exploring the intersection of metal, touch, and permanence.\n                </p>\n                <div class=\"flex gap-6\" data-kid=\"4-7-1-1-3\" data-name=\"social icons row\">\n                    <a class=\"w-10 h-10 rounded-full border border-[var(--beige)]/20 flex items-center justify-center hover:bg-[var(--beige)] hover:text-[var(--brown)] transition-all\" data-kid=\"4-7-1-1-3-1\" data-name=\"instagram link\" href=\"#\">\n                        <i class=\"ti ti-brand-instagram text-xl\" data-kid=\"4-7-1-1-3-1-1\" data-name=\"instagram icon\">\n                        </i>\n                    </a>\n                    <a class=\"w-10 h-10 rounded-full border border-[var(--beige)]/20 flex items-center justify-center hover:bg-[var(--beige)] hover:text-[var(--brown)] transition-all\" data-kid=\"4-7-1-1-3-2\" data-name=\"twitter link\" href=\"#\">\n                        <i class=\"ti ti-brand-twitter text-xl\" data-kid=\"4-7-1-1-3-2-1\" data-name=\"twitter icon\">\n                        </i>\n                    </a>\n                    <a class=\"w-10 h-10 rounded-full border border-[var(--beige)]/20 flex items-center justify-center hover:bg-[var(--beige)] hover:text-[var(--brown)] transition-all\" data-kid=\"4-7-1-1-3-3\" data-name=\"pinterest link\" href=\"#\">\n                        <i class=\"ti ti-brand-pinterest text-xl\" data-kid=\"4-7-1-1-3-3-1\" data-name=\"pinterest icon\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n            <div class=\"space-y-8\" data-kid=\"4-7-1-2\" data-name=\"collection links column\">\n                <h6 class=\"text-xs uppercase tracking-[0.3em] font-bold opacity-40\" data-kid=\"4-7-1-2-1\" data-name=\"column header\">\n                    Collections\n                </h6>\n                <ul class=\"space-y-4 text-lg font-light opacity-80\" data-kid=\"4-7-1-2-2\" data-name=\"link list\">\n                    <li data-kid=\"4-7-1-2-2-1\" data-name=\"list item 1\">\n                        <a class=\"hover:text-[var(--camel)] transition-colors italic\" data-kid=\"4-7-1-2-2-1-1\" data-name=\"heritage series link\" href=\"#\">\n                            Heritage Series\n                        </a>\n                    </li>\n                    <li data-kid=\"4-7-1-2-2-2\" data-name=\"list item 2\">\n                        <a class=\"hover:text-[var(--camel)] transition-colors italic\" data-kid=\"4-7-1-2-2-2-1\" data-name=\"modernist core link\" href=\"#\">\n                            Modernist Core\n                        </a>\n                    </li>\n                    <li data-kid=\"4-7-1-2-2-3\" data-name=\"list item 3\">\n                        <a class=\"hover:text-[var(--camel)] transition-colors italic\" data-kid=\"4-7-1-2-2-3-1\" data-name=\"soft geometry link\" href=\"#\">\n                            Soft Geometry\n                        </a>\n                    </li>\n                    <li data-kid=\"4-7-1-2-2-4\" data-name=\"list item 4\">\n                        <a class=\"hover:text-[var(--camel)] transition-colors italic\" data-kid=\"4-7-1-2-2-4-1\" data-name=\"foundry oddities link\" href=\"#\">\n                            Foundry Oddities\n                        </a>\n                    </li>\n                </ul>\n            </div>\n            <div class=\"space-y-8\" data-kid=\"4-7-1-3\" data-name=\"studio links column\">\n                <h6 class=\"text-xs uppercase tracking-[0.3em] font-bold opacity-40\" data-kid=\"4-7-1-3-1\" data-name=\"column header\">\n                    Studio\n                </h6>\n                <ul class=\"space-y-4 text-lg font-light opacity-80\" data-kid=\"4-7-1-3-2\" data-name=\"link list\">\n                    <li data-kid=\"4-7-1-3-2-1\" data-name=\"list item 1\">\n                        <a class=\"hover:text-[var(--camel)] transition-colors italic\" data-kid=\"4-7-1-3-2-1-1\" data-name=\"philosophy link\" href=\"#\">\n                            Our Philosophy\n                        </a>\n                    </li>\n                    <li data-kid=\"4-7-1-3-2-2\" data-name=\"list item 2\">\n                        <a class=\"hover:text-[var(--camel)] transition-colors italic\" data-kid=\"4-7-1-3-2-2-1\" data-name=\"bespoke inquiry link\" href=\"#\">\n                            Bespoke Inquiry\n                        </a>\n                    </li>\n                    <li data-kid=\"4-7-1-3-2-3\" data-name=\"list item 3\">\n                        <a class=\"hover:text-[var(--camel)] transition-colors italic\" data-kid=\"4-7-1-3-2-3-1\" data-name=\"material care link\" href=\"#\">\n                            Material Care\n                        </a>\n                    </li>\n                    <li data-kid=\"4-7-1-3-2-4\" data-name=\"list item 4\">\n                        <a class=\"hover:text-[var(--camel)] transition-colors italic\" data-kid=\"4-7-1-3-2-4-1\" data-name=\"wholesale portal link\" href=\"#\">\n                            Wholesale Portal\n                        </a>\n                    </li>\n                </ul>\n            </div>\n            <div class=\"space-y-8\" data-kid=\"4-7-1-4\" data-name=\"inquiries column\">\n                <h6 class=\"text-xs uppercase tracking-[0.3em] font-bold opacity-40\" data-kid=\"4-7-1-4-1\" data-name=\"column header\">\n                    Inquiries\n                </h6>\n                <div class=\"space-y-4 opacity-70 leading-relaxed text-lg\" data-kid=\"4-7-1-4-2\" data-name=\"contact details container\">\n                    <p data-kid=\"4-7-1-4-2-1\" data-name=\"studio address\">\n                        London Studio: 124 Patina Way, SE1 0HT\n                    </p>\n                    <p data-kid=\"4-7-1-4-2-2\" data-name=\"email address\">\n                        hello@hardwarefieldnotes.co\n                    </p>\n                    <p data-kid=\"4-7-1-4-2-3\" data-name=\"phone number\">\n                        +44 (0) 20 7946 0123\n                    </p>\n                </div>\n            </div>\n        </div>\n        <div class=\"mt-32 pt-12 border-t border-[var(--beige)]/10 flex flex-col md:flex-row justify-between items-center gap-8\" data-kid=\"4-7-2\" data-name=\"footer bottom row\">\n            <div class=\"text-[10px] uppercase tracking-[0.4em] opacity-30 text-center md:text-left\" data-kid=\"4-7-2-1\" data-name=\"copyright notice\">\n                © 2026 Hardware Collection Studio. All rights reserved. Field Notes Issue 04.\n            </div>\n            <div class=\"flex gap-8 text-[10px] uppercase tracking-[0.4em] opacity-30\" data-kid=\"4-7-2-2\" data-name=\"legal links row\">\n                <a class=\"hover:opacity-100 transition-opacity\" data-kid=\"4-7-2-2-1\" data-name=\"privacy policy link\" href=\"#\">\n                    Privacy Policy\n                </a>\n                <a class=\"hover:opacity-100 transition-opacity\" data-kid=\"4-7-2-2-2\" data-name=\"terms of craft link\" href=\"#\">\n                    Terms of Craft\n                </a>\n                <a class=\"hover:opacity-100 transition-opacity\" data-kid=\"4-7-2-2-3\" data-name=\"archive link\" href=\"#\">\n                    Archive\n                </a>\n            </div>\n        </div>\n    </footer>\n</main>\n<!-- Scripts -->\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script type=\"module\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n  \n  // Register GSAP Plugins\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Initialize Lenis\n  const lenis = new Lenis({\n    duration: 1.2,\n    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),\n    smoothWheel: true,\n  });\n\n  // Sync ScrollTrigger with Lenis\n  lenis.on('scroll', ScrollTrigger.update);\n  gsap.ticker.add((time) => {\n    lenis.raf(time * 1000);\n  });\n  gsap.ticker.lagSmoothing(0);\n\n  // Scroll Progress Bar\n  lenis.on('scroll', ({ progress }) => {\n    document.getElementById('progress-bar').style.transform = `scaleX(${progress})`;\n  });\n\n  // Hero Scale-on-Scroll\n  gsap.to('.hero-image', {\n    scale: 1.15,\n    ease: \"none\",\n    scrollTrigger: {\n      trigger: '.hero-img-container',\n      start: \"top top\",\n      end: \"bottom top\",\n      scrub: true\n    }\n  });\n\n  // Reveal Animations\n  const reveals = document.querySelectorAll('.js-reveal');\n  reveals.forEach((el) => {\n    gsap.to(el, {\n      opacity: 1,\n      y: 0,\n      duration: 1.5,\n      ease: \"power2.out\",\n      scrollTrigger: {\n        trigger: el,\n        start: \"top 85%\",\n        once: true\n      }\n    });\n    // Set initial state\n    gsap.set(el, { y: 50 });\n  });\n\n  // Velocity Skew on Profile Image\n  lenis.on('scroll', ({ velocity }) => {\n    const skew = velocity * 0.05;\n    gsap.to('.profile-img', {\n      skewX: skew,\n      duration: 0.5,\n      ease: \"power2.out\",\n      overwrite: true\n    });\n  });\n\n  // Horizontal Scroll Setup (using native for better mobile, but let's add wheel drive for desktop)\n  const horizontalScroll = document.getElementById('horizontal-scroll');\n  horizontalScroll.addEventListener('wheel', (e) => {\n    if (e.deltaY !== 0) {\n      e.preventDefault();\n      horizontalScroll.scrollLeft += e.deltaY;\n    }\n  });\n</script>\n",
      "comments": [],
      "created": "2026-08-07T06:04:28.917863+00:00",
      "modified": "2026-08-07T06:04:28.917863+00:00",
