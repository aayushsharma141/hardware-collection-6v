  </h2>\n            </div>\n            <div class=\"grid grid-cols-12 gap-4 auto-rows-[320px]\" data-kid=\"2-3-1-2\" data-name=\"bento grid layout\">\n                <!-- Large Image Card -->\n                <div class=\"col-span-12 md:col-span-8 row-span-2 border border-[#343434] relative group overflow-hidden\" data-kid=\"2-3-1-2-1\" data-name=\"large image card\">\n                    <img alt=\"Industrial Metalwork\" class=\"mask-wipe-target w-full h-full object-cover filter grayscale brightness-75 contrast-125\" data-kid=\"2-3-1-2-1-1\" data-name=\"large image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/5845903/pexels-photo-5845903.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\"/>\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex flex-col justify-end p-10\" data-kid=\"2-3-1-2-1-2\" data-name=\"image card text overlay\">\n                        <span class=\"text-[10px] font-mono text-[var(--color-gold)] uppercase tracking-widest mb-2\" data-kid=\"2-3-1-2-1-2-1\" data-name=\"image card category text\">\n                            Category A\n                        </span>\n                        <h3 class=\"font-archivo text-4xl font-bold uppercase\" data-kid=\"2-3-1-2-1-2-2\" data-name=\"image card title\">\n                            Structural Latches\n                        </h3>\n                    </div>\n                </div>\n                <!-- Schematic / Info Card -->\n                <div class=\"col-span-12 md:col-span-4 row-span-1 border border-[#343434] bg-[#111111] p-8 flex flex-col justify-between\" data-kid=\"2-3-1-2-2\" data-name=\"schematic info card\">\n                    <div data-kid=\"2-3-1-2-2-1\" data-name=\"info card body\">\n                        <div class=\"flex items-center gap-2 mb-4\" data-kid=\"2-3-1-2-2-1-1\" data-name=\"info card status indicator\">\n                            <div class=\"w-2 h-2 rounded-full bg-[var(--color-gold)]\" data-kid=\"2-3-1-2-2-1-1-1\" data-name=\"dot indicator\">\n                            </div>\n                            <span class=\"text-[10px] font-mono uppercase tracking-widest text-gray-500\" data-kid=\"2-3-1-2-2-1-1-2\" data-name=\"info label text\">\n                                Spec Cell 01\n                            </span>\n                        </div>\n                        <h4 class=\"font-archivo text-xl font-bold uppercase mb-2\" data-kid=\"2-3-1-2-2-1-2\" data-name=\"info title text\">\n                            316L Stainless\n                        </h4>\n                        <p class=\"text-sm text-gray-400 font-forum leading-relaxed\" data-kid=\"2-3-1-2-2-1-3\" data-name=\"info description text\">\n                            High-corrosion resistance marine-grade alloy for exterior architectural use.\n                        </p>\n                    </div>\n                    <div class=\"border-t border-[#343434] pt-4 mt-4\" data-kid=\"2-3-1-2-2-2\" data-name=\"info card footer\">\n                        <div class=\"flex justify-between items-center text-[10px] font-mono text-gray-600 uppercase\" data-kid=\"2-3-1-2-2-2-1\" data-name=\"info footer row\">\n                            <span data-kid=\"2-3-1-2-2-2-1-1\" data-name=\"footer left label\">\n                                Hardness\n                            </span>\n                            <span class=\"text-white\" data-kid=\"2-3-1-2-2-2-1-2\" data-name=\"footer right value\">\n                                85 HRB\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <!-- Gold Callout Card -->\n                <div class=\"col-span-12 md:col-span-4 row-span-1 border border-[var(--color-gold)] p-8 flex flex-col items-center justify-center text-center relative overflow-hidden\" data-kid=\"2-3-1-2-3\" data-name=\"gold callout card\">\n                    <div class=\"absolute inset-0 flex items-center justify-center opacity-10 pointer-events-none\" data-kid=\"2-3-1-2-3-1\" data-name=\"decorative cross container\">\n                        <div class=\"w-full h-[1px] bg-[var(--color-gold)] rotate-45\" data-kid=\"2-3-1-2-3-1-1\" data-name=\"decorative line\">\n                        </div>\n                        <div class=\"w-full h-[1px] bg-[var(--color-gold)] -rotate-45\" data-kid=\"2-3-1-2-3-1-2\" data-name=\"decorative line\">\n                        </div>\n                    </div>\n                    <div class=\"text-6xl font-black text-[var(--color-gold)] mb-2 font-archivo tracking-tighter relative\" data-kid=\"2-3-1-2-3-2\" data-name=\"callout main text\">\n                        MAX\n                    </div>\n                    <div class=\"text-[10px] uppercase tracking-[0.3em] font-bold text-[var(--color-gold)] relative\" data-kid=\"2-3-1-2-3-3\" data-name=\"callout label text\">\n                        Tensile Strength Limit\n                    </div>\n                    <div class=\"mt-4 text-[9px] font-mono text-[var(--color-gold)]/70 relative bg-[var(--color-onyx)] px-2\" data-kid=\"2-3-1-2-3-4\" data-name=\"callout reference text\">\n                        REF: ISO-6892-1 // 12.8kN\n                    </div>\n                </div>\n                <!-- Image Card 2 -->\n                <div class=\"col-span-12 md:col-span-4 row-span-2 border border-[#343434] relative overflow-hidden\" data-kid=\"2-3-1-2-4\" data-name=\"image card\">\n                    <img alt=\"Hardware Fasteners\" class=\"mask-wipe-target w-full h-full object-cover filter grayscale contrast-125\" data-kid=\"2-3-1-2-4-1\" data-name=\"image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/257759/pexels-photo-257759.jpeg?auto=compress&cs=tinysrgb&w=800&q=80\"/>\n                    <div class=\"absolute top-6 right-6\" data-kid=\"2-3-1-2-4-2\" data-name=\"image label container\">\n                        <div class=\"bg-black/80 border border-[#343434] px-3 py-1 text-[9px] font-mono uppercase tracking-widest\" data-kid=\"2-3-1-2-4-2-1\" data-name=\"image reference text\">\n                            Ref: SC-029\n                        </div>\n                    </div>\n                </div>\n                <!-- Product Description Card -->\n                <div class=\"col-span-12 md:col-span-8 row-span-1 border border-[#343434] bg-[#111111] p-10 flex flex-col justify-center\" data-kid=\"2-3-1-2-5\" data-name=\"description card\">\n                    <h3 class=\"font-archivo text-2xl font-bold uppercase mb-4 tracking-tight\" data-kid=\"2-3-1-2-5-1\" data-name=\"card title text\">\n                        Internal Compression Systems\n                    </h3>\n                    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\" data-kid=\"2-3-1-2-5-2\" data-name=\"card text grid\">\n                        <p class=\"text-gray-400 font-forum text-lg leading-relaxed\" data-kid=\"2-3-1-2-5-2-1\" data-name=\"card description paragraph\">\n                            Our internal mechanisms utilize proprietary spring alloys that maintain consistent tension over decades of continuous operation.\n                        </p>\n                        <p class=\"text-gray-400 font-forum text-lg leading-relaxed border-l border-[#343434] pl-6\" data-kid=\"2-3-1-2-5-2-2\" data-name=\"card description paragraph\">\n                            Each component is individually stress-tested to 125% of its rated capacity before final assembly and cataloging.\n                        </p>\n                    </div>\n                </div>\n                <!-- Small Image Card -->\n                <div class=\"col-span-12 md:col-span-4 row-span-1 border border-[#343434] relative overflow-hidden\" data-kid=\"2-3-1-2-6\" data-name=\"small image card\">\n                    <img alt=\"Detail Macro\" class=\"mask-wipe-target w-full h-full object-cover filter grayscale brightness-90 contrast-125\" data-kid=\"2-3-1-2-6-1\" data-name=\"image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/37662324/pexels-photo-37662324.jpeg?auto=compress&cs=tinysrgb&w=800&q=80\"/>\n                    <div class=\"absolute inset-0 flex items-center justify-center\" data-kid=\"2-3-1-2-6-2\" data-name=\"small card overlay container\">\n                        <span class=\"text-[10px] font-mono uppercase tracking-[0.5em] border border-white/40 px-4 py-2 bg-black/40 backdrop-blur-xs\" data-kid=\"2-3-1-2-6-2-1\" data-name=\"overlay label text\">\n                            Macro Analysis\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Context / Full Bleed Section -->\n    <section class=\"bg-[#111111]\" data-kid=\"2-4\" data-name=\"context section\" id=\"about\">\n        <div class=\"container mx-auto px-10 py-32 flex flex-col items-start text-left\" data-kid=\"2-4-1\" data-name=\"context content wrapper\">\n            <div class=\"max-w-3xl mb-24 border-l border-[#343434] pl-16 relative\" data-kid=\"2-4-1-1\" data-name=\"context text block\">\n                <div class=\"absolute -left-[1px] top-0 w-[2px] h-16 bg-[var(--color-gold)]\" data-kid=\"2-4-1-1-1\" data-name=\"decorative vertical line\">\n                </div>\n                <span class=\"text-[var(--color-gold)] text-xs font-mono uppercase tracking-[0.6em] block mb-6\" data-kid=\"2-4-1-1-2\" data-name=\"context overline text\">\n                    Environment // Study 04\n                </span>\n                <h2 class=\"font-archivo text-8xl font-black uppercase tracking-tighter mb-10 leading-[0.9]\" data-kid=\"2-4-1-1-3\" data-name=\"context title text\">\n                    Architectural\n                    <br data-kid=\"2-4-1-1-3-1\" data-name=\"line break\"/>\n                    Context\n                </h2>\n                <p class=\"text-gray-300 font-forum text-3xl leading-snug max-w-2xl mb-8\" data-kid=\"2-4-1-1-4\" data-name=\"context quote text\">\n                    Hardware is not an accessory; it is the tactile interface of architecture.\n                </p>\n                <p class=\"text-gray-500 font-forum text-lg leading-relaxed max-w-xl\" data-kid=\"2-4-1-1-5\" data-name=\"context description text\">\n                    Our collection is designed to integrate seamlessly with raw materials—exposed concrete, reclaimed timber, and structural glass, providing a weight and precision that defines the modern entrance.\n                </p>\n            </div>\n        </div>\n        <div class=\"w-full h-screen relative overflow-hidden flex items-center justify-center\" data-kid=\"2-4-2\" data-name=\"full bleed image section\">\n            <!-- Full Bleed Image with Pin effect simulated via ScrollTrigger -->\n            <img alt=\"Modernist Concrete Interior with Hardware\" class=\"w-full h-full object-cover filter grayscale brightness-75 contrast-110\" data-kid=\"2-4-2-1\" data-name=\"full bleed image\" decoding=\"async\" id=\"full-bleed-img\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1583650363093-50e6c4535898?auto=format&w=2000&q=80&fit=crop\"/>\n            <div class=\"absolute inset-0 bg-black/10\" data-kid=\"2-4-2-2\" data-name=\"full bleed image overlay\">\n            </div>\n            <!-- Editorial text overlay -->\n            <div class=\"absolute bottom-20 left-20 border-l border-[var(--color-gold)] pl-8 py-4 bg-black/20 backdrop-blur-sm max-w-sm\" data-kid=\"2-4-2-3\" data-name=\"editorial text overlay\">\n                <h4 class=\"font-archivo text-white text-xl font-bold uppercase tracking-widest mb-2\" data-kid=\"2-4-2-3-1\" data-name=\"editorial title text\">\n                    Massive Entry System\n                </h4>\n                <p class=\"text-xs text-gray-300 font-forum uppercase tracking-widest\" data-kid=\"2-4-2-3-2\" data-name=\"editorial description text\">\n                    Cast Concrete / Oak / Raw Steel\n                </p>\n            </div>\n        </div>\n    </section>\n</main>\n<!-- Footer -->\n<footer class=\"bg-[#111111] border-t border-[#343434] py-24 px-10\" data-kid=\"3\" data-name=\"footer section\">\n    <div class=\"container mx-auto flex flex-col items-center text-center\" data-kid=\"3-1\" data-name=\"footer container\">\n        <h2 class=\"font-archivo text-5xl font-black tracking-tighter uppercase mb-12\" data-kid=\"3-1-1\" data-name=\"footer heading\">\n            Hardware / Collection\n        </h2>\n        <nav class=\"flex flex-wrap justify-center gap-6 text-[10px] uppercase tracking-[0.3em] font-archivo text-gray-400 mb-12\" data-kid=\"3-1-2\" data-name=\"footer links menu\">\n            <a class=\"hover:text-white transition-colors\" data-kid=\"3-1-2-1\" data-name=\"footer link\" href=\"#\">\n                Catalog\n            </a>\n            <span class=\"text-[#343434]\" data-kid=\"3-1-2-2\" data-name=\"separator\">\n                |\n            </span>\n            <a class=\"hover:text-white transition-colors\" data-kid=\"3-1-2-3\" data-name=\"footer link\" href=\"#\">\n                Engineering\n            </a>\n            <span class=\"text-[#343434]\" data-kid=\"3-1-2-4\" data-name=\"separator\">\n                |\n            </span>\n            <a class=\"hover:text-white transition-colors\" data-kid=\"3-1-2-5\" data-name=\"footer link\" href=\"#\">\n                Materials\n            </a>\n            <span class=\"text-[#343434]\" data-kid=\"3-1-2-6\" data-name=\"separator\">\n                |\n            </span>\n            <a class=\"hover:text-white transition-colors\" data-kid=\"3-1-2-7\" data-name=\"footer link\" href=\"#\">\n                Safety\n            </a>\n            <span class=\"text-[#343434]\" data-kid=\"3-1-2-8\" data-name=\"separator\">\n                |\n            </span>\n            <a class=\"hover:text-white transition-colors\" data-kid=\"3-1-2-9\" data-name=\"footer link\" href=\"#\">\n                Privacy Policy\n            </a>\n        </nav>\n        <div class=\"flex gap-8 mb-16\" data-kid=\"3-1-3\" data-name=\"social media links container\">\n            <a class=\"text-gray-500 hover:text-[var(--color-gold)] transition-colors\" data-kid=\"3-1-3-1\" data-name=\"social media link\" href=\"#\">\n                <i class=\"ti ti-brand-instagram text-2xl\" data-kid=\"3-1-3-1-1\" data-name=\"instagram icon\">\n                </i>\n            </a>\n            <a class=\"text-gray-500 hover:text-[var(--color-gold)] transition-colors\" data-kid=\"3-1-3-2\" data-name=\"social media link\" href=\"#\">\n                <i class=\"ti ti-brand-x text-2xl\" data-kid=\"3-1-3-2-1\" data-name=\"x icon\">\n                </i>\n            </a>\n            <a class=\"text-gray-500 hover:text-[var(--color-gold)] transition-colors\" data-kid=\"3-1-3-3\" data-name=\"social media link\" href=\"#\">\n                <i class=\"ti ti-brand-linkedin text-2xl\" data-kid=\"3-1-3-3-1\" data-name=\"linkedin icon\">\n                </i>\n            </a>\n        </div>\n        <div class=\"pt-8 border-t border-[#343434] w-full max-w-4xl\" data-kid=\"3-1-4\" data-name=\"footer copyright container\">\n            <p class=\"text-[10px] font-mono text-gray-600 uppercase tracking-[0.4em]\" data-kid=\"3-1-4-1\" data-name=\"copyright notice text\">\n                © 2026 Industrial Forge Systems. All rights reserved. Registered Trademark.\n            </p>\n        </div>\n    </div>\n</footer>\n<!-- External Libraries -->\n<link data-kid=\"4\" data-name=\"external icon font link\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script type=\"module\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    \n    const lenis = new Lenis();\n    lenis.on('scroll', ScrollTrigger.update);\n    gsap.ticker.add((time) => {\n        lenis.raf(time * 1000);\n    });\n    gsap.ticker.lagSmoothing(0);\n</script>\n<link data-kid=\"5\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" rel=\"stylesheet\"/>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n\n    // Hero Entrance\n    const heroTl = gsap.timeline();\n    heroTl.from(\".hero-reveal\", {\n        y: 60,\n        autoAlpha: 0,\n        duration: 1.2,\n        ease: \"power4.out\",\n        stagger: 0.1\n    });\n    heroTl.from(\".hero-image-container\", {\n        scale: 0.95,\n        autoAlpha: 0,\n        duration: 1.5,\n        ease: \"power4.out\"\n    }, \"-=1\");\n\n    // Pinned Hero Scene\n    gsap.to(\"#hero-hinge-img\", {\n        scale: 1.15,\n        ease: \"none\",\n        scrollTrigger: {\n            trigger: \"#hero-section\",\n            start: \"top top\",\n            end: \"bottom top\",\n            scrub: true\n        }\n    });\n\n    // Capability Ledger Batch Reveal\n    ScrollTrigger.batch(\".ledger-row\", {\n        start: \"top 85%\",\n        onEnter: (batch) => gsap.from(batch, {\n            autoAlpha: 0,\n            y: 40,\n            stagger: 0.15,\n            duration: 0.8,\n            ease: \"power3.out\",\n            overwrite: true\n        })\n    });\n\n    // Catalog Mask Wipe\n    document.querySelectorAll(\".mask-wipe-target\").forEach(target => {\n        gsap.to(target, {\n            clipPath: \"inset(0 0% 0 0)\",\n            duration: 1.2,\n            ease: \"power2.inOut\",\n            scrollTrigger: {\n                trigger: target,\n                start: \"top 90%\",\n                toggleActions: \"play none none none\"\n            }\n        });\n    });\n\n    // Full Bleed Image Zoom\n    gsap.to(\"#full-bleed-img\", {\n        scale: 1.1,\n        ease: \"none\",\n        scrollTrigger: {\n            trigger: \"#about\",\n            start: \"top bottom\",\n            end: \"bottom top\",\n            scrub: true\n        }\n    });\n</script>\n",
