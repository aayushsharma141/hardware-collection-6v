    "var_b35c780600f5": {
      "type": "variant",
      "label": "Industrial Forge — Hardware Collection",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@400;700;900&family=Forum&display=swap');\n\n    :root {\n        --color-onyx: #111111;\n        --color-graphite: #343434;\n        --color-gold: #D4AF37;\n    }\n\n    body {\n        background-color: var(--color-onyx);\n        color: white;\n        margin: 0;\n        font-family: 'Forum', serif;\n        overflow-x: clip;\n    }\n\n    .font-archivo { font-family: 'Archivo', sans-serif; }\n    .font-forum { font-family: 'Forum', serif; }\n\n    .outline-text {\n        -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.6);\n        color: transparent;\n    }\n\n    .spotlight-bg {\n        background: radial-gradient(circle at 60% 40%, rgba(212, 175, 55, 0.08) 0%, transparent 60%);\n    }\n\n    /* Custom scrollbar for a clean look */\n    ::-webkit-scrollbar {\n        width: 4px;\n    }\n    ::-webkit-scrollbar-track {\n        background: var(--color-onyx);\n    }\n    ::-webkit-scrollbar-thumb {\n        background: var(--color-graphite);\n    }\n\n    .mask-wipe-target {\n        clip-path: inset(0 100% 0 0);\n    }\n\n    .ledger-row {\n        will-change: transform, opacity;\n    }\n</style>\n<!-- Header -->\n<header class=\"fixed top-0 left-0 w-full z-[100] bg-[#111111]/90 backdrop-blur-md border-b border-[#343434] px-10 py-4 flex items-center justify-between font-archivo\" data-kid=\"1\" data-name=\"main navigation header\">\n    <div class=\"flex items-center gap-6\" data-kid=\"1-1\" data-name=\"header logo and meta container\">\n        <span class=\"text-[9px] tracking-[0.5em] text-gray-500 uppercase font-mono\" data-kid=\"1-1-1\" data-name=\"issue date text\">\n            ISSUE // 2026.08.07\n        </span>\n        <div class=\"h-4 w-px bg-[#343434]\" data-kid=\"1-1-2\" data-name=\"vertical separator line\">\n        </div>\n        <div class=\"text-xl font-black tracking-tighter uppercase font-archivo\" data-kid=\"1-1-3\" data-name=\"brand name text\">\n            Industrial Forge\n        </div>\n    </div>\n    <nav class=\"flex gap-10 text-[10px] uppercase tracking-[0.2em]\" data-kid=\"1-2\" data-name=\"primary navigation menu\">\n        <a class=\"hover:text-[var(--color-gold)] transition-colors\" data-kid=\"1-2-1\" data-name=\"navigation link\" href=\"#catalog\">\n            Catalog\n        </a>\n        <a class=\"hover:text-[var(--color-gold)] transition-colors\" data-kid=\"1-2-2\" data-name=\"navigation link\" href=\"#specs\">\n            Specs\n        </a>\n        <a class=\"hover:text-[var(--color-gold)] transition-colors\" data-kid=\"1-2-3\" data-name=\"navigation link\" href=\"#about\">\n            Context\n        </a>\n        <a class=\"hover:text-[var(--color-gold)] transition-colors\" data-kid=\"1-2-4\" data-name=\"navigation link\" href=\"#contact\">\n            Contact\n        </a>\n    </nav>\n</header>\n<main data-kid=\"2\" data-name=\"main content container\">\n    <!-- Hero Section -->\n    <section class=\"relative min-h-[200vh] spotlight-bg\" data-kid=\"2-1\" data-name=\"hero section\" id=\"hero-section\">\n        <!-- Pinned Wrapper -->\n        <div class=\"sticky top-0 h-screen w-full flex items-center overflow-x-clip\" data-kid=\"2-1-1\" data-name=\"hero pinned container\">\n            <!-- Hero Content -->\n            <div class=\"container mx-auto px-10 z-20 grid grid-cols-12 gap-8 items-center h-full\" data-kid=\"2-1-1-1\" data-name=\"hero layout grid\">\n                <div class=\"col-span-12 lg:col-span-8 pt-20 relative\" data-kid=\"2-1-1-1-1\" data-name=\"hero text area\">\n                    <div class=\"flex items-center gap-4 mb-8 hero-reveal\" data-kid=\"2-1-1-1-1-1\" data-name=\"hero subheader container\">\n                        <div class=\"relative w-8 h-8 flex items-center justify-center\" data-kid=\"2-1-1-1-1-1-1\" data-name=\"crosshair icon container\">\n                            <div class=\"absolute inset-0 border border-[var(--color-gold)] opacity-20\" data-kid=\"2-1-1-1-1-1-1-1\" data-name=\"crosshair border decorative\">\n                            </div>\n                            <img alt=\"Crosshair icon\" class=\"w-4 h-4\" data-kid=\"2-1-1-1-1-1-1-2\" data-name=\"crosshair icon\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/crosshair.svg\" style=\"filter: invert(72%) sepia(50%) saturate(545%) hue-rotate(9deg) brightness(92%) contrast(88%);\"/>\n                        </div>\n                        <div class=\"flex flex-col\" data-kid=\"2-1-1-1-1-1-2\" data-name=\"hero identifier container\">\n                            <span class=\"text-[var(--color-gold)] text-[11px] font-mono tracking-[0.2em] uppercase leading-none\" data-kid=\"2-1-1-1-1-1-2-1\" data-name=\"catalog ID text\">\n                                Catalog ID: IF-2026-SC\n                            </span>\n                            <span class=\"text-gray-500 text-[9px] font-mono uppercase tracking-widest mt-1\" data-kid=\"2-1-1-1-1-1-2-2\" data-name=\"batch release text\">\n                                Batch Release 01 // Structural Persistence\n                            </span>\n                        </div>\n                    </div>\n                    <h1 class=\"font-archivo text-[13vw] leading-[0.82] font-black uppercase tracking-tighter outline-text mb-8 hero-reveal relative\" data-kid=\"2-1-1-1-1-2\" data-name=\"main hero headline text\">\n                        BUILT\n                        <br data-kid=\"2-1-1-1-1-2-1\" data-name=\"line break\"/>\n                        TO HOLD\n                        <!-- Accent Gold Line -->\n                        <div class=\"absolute -left-10 top-1/2 w-8 h-[2px] bg-[var(--color-gold)]\" data-kid=\"2-1-1-1-1-2-2\" data-name=\"accent gold line\">\n                        </div>\n                    </h1>\n                    <div class=\"max-w-md hero-reveal\" data-kid=\"2-1-1-1-1-3\" data-name=\"hero description container\">\n                        <p class=\"text-xl text-gray-300 font-forum leading-relaxed border-l border-[#343434] pl-6\" data-kid=\"2-1-1-1-1-3-1\" data-name=\"hero description text\">\n                            Industrial grade hardware systems designed for structural permanence. Engineered with zero-tolerance precision for architectural applications.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <!-- Hero Image (Pinned & Scaled) -->\n            <div class=\"absolute right-[5%] top-1/2 -translate-y-1/2 w-[45%] aspect-[4/5] border border-[#343434] bg-[#181818] p-6 hero-image-container z-10\" data-kid=\"2-1-1-2\" data-name=\"hero image wrapper\">\n                <div class=\"relative w-full h-full overflow-hidden\" data-kid=\"2-1-1-2-1\" data-name=\"image container\">\n                    <img alt=\"Steel Hinge Detailed View\" class=\"w-full h-full object-cover filter grayscale contrast-125 brightness-90\" data-kid=\"2-1-1-2-1-1\" data-name=\"hero image\" decoding=\"async\" id=\"hero-hinge-img\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7985760/pexels-photo-7985760.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\"/>\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-[#111111]/50 to-transparent\" data-kid=\"2-1-1-2-1-2\" data-name=\"image gradient overlay\">\n                    </div>\n                </div>\n                <!-- Technical Overlay -->\n                <div class=\"absolute -bottom-4 -left-4 bg-[var(--color-gold)] text-[#111111] font-archivo text-[9px] font-black px-3 py-1.5 uppercase tracking-widest z-20\" data-kid=\"2-1-1-2-2\" data-name=\"component identifier tag\">\n                    Component: Pivot Hinge 90-A\n                </div>\n                <div class=\"absolute top-8 right-8 flex flex-col items-end\" data-kid=\"2-1-1-2-3\" data-name=\"coordinate marker container\">\n                    <div class=\"w-12 h-px bg-white/30 mb-2\" data-kid=\"2-1-1-2-3-1\" data-name=\"coordinate marker line\">\n                    </div>\n                    <div class=\"text-[9px] font-mono text-white/50 uppercase tracking-tighter\" data-kid=\"2-1-1-2-3-2\" data-name=\"coordinate text\">\n                        Coord: 52.37 // 4.89\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Capability Ledger -->\n    <section class=\"py-32 px-10 border-t border-[#343434]\" data-kid=\"2-2\" data-name=\"capability ledger section\" id=\"specs\">\n        <div class=\"container mx-auto max-w-5xl\" data-kid=\"2-2-1\" data-name=\"ledger container\">\n            <div class=\"flex justify-between items-end mb-20\" data-kid=\"2-2-1-1\" data-name=\"ledger header\">\n                <div class=\"flex items-center gap-4\" data-kid=\"2-2-1-1-1\" data-name=\"ledger title container\">\n                    <img class=\"w-8 h-8\" data-kid=\"2-2-1-1-1-1\" data-name=\"ledger title icon\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/crosshair.svg\" style=\"filter: invert(72%) sepia(50%) saturate(545%) hue-rotate(9deg) brightness(92%) contrast(88%);\"/>\n                    <h2 class=\"font-archivo text-5xl font-black uppercase tracking-tight\" data-kid=\"2-2-1-1-1-2\" data-name=\"ledger title text\">\n                        Technical Ledger\n                    </h2>\n                </div>\n                <div class=\"text-right text-[10px] font-mono text-gray-500 uppercase tracking-widest\" data-kid=\"2-2-1-1-2\" data-name=\"ledger standard info text\">\n                    Verification Standard\n                    <br data-kid=\"2-2-1-1-2-1\" data-name=\"line break\"/>\n                    ASTM // ISO // DIN\n                </div>\n            </div>\n            <div class=\"border-t border-[#343434]\" data-kid=\"2-2-1-2\" data-name=\"specs list container\">\n                <!-- Specs Rows -->\n                <div class=\"ledger-row flex 