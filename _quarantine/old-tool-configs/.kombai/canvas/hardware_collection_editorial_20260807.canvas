      "viewportScrollY": 6531
    },
    "var_19389a63a8f3": {
      "type": "variant",
      "label": "Architect's Canvas — Hardware Collection",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Literata:ital,opsz,wght@0,7..72,200..900;1,7..72,200..900&display=swap');\n\n    :root {\n        --parchment: #F4F0EC;\n        --jet: #2A3439;\n        --copper: #B56917;\n    }\n\n    body {\n        background-color: var(--parchment);\n        color: var(--jet);\n        font-family: 'Literata', serif;\n        margin: 0;\n        overflow-x: clip;\n    }\n\n    .font-serif-heading { font-family: 'Playfair Display', serif; }\n    .font-serif-body { font-family: 'Literata', serif; }\n\n    /* Locomotive Reveal Styles */\n    [data-scroll] {\n        opacity: 0;\n        transform: translateY(30px);\n        transition: opacity 1s cubic-bezier(0.215, 0.61, 0.355, 1), transform 1s cubic-bezier(0.215, 0.61, 0.355, 1);\n    }\n\n    [data-scroll].is-inview {\n        opacity: 1;\n        transform: translateY(0);\n    }\n\n    /* Custom Hairline Dividers */\n    .hairline-v { width: 1px; background-color: rgba(42, 52, 57, 0.1); }\n    .hairline-h { height: 1px; background-color: rgba(42, 52, 57, 0.1); }\n\n    .issue-marker {\n        writing-mode: vertical-rl;\n        text-orientation: mixed;\n    }\n\n    /* Hide scrollbar for cleaner look while keeping functionality */\n    ::-webkit-scrollbar { width: 0; display: none; }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler Icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<link data-kid=\"2\" data-name=\"Locomotive Scroll stylesheet\" href=\"https://cdn.jsdelivr.net/npm/locomotive-scroll@5/bundled/locomotive-scroll.css\" rel=\"stylesheet\"/>\n<main data-kid=\"3\" data-name=\"main page container\" data-scroll-container=\"\">\n    <!-- Navigation -->\n    <nav class=\"fixed top-0 left-0 w-full z-50 flex justify-between items-center px-10 py-8 text-[var(--jet)]\" data-kid=\"3-1\" data-name=\"main navigation bar\">\n        <div class=\"flex items-center gap-16\" data-kid=\"3-1-1\" data-name=\"navigation branding and menu links container\">\n            <a class=\"text-sm uppercase tracking-[0.4em] font-black border-b-2 border-[var(--jet)]\" data-kid=\"3-1-1-1\" data-name=\"brand logo link\" href=\"#\">\n                SYNTAX\n            </a>\n            <div class=\"hidden lg:flex gap-10 text-[11px] uppercase tracking-[0.25em] font-bold\" data-kid=\"3-1-1-2\" data-name=\"primary navigation links container\">\n                <a class=\"hover:text-[var(--copper)] transition-colors\" data-kid=\"3-1-1-2-1\" data-name=\"collection index navigation link\" href=\"#\">\n                    Collection Index\n                </a>\n                <a class=\"hover:text-[var(--copper)] transition-colors\" data-kid=\"3-1-1-2-2\" data-name=\"foundry navigation link\" href=\"#\">\n                    The Foundry\n                </a>\n                <a class=\"hover:text-[var(--copper)] transition-colors\" data-kid=\"3-1-1-2-3\" data-name=\"editorial navigation link\" href=\"#\">\n                    Editorial\n                </a>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-8\" data-kid=\"3-1-2\" data-name=\"navigation right side tools container\">\n            <div class=\"hidden sm:flex flex-col items-end\" data-kid=\"3-1-2-1\" data-name=\"issue information text container\">\n                <span class=\"text-[9px] uppercase tracking-widest opacity-50\" data-kid=\"3-1-2-1-1\" data-name=\"issue number label\">\n                    Issue No. 04\n                </span>\n                <span class=\"text-[10px] uppercase tracking-widest font-bold\" data-kid=\"3-1-2-1-2\" data-name=\"issue date label\">\n                    August 2026\n                </span>\n            </div>\n            <button class=\"ti ti-menu-2 text-2xl hover:text-[var(--copper)] transition-colors\" data-kid=\"3-1-2-2\" data-name=\"menu hamburger button\">\n            </button>\n        </div>\n    </nav>\n    <!-- Hero Section -->\n    <section class=\"h-svh w-full flex border-b border-[var(--jet)]/10 overflow-hidden\" data-kid=\"3-2\" data-name=\"hero section\">\n        <!-- Vertical Column 1: Image -->\n        <div class=\"w-1/3 h-full relative border-r border-[var(--jet)]/10 group overflow-hidden\" data-kid=\"3-2-1\" data-name=\"hero image column container\">\n            <img alt=\"Close up of a knurled brass door handle on dark oak by Matt Clark\" class=\"w-full h-full object-cover\" data-kid=\"3-2-1-1\" data-name=\"hero entry image\" data-scroll=\"\" data-scroll-speed=\"-0.15\" src=\"https://images.unsplash.com/photo-1689622952038-a60188122034?auto=format&w=1200&q=80&fit=crop\"/>\n            <div class=\"absolute inset-0 bg-black/10 group-hover:bg-black/0 transition-colors duration-700\" data-kid=\"3-2-1-2\" data-name=\"image overlay shade\">\n            </div>\n            <div class=\"absolute bottom-10 left-10 text-[10px] uppercase tracking-[0.4em] text-white/80 font-bold z-10 flex items-center gap-4\" data-kid=\"3-2-1-3\" data-name=\"image caption container\">\n                <span class=\"w-8 h-px bg-white/40\" data-kid=\"3-2-1-3-1\" data-name=\"decorative horizontal rule\">\n                </span>\n                Entry / Plate 01\n            </div>\n        </div>\n        <!-- Vertical Column 2: Core Text -->\n        <div class=\"w-1/3 h-full flex flex-col justify-center items-center px-12 text-center bg-[var(--parchment)] relative overflow-hidden border-x border-[var(--jet)]/10\" data-kid=\"3-2-2\" data-name=\"hero text column container\">\n            <!-- Decorative Grid Background for center col -->\n            <div class=\"absolute inset-0 opacity-[0.03] pointer-events-none\" data-kid=\"3-2-2-1\" data-name=\"decorative grid background pattern\" style=\"background-image: radial-gradient(var(--jet) 1px, transparent 0); background-size: 32px 32px;\">\n            </div>\n            <div class=\"relative z-10 space-y-16\" data-kid=\"3-2-2-2\" data-name=\"hero content wrapper\" data-scroll=\"\" data-scroll-speed=\"0.05\">\n                <div class=\"space-y-6\" data-kid=\"3-2-2-2-1\" data-name=\"hero section subtitle group\">\n                    <span class=\"text-[10px] uppercase tracking-[0.8em] text-[var(--copper)] font-black flex items-center justify-center gap-4\" data-kid=\"3-2-2-2-1-1\" data-name=\"subtitle text container\">\n                        <span class=\"w-4 h-px bg-[var(--copper)]/30\" data-kid=\"3-2-2-2-1-1-1\" data-name=\"subtitle left decorative line\">\n                        </span>\n                        Architect's Canvas\n                        <span class=\"w-4 h-px bg-[var(--copper)]/30\" data-kid=\"3-2-2-2-1-1-2\" data-name=\"subtitle right decorative line\">\n                        </span>\n                    </span>\n                    <h1 class=\"font-serif-heading text-6xl md:text-[6.8rem] leading-[0.9] uppercase tracking-tighter text-[var(--jet)]\" data-kid=\"3-2-2-2-1-2\" data-name=\"hero main headline\">\n                        Syntax\n                        <br data-kid=\"3-2-2-2-1-2-1\" data-name=\"headline line break\"/>\n                        Of Space\n                    </h1>\n                </div>\n                <p class=\"max-w-xs mx-auto text-[14px] leading-relaxed opacity-80 font-serif-body italic\" data-kid=\"3-2-2-2-2\" data-name=\"hero introductory paragraph text\">\n                    A dialogue between raw materiality and the primordial urge to touch. Curating the silent handshake of a building.\n                </p>\n                <div class=\"pt-8\" data-kid=\"3-2-2-2-3\" data-name=\"call-to-action button container\">\n                    <a class=\"group relative inline-flex items-center gap-6 px-14 py-5 overflow-hidden\" data-kid=\"3-2-2-2-3-1\" data-name=\"discover series call-to-action button\" href=\"#\">\n                        <span class=\"relative z-10 text-[11px] uppercase tracking-[0.4em] font-black text-[var(--jet)] group-hover:text-[var(--parchment)] transition-colors duration-500\" data-kid=\"3-2-2-2-3-1-1\" data-name=\"call-to-action button label\">\n                            Discover 2026 Series\n                        </span>\n                        <div class=\"absolute inset-0 border border-[var(--jet)]\" data-kid=\"3-2-2-2-3-1-2\" data-name=\"button border\">\n                        </div>\n                        <div class=\"absolute inset-0 bg-[var(--jet)] translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-out\" data-kid=\"3-2-2-2-3-1-3\" data-name=\"button hover background animation\">\n                        </div>\n                    </a>\n                </div>\n            </div>\n            <div class=\"absolute bottom-12 flex flex-col items-center gap-6 opacity-30\" data-kid=\"3-2-2-3\" data-name=\"scroll indicator container\">\n                <span class=\"text-[9px] uppercase tracking-[0.5em] font-bold\" data-kid=\"3-2-2-3-1\" data-name=\"catalog index indicator text\">\n                    Catalog Index 004/A\n                </span>\n                <i class=\"ti ti-arrow-narrow-down text-2xl animate-bounce\" data-kid=\"3-2-2-3-2\" data-name=\"arrow down bounce icon\">\n                </i>\n            </div>\n        </div>\n        <!-- Vertical Column 3: Video -->\n        <div class=\"w-1/3 h-full relative overflow-hidden bg-[var(--jet)] group\" data-kid=\"3-2-3\" data-name=\"hero video column container\">\n            <video autoplay=\"\" class=\"w-full h-full object-cover grayscale group-hover:grayscale-0 brightness-75 group-hover:brightness-100 transition-all duration-1000\" data-kid=\"3-2-3-1\" data-name=\"hero background video\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/5801269/pexels-photo-5801269.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=1200&w=630\" preload=\"metadata\" src=\"https://videos.pexels.com/video-files/5801269/5801269-uhd_1440_2732_25fps.mp4\">\n            </video>\n            <div class=\"absolute bottom-10 right-10 text-[10px] uppercase tracking-[0.4em] text-white/80 font-bold z-10 flex items-center gap-4 text-right\" data-kid=\"3-2-3-2\" data-name=\"video caption container\">\n                Material Study / 26\n                <span class=\"w-8 h-px bg-white/40\" data-kid=\"3-2-3-2-1\" data-name=\"video caption horizontal rule\">\n                </span>\n            </div>\n        </div>\n    </section>\n    <!-- Story Section -->\n    <section class=\"py-48 px-6 relative overflow-hidden border-b border-[var(--jet)]/10\" data-kid=\"3-3\" data-name=\"story section\">\n        <div class=\"max-w-6xl mx-auto\" data-kid=\"3-3-1\" data-name=\"story section content container\">\n            <div class=\"grid grid-cols-1 md:grid-cols-12 gap-16 items-start\" data-kid=\"3-3-1-1\" data-name=\"story layout grid\">\n                <div class=\"md:col-span-4 sticky top-32 space-y-6\" data-kid=\"3-3-1-1-1\" data-name=\"sticky sidebar container\">\n                    <span class=\"text-[10px] uppercase tracking-[0.4em] text-[var(--copper)] font-black\" data-kid=\"3-3-1-1-1-1\" data-name=\"sidebar section label\">\n                        01 / Philosophy\n                    </span>\n                    <h2 class=\"font-serif-heading text-4xl leading-tight\" data-kid=\"3-3-1-1-1-2\" data-name=\"sidebar headline\">\n                        The Primacy of Touch.\n                    </h2>\n                    <div class=\"w-16 h-px bg-[var(--jet)]/20\" data-kid=\"3-3-1-1-1-3\" data-name=\"sidebar decorative line\">\n                    </div>\n                </div>\n                <div class=\"md:col-span-8 relative\" data-kid=\"3-3-1-1-2\" data-name=\"story body column container\">\n                    <span class=\"absolute -top-40 -right-20 text-[40rem] font-serif-heading text-[var(--jet)] opacity-[0.03] select-none pointer-events-none\" data-kid=\"3-3-1-1-2-1\" data-name=\"background decorative letter\">\n                        A\n                    </span>\n                    <div class=\"relative z-10 space-y-12\" data-kid=\"3-3-1-1-2-2\" data-name=\"story content wrapper\">\n                        <p class=\"text-2xl leading-relaxed font-serif-body text-[var(--jet)]/80 italic\" data-kid=\"3-3-1-1-2-2-1\" data-name=\"story lead paragraph\">\n                            Architecture is often celebrated through the lens of sight, but it is truly lived through the sensation of contact.\n                        </p>\n                        <div class=\"grid grid-cols-2 gap-12 pt-8\" data-kid=\"3-3-1-1-2-2-2\" data-name=\"story body paragraph grid\">\n                            <p class=\"text-[13px] leading-[1.8] opacity-60\" data-kid=\"3-3-1-1-2-2-2-1\" data-name=\"story body paragraph one\">\n                                Since the foundry's inception, we have been obsessed with the moment of friction—the split second where hand meets metal. This is the most intimate interaction one can have with a structure. It is functional poetry.\n                            </p>\n                            <p class=\"text-[13px] leading-[1.8] opacity-60\" data-kid=\"3-3-1-1-2-2-2-2\" data-name=\"story body paragraph two\">\n                                Our 2026 editorial collection focuses on the 'Syntax of Space'. We view hardware not as an accessory, but as the punctuation of a room. Without the correct weight and balance, the architectural sentence remains unfinished.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!-- Pull Quote Breakout: Editorial Pattern -->\n            <div class=\"relative -mx-6 md:-mx-24 mt-40 group\" data-kid=\"3-3-1-2\" data-name=\"pull quote breakout section\" data-scroll=\"\" data-scroll-speed=\"0.05\">\n                <div class=\"absolute inset-0 bg-[var(--jet)] skew-y-[-1deg] translate-y-4\" data-kid=\"3-3-1-2-1\" data-name=\"pull quote decorative skew\">\n                </div>\n                <div class=\"relative bg-[var(--jet)] text-[var(--parchment)] py-32 px-12 md:px-32 border-y border-white/5\" data-kid=\"3-3-1-2-2\" data-name=\"pull quote content container\">\n                    <div class=\"max-w-5xl mx-auto text-center space-y-12\" data-kid=\"3-3-1-2-2-1\" data-name=\"pull quote text container\">\n                        <i class=\"ti ti-quote text-7xl text-[var(--copper)] opacity-40\" data-kid=\"3-3-1-2-2-1-1\" data-name=\"quote icon\">\n                        </i>\n                        <h2 class=\"font-serif-heading text-5xl md:text-[5.5rem] leading-[1.1] italic\" data-kid=\"3-3-1-2-2-1-2\" data-name=\"pull quote headline\">\n                            A room is remembered by what the\n                            <span class=\"text-[var(--copper)] underline decoration-1 underline-offset-8\" data-kid=\"3-3-1-2-2-1-2-1\" data-name=\"pull quote highlighted text\">\n                                hand meets first\n                            </span>\n                            .\n                        </h2>\n                        <div class=\"pt-8\" data-kid=\"3-3-1-2-2-1-3\" data-name=\"pull quote attribution container\">\n                            <span class=\"text-[11px] uppercase tracking-[0.6em] font-black text-white/40\" data-kid=\"3-3-1-2-2-1-3-1\" data-name=\"pull quote attribution label\">\n                                — THE FOUNDRY MANIFESTO\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Category Masonry Gallery: Editorial Swiss Pattern -->\n    <section class=\"bg-[var(--parchment)] py-40 border-b border-[var(--jet)]/10 overflow-hidden\" data-kid=\"3-4\" data-name=\"category gallery section\">\n        <div class=\"px-12 mb-24 flex justify-between items-baseline\" data-kid=\"3-4-1\" data-name=\"gallery section header\">\n            <div class=\"space-y-4\" data-kid=\"3-4-1-1\" data-name=\"gallery title container\">\n                <span class=\"text-[11px] uppercase tracking-[0.5em] text-[var(--copper)] font-black\" data-kid=\"3-4-1-1-1\" data-name=\"gallery section label\">\n                    02 / Categories\n                </span>\n                <h2 class=\"font-serif-heading text-6xl uppercase tracking-tighter\" data-kid=\"3-4-1-1-2\" data-name=\"gallery main headline\">\n                    The Collections\n                </h2>\n            </div>\n            <div class=\"flex items-center gap-4 text-[10px] uppercase tracking-widest opacity-40 font-bold\" data-kid=\"3-4-1-2\" data-name=\"gallery info container\">\n                <span class=\"w-12 h-px bg-[var(--jet)]\" data-kid=\"3-4-1-2-1\" data-name=\"gallery info horizontal rule\">\n                </span>\n                Curated Series 2026\n            </div>\n        </div>\n        <div class=\"flex flex-col md:flex-row gap-0 border-y border-[var(--jet)]/10 divide-x divide-[var(--jet)]/10\" data-kid=\"3-4-2\" data-name=\"masonry gallery grid\">\n            <!-- Doors -->\n            <div class=\"group relative flex flex-col h-[700px] md:w-1/4 overflow-hidden\" data-kid=\"3-4-2-1\" data-name=\"doors category card\" data-scroll=\"\">\n                <div class=\"p-12 border-b border-[var(--jet)]/10 bg-[var(--parchment)] z-10\" data-kid=\"3-4-2-1-1\" data-name=\"doors card content container\">\n                    <div class=\"flex justify-between items-center mb-4\" data-kid=\"3-4-2-1-1-1\" data-name=\"doors card top row\">\n                        <span class=\"text-[10px] uppercase tracking-[0.3em] opacity-40\" data-kid=\"3-4-2-1-1-1-1\" data-name=\"doors card number label\">\n                            01\n                        </span>\n                        <i class=\"ti ti-arrow-up-right text-2xl opacity-0 group-hover:opacity-100 group-hover:text-[var(--copper)] transition-all duration-500 -translate-x-4 group-hover:translate-x-0\" data-kid=\"3-4-2-1-1-1-2\" data-name=\"doors card navigation icon\">\n                        </i>\n                    </div>\n                    <h3 class=\"font-serif-heading text-3xl uppercase tracking-widest\" data-kid=\"3-4-2-1-1-2\" data-name=\"doors card headline\">\n                        Doors\n                    </h3>\n                    <p class=\"text-[10px] uppercase tracking-widest mt-4 opacity-50 group-hover:opacity-100 transition-opacity font-serif-body\" data-kid=\"3-4-2-1-1-3\" data-name=\"doors card sub-category description\">\n                        Levers, Pulls & Knobs\n                    </p>\n                </div>\n                <div class=\"flex-grow overflow-hidden relative\" data-kid=\"3-4-2-1-2\" data-name=\"doors card image container\">\n                    <img alt=\"Doors Hardware Collection by Aleksandar Spasojevic\" class=\"w-full h-full object-cover grayscale brightness-90 group-hover:grayscale-0 group-hover:brightness-100 transition-all duration-1000 group-hover:scale-110\" data-kid=\"3-4-2-1-2-1\" data-name=\"doors card image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/18820279/pexels-photo-18820279.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\"/>\n                </div>\n            </div>\n            <!-- Cabinets -->\n            <div class=\"group relative flex flex-col h-[850px] md:w-1/4 overflow-hidden bg-[var(--jet)] text-white shadow-2xl z-20\" data-kid=\"3-4-2-2\" data-name=\"cabinets category card\" data-scroll=\"\" data-scroll-speed=\"0.05\">\n                <div class=\"p-12 border-b border-white/10 z-10\" data-kid=\"3-4-2-2-1\" data-name=\"cabinets card content container\">\n                    <div class=\"flex justify-between items-center mb-4\" data-kid=\"3-4-2-2-1-1\" data-name=\"cabinets card top row\">\n                        <span class=\"text-[10px] uppercase tracking-[0.3em] opacity-40\" data-kid=\"3-4-2-2-1-1-1\" data-name=\"cabinets card number label\">\n                            02\n                        </span>\n                        <i class=\"ti ti-arrow-up-right text-2xl text-[var(--copper)]\" data-kid=\"3-4-2-2-1-1-2\" data-name=\"cabinets card navigation icon\">\n                        </i>\n                    </div>\n                    <h3 class=\"font-serif-heading text-3xl uppercase tracking-widest\" data-kid=\"3-4-2-2-1-2\" data-name=\"cabinets card headline\">\n                        Cabinets\n                    </h3>\n                    <p class=\"text-[10px] uppercase tracking-widest mt-4 opacity-50 font-serif-body\" data-kid=\"3-4-2-2-1-3\" data-name=\"cabinets card sub-category description\">\n                        T-Bars & Finger Pulls\n                    </p>\n                </div>\n                <div class=\"flex-grow overflow-hidden relative\" data-kid=\"3-4-2-2-2\" data-name=\"cabinets card image container\">\n                    <img alt=\"Cabinet Hardware by Charlotte May\" class=\"w-full h-full object-cover opacity-60 group-hover:opacity-100 transition-all duration-1000 group-hover:scale-110\" data-kid=\"3-4-2-2-2-1\" data-name=\"cabinets card image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/5825555/pexels-photo-5825555.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\"/>\n                </div>\n            </div>\n            <!-- Bath -->\n            <div class=\"group relative flex flex-col h-[650px] md:w-1/4 overflow-hidden md:mt-24\" data-kid=\"3-4-2-3\" data-name=\"bath category card\" data-scroll=\"\" data-scroll-speed=\"-0.02\">\n                <div class=\"p-12 border-b border-[var(--jet)]/10 bg-[var(--parchment)] z-10\" data-kid=\"3-4-2-3-1\" data-name=\"bath card content container\">\n                    <div class=\"flex justify-between items-center mb-4\" data-kid=\"3-4-2-3-1-1\" data-name=\"bath card top row\">\n                        <span class=\"text-[10px] uppercase tracking-[0.3em] opacity-40\" data-kid=\"3-4-2-3-1-1-1\" data-name=\"bath card number label\">\n                            03\n                        </span>\n                        <i class=\"ti ti-arrow-up-right text-2xl opacity-0 group-hover:opacity-100 group-hover:text-[var(--copper)] transition-all duration-500 -translate-x-4 group-hover:translate-x-0\" data-kid=\"3-4-2-3-1-1-2\" data-name=\"bath card navigation icon\">\n                        </i>\n                    </div>\n                    <h3 class=\"font-serif-heading text-3xl uppercase tracking-widest\" data-kid=\"3-4-2-3-1-2\" data-name=\"bath card headline\">\n                        Bath\n                    </h3>\n                    <p class=\"text-[10px] uppercase tracking-widest mt-4 opacity-50 font-serif-body\" data-kid=\"3-4-2-3-1-3\" data-name=\"bath card sub-category description\">\n                        Fixtures & Hooks\n                    </p>\n                </div>\n                <div class=\"flex-grow overflow-hidden relative\" data-kid=\"3-4-2-3-2\" data-name=\"bath card image container\">\n                    <img alt=\"Modern Bathroom Fixtures by Peter Muniz\" class=\"w-full h-full object-cover grayscale brightness-90 group-hover:grayscale-0 group-hover:brightness-100 transition-all duration-1000 group-hover:scale-110\" data-kid=\"3-4-2-3-2-1\" data-name=\"bath card image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1763485955998-a9284d042d50?auto=format&w=1200&q=80&fit=crop\"/>\n                </div>\n            </div>\n            <!-- Lighting -->\n            <div class=\"group relative flex flex-col h-[750px] md:w-1/4 overflow-hidden\" data-kid=\"3-4-2-4\" data-name=\"lighting category card\" data-scroll=\"\">\n                <div class=\"p-12 border-b border-[var(--jet)]/10 z-10\" data-kid=\"3-4-2-4-1\" data-name=\"lighting card content container\">\n                    <div class=\"flex justify-between items-center mb-4\" data-kid=\"3-4-2-4-1-1\" data-name=\"lighting card top row\">\n                        <span class=\"text-[10px] uppercase tracking-[0.3em] opacity-40\" data-kid=\"3-4-2-4-1-1-1\" data-name=\"lighting card number label\">\n                            04\n                        </span>\n                        <i class=\"ti ti-arrow-up-right text-2xl opacity-0 group-hover:opacity-100 group-hover:text-[var(--copper)] transition-all duration-500 -translate-x-4 group-hover:translate-x-0\" data-kid=\"3-4-2-4-1-1-2\" data-name=\"lighting card navigation icon\">\n                        </i>\n                    </div>\n                    <h3 class=\"font-serif-heading text-3xl uppercase tracking-widest\" data-kid=\"3-4-2-4-1-2\" data-name=\"lighting card headline\">\n                        Lighting\n                    </h3>\n                    <p class=\"text-[10px] uppercase tracking-widest mt-4 opacity-50 font-serif-body\" data-kid=\"3-4-2-4-1-3\" data-name=\"lighting card sub-category description\">\n                        Sconces & Pendants\n                    </p>\n                </div>\n                <div class=\"flex-grow overflow-hidden relative\" data-kid=\"3-4-2-4-2\" data-name=\"lighting card image container\">\n                    <img alt=\"Solid Bronze Lighting by Olga Serjantu\" class=\"w-full h-full object-cover grayscale brightness-90 group-hover:grayscale-0 group-hover:brightness-100 transition-all duration-1000 group-hover:scale-110\" data-kid=\"3-4-2-4-2-1\" data-name=\"lighting card image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1573675580577-58973eafd7ab?auto=format&w=1200&q=80&fit=crop\"/>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Material Deep Dive -->\n    <section class=\"h-screen flex border-b border-[var(--jet)]/10 overflow-hidden\" data-kid=\"3-5\" data-name=\"material deep dive section\">\n        <!-- Unlacquered Brass -->\n        <div class=\"w-1/2 h-full relative group overflow-hidden border-r border-[var(--jet)] bg-[#E8E2D9]\" data-kid=\"3-5-1\" data-name=\"brass section container\">\n            <img alt=\"Unlacquered Brass Detail by Alessio RAZZOLINI\" class=\"absolute inset-0 w-full h-full object-cover opacity-70 transition-transform duration-1000 group-hover:scale-110 group-hover:opacity-90\" data-kid=\"3-5-1-1\" data-name=\"brass background image\" src=\"https://images.unsplash.com/photo-1739024263478-eaba5a53652b?auto=format&w=1200&q=80&fit=crop\"/>\n            <div class=\"absolute inset-0 bg-black/5 group-hover:bg-black/0 transition-all duration-500\" data-kid=\"3-5-1-2\" data-name=\"brass section overlay shade\">\n            </div>\n            <div class=\"absolute inset-0 flex flex-col justify-center items-center p-12 text-center z-10\" data-kid=\"3-5-1-3\" data-name=\"brass section content container\">\n                <div class=\"bg-[var(--parchment)]/90 backdrop-blur-md p-14 border border-[var(--jet)]/10 shadow-2xl\" data-kid=\"3-5-1-3-1\" data-name=\"brass info card\">\n                    <span class=\"text-[10px] uppercase tracking-[0.5em] mb-6 font-black text-[var(--copper)]\" data-kid=\"3-5-1-3-1-1\" data-name=\"brass section label\">\n                        Material Study / 01\n                    </span>\n                    <h3 class=\"font-serif-heading text-5xl md:text-6xl uppercase tracking-tighter text-[var(--jet)]\" data-kid=\"3-5-1-3-1-2\" data-name=\"brass section headline\">\n                        Unlacquered\n                        <br data-kid=\"3-5-1-3-1-2-1\" data-name=\"brass headline line break\"/>\n                        Brass\n                    </h3>\n                    <div class=\"mt-8 h-px w-16 bg-[var(--copper)] mx-auto\" data-kid=\"3-5-1-3-1-3\" data-name=\"brass info card decorative rule\">\n                    </div>\n                    <p class=\"mt-10 max-w-xs text-sm italic leading-relaxed text-[var(--jet)] font-serif-body\" data-kid=\"3-5-1-3-1-4\" data-name=\"brass section description\">\n                        A living finish that matures alongside the architecture. Every human touch accelerates a unique, deep golden patina.\n                    </p>\n                </div>\n            </div>\n        </div>\n        <!-- Burnished Steel -->\n        <div class=\"w-1/2 h-full relative group overflow-hidden bg-[var(--jet)]\" data-kid=\"3-5-2\" data-name=\"steel section container\">\n            <img alt=\"Burnished Steel\" class=\"absolute inset-0 w-full h-full object-cover opacity-30 grayscale transition-transform duration-1000 group-hover:scale-110\" data-kid=\"3-5-2-1\" data-name=\"steel background image\" src=\"https://images.unsplash.com/photo-1707651385161-af02d1e5816f?auto=format&w=1200&q=80&fit=crop\"/>\n            <div class=\"absolute inset-0 flex flex-col justify-center items-center p-12 text-center z-10 text-white\" data-kid=\"3-5-2-2\" data-name=\"steel section content container\">\n                <span class=\"text-[10px] uppercase tracking-[0.4em] mb-6 font-bold text-white/50\" data-kid=\"3-5-2-2-1\" data-name=\"steel section label\">\n                    Technical No. 04\n                </span>\n                <h3 class=\"font-serif-heading text-6xl uppercase tracking-tighter drop-shadow-sm\" data-kid=\"3-5-2-2-2\" data-name=\"steel section headline\">\n                    Burnished\n                    <br data-kid=\"3-5-2-2-2-1\" data-name=\"steel headline line break\"/>\n                    Steel\n                </h3>\n                <div class=\"mt-8 h-px w-12 bg-white/20\" data-kid=\"3-5-2-2-3\" data-name=\"steel info card decorative rule\">\n                </div>\n                <p class=\"mt-8 max-w-xs text-sm italic leading-relaxed text-white/70\" data-kid=\"3-5-2-2-4\" data-name=\"steel section description\">\n                    Industrial precision meeting artisanal polish. A cold, graphite-inspired aesthetic for modern minimalists.\n                </p>\n            </div>\n        </div>\n        <!-- Central Handle Overlay: Scaled Down -->\n        <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-20 hidden md:block\" data-kid=\"3-5-3\" data-name=\"central interaction marker container\">\n            <div class=\"w-16 h-16 rounded-full border border-[var(--jet)] flex items-center justify-center bg-[var(--parchment)] shadow-2xl group cursor-ew-resize hover:scale-110 transition-transform duration-300\" data-kid=\"3-5-3-1\" data-name=\"move icon button\">\n                <i class=\"ti ti-arrows-move text-xl group-hover:rotate-90 transition-transform\" data-kid=\"3-5-3-1-1\" data-name=\"arrows move icon\">\n                </i>\n            </div>\n        </div>\n    </section>\n    <!-- Archive Strip: Refined -->\n    <section class=\"py-10 border-b border-[var(--jet)]/10 overflow-hidden whitespace-nowrap bg-[var(--jet)] text-white/40\" data-kid=\"3-6\" data-name=\"archive marquee section\">\n        <div class=\"flex items-center gap-32 animate-[scroll_50s_linear_infinite]\" data-kid=\"3-6-1\" data-name=\"archive marquee track\">\n            <span class=\"text-[9px] uppercase tracking-[0.8em] font-bold hover:text-[var(--copper)] transition-colors cursor-default\" data-kid=\"3-6-1-1\" data-name=\"marquee archive item one\">\n                001 — THE FOUNDRY ARCHIVE\n            </span>\n            <span class=\"text-[9px] uppercase tracking-[0.8em] font-bold hover:text-[var(--copper)] transition-colors cursor-default\" data-kid=\"3-6-1-2\" data-name=\"marquee archive item two\">\n                002 — BRASS AND BONE\n            </span>\n            <span class=\"text-[9px] uppercase tracking-[0.8em] font-bold hover:text-[var(--copper)] transition-colors cursor-default\" data-kid=\"3-6-1-3\" data-name=\"marquee archive item three\">\n                003 — TACTILE MINIMALISM\n            </span>\n            <span class=\"text-[9px] uppercase tracking-[0.8em] font-bold hover:text-[var(--copper)] transition-colors cursor-default\" data-kid=\"3-6-1-4\" data-name=\"marquee archive item four\">\n                004 — THE SYNTAX OF SPACE\n            </span>\n            <span class=\"text-[9px] uppercase tracking-[0.8em] font-bold hover:text-[var(--copper)] transition-colors cursor-default\" data-kid=\"3-6-1-5\" data-name=\"marquee archive item five\">\n                005 — ARCHITECTURAL TACTILITY\n            </span>\n            <span class=\"text-[9px] uppercase tracking-[0.8em] font-bold hover:text-[var(--copper)] transition-colors cursor-default\" data-kid=\"3-6-1-6\" data-name=\"marquee archive item six\">\n                006 — CURATED PATINA\n            </span>\n        </div>\n    </section>\n    <!-- Footer -->\n    <footer class=\"py-12 px-8 bg-[var(--parchment)]\" data-kid=\"3-7\" data-name=\"footer section\">\n        <div class=\"flex flex-col md:flex-row justify-between items-center gap-8\" data-kid=\"3-7-1\" data-name=\"footer content layout\">\n            <div class=\"flex items-center gap-4\" data-kid=\"3-7-1-1\" data-name=\"footer logo and info group\">\n                <div class=\"w-10 h-10 bg-[var(--jet)] text-white flex items-center justify-center font-serif-heading text-xl\" data-kid=\"3-7-1-1-1\" data-name=\"footer logo mark\">\n                    S\n                </div>\n                <div class=\"flex flex-col\" data-kid=\"3-7-1-1-2\" data-name=\"footer brand name container\">\n                    <span class=\"text-[10px] uppercase tracking-widest font-bold\" data-kid=\"3-7-1-1-2-1\" data-name=\"footer brand name\">\n                        The Syntax\n                    </span>\n                    <span class=\"text-[8px] uppercase tracking-widest opacity-40\" data-kid=\"3-7-1-1-2-2\" data-name=\"footer tagline\">\n                        Hardware & Fittings\n                    </span>\n                </div>\n            </div>\n            <div class=\"flex gap-12 text-[10px] uppercase tracking-[0.2em] font-semibold opacity-60\" data-kid=\"3-7-1-2\" data-name=\"footer navigation links\">\n                <a class=\"hover:text-[var(--copper)] transition-colors\" data-kid=\"3-7-1-2-1\" data-name=\"instagram link\" href=\"#\">\n                    Instagram\n                </a>\n                <a class=\"hover:text-[var(--copper)] transition-colors\" data-kid=\"3-7-1-2-2\" data-name=\"pinterest link\" href=\"#\">\n                    Pinterest\n                </a>\n                <a class=\"hover:text-[var(--copper)] transition-colors\" data-kid=\"3-7-1-2-3\" data-name=\"newsletter link\" href=\"#\">\n                    Newsletter\n                </a>\n            </div>\n            <div class=\"text-[9px] uppercase tracking-widest opacity-30\" data-kid=\"3-7-1-3\" data-name=\"copyright notice text\">\n                © 2026 THE SYNTAX ARCHITECTURAL. ALL RIGHTS RESERVED.\n            </div>\n        </div>\n    </footer>\n</main>\n<script src=\"https://cdn.jsdelivr.net/npm/locomotive-scroll@5/bundled/locomotive-scroll.min.js\">\n</script>\n<script>\n    const locomotiveScroll = new LocomotiveScroll({\n        lenisOptions: {\n            duration: 1.2,\n            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),\n            smoothWheel: true,\n        }\n    });\n</script>\n<style>\n    @keyframes scroll {\n        0% { transform: translateX(0); }\n        100% { transform: translateX(-50%); }\n    }\n</style>\n",
