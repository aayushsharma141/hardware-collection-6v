]/10 bg-[#090909]/55\" data-kid=\"1-2-2-1-1-3\" data-name=\"mobile hero side panel\">\n                    </div>\n                    <div class=\"absolute bottom-7 left-6 right-6\" data-kid=\"1-2-2-1-1-4\" data-name=\"mobile hero text\">\n                        <p class=\"hc-mono text-[9px] uppercase tracking-[.2em] text-[#c8a96e]\" data-kid=\"1-2-2-1-1-4-1\" data-name=\"mobile hero label\">\n                            Authorized showroom · Sakchi\n                        </p>\n                        <div class=\"mt-4 h-px w-8 bg-[#c8a96e]\" data-kid=\"1-2-2-1-1-4-2\" data-name=\"mobile hero line\">\n                        </div>\n                        <h3 class=\"hc-editorial mt-4 text-[40px] leading-[.88] text-[#e8e3e9]\" data-kid=\"1-2-2-1-1-4-3\" data-name=\"mobile hero headline\">\n                            The Art of\n                            <br data-kid=\"1-2-2-1-1-4-3-1\" data-name=\"mobile hero headline break\"/>\n                            the Finish.\n                        </h3>\n                    </div>\n                </div>\n                <div class=\"border-t border-[#c8a96e] bg-[#11100f] px-6 pb-7 pt-6\" data-kid=\"1-2-2-1-2\" data-name=\"mobile hero content\">\n                    <p class=\"text-[12px] leading-5 text-[#aaa49a]\" data-kid=\"1-2-2-1-2-1\" data-name=\"mobile hero description\">\n                        Architectural hardware chosen for spaces that deserve better details.\n                    </p>\n                    <a class=\"hc-focus hc-cta mt-5 flex min-h-[50px] items-center justify-between border border-[#090909] px-4 text-[10px] font-bold uppercase tracking-[.16em] text-[#090909] no-underline\" data-kid=\"1-2-2-1-2-2\" data-name=\"mobile explore call-to-action button\" href=\"#families-mobile\" style=\"background:#c8a96e;box-shadow:inset 0 0 0 1px rgba(232,227,217,.32)\">\n                        <span data-kid=\"1-2-2-1-2-2-1\" data-name=\"button text\">\n                            Explore collections\n  