                               <span class=\"hc-mono text-[10px]\" data-kid=\"1-2-1-2-3-2-2-5-3\" data-name=\"option count\">\n                                    01\n                                </span>\n                            </button>\n                            <button class=\"mobile-filter-row hc-focus flex w-full items-center gap-3 text-left text-[#aaa49a]\" data-kid=\"1-2-1-2-3-2-2-6\" data-name=\"kitchen and wardrobes filter option\" type=\"button\">\n                                <span class=\"hc-mono w-5 text-[10px] text-[#c8a96e]\" data-kid=\"1-2-1-2-3-2-2-6-1\" data-name=\"option index\">\n                                    04\n                                </span>\n                                <span class=\"flex-1 text-[11px] uppercase tracking-[0.10em]\" data-kid=\"1-2-1-2-3-2-2-6-2\" data-name=\"option name\">\n                                    Kitchen & Wardrobes\n                                </span>\n                                <span class=\"hc-mono text-[10px]\" data-kid=\"1-2-1-2-3-2-2-6-3\" data-name=\"option count\">\n                                    04\n                                </span>\n                            </button>\n                            <button class=\"mobile-filter-row hc-focus flex w-full items-center gap-3 text-left text-[#aaa49a]\" data-kid=\"1-2-1-2-3-2-2-7\" data-name=\"furniture hardware filter option\" type=\"button\">\n                                <span class=\"hc-mono w-5 text-[10px] text-[#c8a96e]\" data-kid=\"1-2-1-2-3-2-2-7-1\" data-name=\"option index\">\n                                    05\n                                </span>\n                                <span class=\"flex-1 text-[11px] uppercase tracking-[0.10em]\" data-kid=\"1-2-1-2-3-2-2-7-2\" data-name=\"option name\">\n                                    Furniture Hardware\n                                </span>\n                                <span class=\"hc-mono text-[10px]\" data-kid=\"1-2-1-2-3-2-2-7-3\" data-name=\"option count\">\n                                    02\n                                </span>\n                            </button>\n                        </div>\n                        <div class=\"mt-5 border-t border-white/[0.12]\" data-kid=\"1-2-1-2-3-2-3\" data-name=\"brands filter group\">\n                            <p class=\"hc-mono mb-0 pt-4 text-[9px] uppercase tracking-[0.18em] text-[#aaa49a]\" data-kid=\"1-2-1-2-3-2-3-1\" data-name=\"filter group label\">\n                                Brands\n                            </p>\n                            <button class=\"hc-focus flex min-h-[52px] w-full items-center gap-3 border-b border-white/[0.08] text-left text-[11px] text-[#e8e3d9]\" data-kid=\"1-2-1-2-3-2-3-2\" data-name=\"all brands filter option\" type=\"button\">\n                                <span class=\"check-box is-checked\" data-kid=\"1-2-1-2-3-2-3-2-1\" data-name=\"checkbox indicator\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-check\" data-kid=\"1-2-1-2-3-2-3-2-1-1\" data-name=\"checkmark icon\" style=\"display:inline-flex;width:13px;height:13px;align-items:center;justify-content:center;font-size:13px;color:#090909\">\n                                    </i>\n                                </span>\n                                <span class=\"flex-1\" data-kid=\"1-2-1-2-3-2-3-2-2\" data-name=\"option name\">\n                                    All authorized brands\n                                </span>\n                                <span class=\"hc-mono text-[9px] text-[#c8a96e]\" data-kid=\"1-2-1-2-3-2-3-2-3\" data-name=\"option count\">\n                                    06\n                                </span>\n                            </button>\n                            <button class=\"hc-focus flex min-h-[52px] w-full items-center gap-3 border-b border-white/[0.08] text-left text-[11px] text-[#aaa49a]\" data-kid=\"1-2-1-2-3-2-3-3\" data-name=\"hafele filter option\" type=\"button\">\n                                <span class=\"check-box\" data-kid=\"1-2-1-2-3-2-3-3-1\" data-name=\"checkbox indicator\">\n                                </span>\n                                <span class=\"flex-1\" data-kid=\"1-2-1-2-3-2-3-3-2\" data-name=\"option name\">\n                                    Hafele\n                                </span>\n                                <span class=\"hc-mono text-[9px]\" data-kid=\"1-2-1-2-3-2-3-3-3\" data-name=\"option count\">\n                                    03\n                                </span>\n                            </button>\n                            <button class=\"hc-focus flex min-h-[52px] w-full items-center gap-3 border-b border-white/[0.08] text-left text-[11px] text-[#aaa49a]\" data-kid=\"1-2-1-2-3-2-3-4\" data-name=\"dorset filter option\" type=\"button\">\n                                <span class=\"check-box\" data-kid=\"1-2-1-2-3-2-3-4-1\" data-name=\"checkbox indicator\">\n                                </span>\n                                <span class=\"flex-1\" data-kid=\"1-2-1-2-3-2-3-4-2\" data-name=\"option name\">\n                                    Dorset\n                                </span>\n                                <span class=\"hc-mono text-[9px]\" data-kid=\"1-2-1-2-3-2-3-4-3\" data-name=\"option count\">\n                                    02\n                                </span>\n                            </button>\n                            <button class=\"hc-focus flex min-h-[52px] w-full items-center gap-3 border-b border-white/[0.08] text-left text-[11px] text-[#aaa49a]\" data-kid=\"1-2-1-2-3-2-3-5\" data-name=\"labacha filter option\" type=\"button\">\n                                <span class=\"check-box\" data-kid=\"1-2-1-2-3-2-3-5-1\" data-name=\"checkbox indicator\">\n                                </span>\n                                <span class=\"flex-1\" data-kid=\"1-2-1-2-3-2-3-5-2\" data-name=\"option name\">\n                                    Labacha\n                                </span>\n                                <span class=\"hc-mono text-[9px]\" data-kid=\"1-2-1-2-3-2-3-5-3\" data-name=\"option count\">\n                                    01\n                                </span>\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"absolute bottom-0 left-0 right-0 flex min-h-[76px] items-center gap-3 border-t border-white/[0.16] bg-[#11100f] px-5\" data-kid=\"1-2-1-2-3-3\" data-name=\"drawer action bar\">\n                        <button class=\"hc-focus min-h-[48px] flex-1 border border-[#c8a96e] bg-[#c8a96e] text-[10px] font-bold uppercase tracking-[0.15em] text-[#090909]\" data-kid=\"1-2-1-2-3-3-1\" data-name=\"show results button\" type=\"button\">\n                            Show results\n                        </button>\n                        <button class=\"hc-focus min-h-[48px] border-b border-[#c8a96e] px-3 text-[10px] uppercase tracking-[0.14em] text-[#e8e3d9]\" data-kid=\"1-2-1-2-3-3-2\" data-name=\"clear filters button\" type=\"button\">\n                            Clear\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n</div>\n",
