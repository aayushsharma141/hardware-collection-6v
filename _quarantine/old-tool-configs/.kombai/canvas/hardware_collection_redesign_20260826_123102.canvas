      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DM+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .hc-page { font-family: 'DM Sans', sans-serif; background: #090909; color: #e8e3d9; }\n  .hc-serif { font-family: 'Cormorant Garamond', Georgia, serif; }\n  .hc-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }\n  .hc-rule { height: 1px; background: rgba(232,227,217,.16); }\n  .hc-brass-rule { height: 1px; background: #c8a96e; }\n  .rail-button { position: relative; overflow: hidden; }\n  .rail-button::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: #c8a96e; transform: scaleX(0); transform-origin: left; transition: transform 220ms cubic-bezier(.22,1,.36,1); }\n  .rail-button:hover::after, .rail-button:focus-visible::after { transform: scaleX(1); }\n  .brass-plate { position: relative; box-shadow: inset 0 0 0 1px #090909; transition: background-color 220ms cubic-bezier(.22,1,.36,1), color 220ms cubic-bezier(.22,1,.36,1); }\n  .brass-plate::after { content: ''; position: absolute; left: 14px; right: 42px; bottom: 7px; height: 1px; background: rgba(9,9,9,.72); transform-origin: left; transition: transform 220ms cubic-bezier(.22,1,.36,1); }\n  .brass-plate:hover::after, .brass-plate:focus-visible::after { transform: translateX(12px); }\n  .aperture-sweep { position: absolute; top: 18%; bottom: 10%; left: 34%; width: 18%; background: linear-gradient(90deg, transparent, rgba(255,255,255,.13), transparent); transform: skewX(-18deg); opacity: .42; transition: transform 520ms cubic-bezier(.22,1,.36,1), opacity 260ms ease; pointer-events: none; }\n  .aperture:hover .aperture-sweep, .aperture:focus-within .aperture-sweep { transform: translateX(76px) skewX(-18deg); opacity: .72; }\n  .aperture-image { filter: contrast(1.04) saturate(.78); transition: filter 260ms ease; }\n  .aperture:hover .aperture-image, .aperture:focus-within .aperture-image { filter: contrast(1.12) saturate(.96); }\n  .threshold-card { position: relative; }\n  .threshold-card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 1px; background: rgba(200,169,110,0); transition: background-color 220ms cubic-bezier(.22,1,.36,1); }\n  .threshold-card:hover::before, .threshold-card:focus-within::before { background: #c8a96e; }\n  .threshold-card .threshold-action i { transform: translateX(0); transition: transform 220ms cubic-bezier(.22,1,.36,1); }\n  .threshold-card:hover .threshold-action i, .threshold-card:focus-within .threshold-action i { transform: translateX(6px); }\n  .threshold-card .threshold-image { transition: filter 220ms ease; }\n  .threshold-card:hover .threshold-image, .threshold-card:focus-within .threshold-image { filter: contrast(1.08) brightness(1.04); }\n  .mobile-row { min-height: 78px; position: relative; }\n  .mobile-row::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: transparent; transition: background-color 180ms ease; }\n  .mobile-row:hover::before, .mobile-row:focus-within::before { background: #c8a96e; }\n  .mobile-row i { transform: translateX(0); transition: transform 180ms cubic-bezier(.22,1,.36,1); }\n  .mobile-row:hover i, .mobile-row:focus-within i { transform: translateX(5px); }\n  .phone-frame { box-shadow: inset 0 0 0 1px rgba(232,227,217,.22), 0 0 0 8px #11100f, 0 0 0 9px rgba(232,227,217,.1); }\n  .phone-scrollbar { width: 3px; background: rgba(232,227,217,.14); }\n  .phone-scrollbar span { display: block; height: 92px; background: #c8a96e; }\n  @media (max-width: 900px) {\n    .desktop-only { display: none; }\n    .mobile-companion { margin-top: 32px; }\n  }\n</style>\n<div class=\"hc-page min-h-screen overflow-hidden\" data-kid=\"1\" data-name=\"page layout container\">\n    <section class=\"desktop-only relative min-h-[790px] border-b border-white/[0.12] overflow-hidden\" data-kid=\"1-1\" data-name=\"desktop hero section\">\n        <img alt=\"Architectural brass hardware in the Hardware Collection showroom\" class=\"absolute inset-0 h-full w-full object-cover opacity-[0.62]\" data-kid=\"1-1-1\" data-name=\"architectural hardware background image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/cinema/hero/HC-01-HERO-01.png\"/>\n        <div class=\"absolute inset-0 bg-[#090909]/[0.48]\" data-kid=\"1-1-2\" data-name=\"hero section dark overlay\">\n        </div>\n        <div class=\"absolute inset-y-0 left-0 w-[58%] bg-gradient-to-r from-[#090909]/[0.84] via-[#090909]/[0.44] to-transparent\" data-kid=\"1-1-3\" data-name=\"hero section gradient background\">\n        </div>\n        <header class=\"relative z-10 mx-[68px] pt-[28px]\" data-kid=\"1-1-4\" data-name=\"header container\">\n            <div class=\"h-[62px] border border-white/[0.18] bg-[#090909]/[0.88] grid grid-cols-[230px_1fr_360px] items-center\" data-kid=\"1-1-4-1\" data-name=\"header layout grid\">\n                <div class=\"h-full px-5 flex items-center gap-3 border-r border-white/[0.12]\" data-kid=\"1-1-4-1-1\" data-name=\"logo and brand name container\">\n                    <div class=\"h-8 w-8 border border-[#c8a96e]/[0.8] flex items-center justify-center text-[#c8a96e] text-[10px] font-semibold tracking-[0.08em]\" data-kid=\"1-1-4-1-1-1\" data-name=\"logo brand icon\">\n                        HC\n                    </div>\n                    <span class=\"hc-serif text-[22px] tracking-[0.04em] text-[#e8e3d9]\" data-kid=\"1-1-4-1-1-2\" data-name=\"brand name text\">\n                        Hardware Collection\n                    </span>\n                </div>\n                <nav aria-label=\"Primary\" class=\"h-full flex items-center justify-center gap-10 text-[10px] uppercase tracking-[0.22em] text-[#aaa49a]\" data-kid=\"1-1-4-1-2\" data-name=\"primary navigation menu\">\n                    <button class=\"rail-button h-full px-3 text-[#e8e3d9]\" data-kid=\"1-1-4-1-2-1\" data-name=\"home navigation button\" type=\"button\">\n                        Home\n                    </button>\n                    <button class=\"rail-button h-full px-3\" data-kid=\"1-1-4-1-2-2\" data-name=\"collections navigation button\" type=\"button\">\n                        Collections\n                    </button>\n                    <button class=\"rail-button h-full px-3\" data-kid=\"1-1-4-1-2-3\" data-name=\"showroom navigation button\" type=\"button\">\n                        Showroom\n                    </button>\n                </nav>\n                <div class=\"h-full flex items-center justify-end border-l border-white/[0.12]\" data-kid=\"1-1-4-1-3\" data-name=\"contact info and inquire button container\">\n                    <span class=\"hc-mono px-5 text-[10px] tracking-[0.12em] text-[#aaa49a]\" data-kid=\"1-1-4-1-3-1\" data-name=\"phone number text\">\n                        +91 98351 90738\n                    </span>\n                    <button class=\"brass-plate mr-3 h-9 px-5 bg-[#c8a96e] text-[#090909] text-[10px] font-bold uppercase tracking-[0.18em] flex items-center gap-3\" data-kid=\"1-1-4-1-3-2\" data-name=\"inquire call-to-action button\" type=\"button\">\n                        Inquire\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"1-1-4-1-3-2-1\" data-name=\"inquire button arrow icon\" style=\"font-size:15px;line-height:1;color:#090909;width:15px;height:15px\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n        </header>\n        <div class=\"relative z-10 mx-[112px] pt-[134px] grid grid-cols-[minmax(420px,500px)_1fr] items-end\" data-kid=\"1-1-5\" data-name=\"hero content area\">\n            <div class=\"pb-[52px]\" data-kid=\"1-1-5-1\" data-name=\"hero text content column\">\n                <div class=\"flex items-center gap-3 mb-7\" data-kid=\"1-1-5-1-1\" data-name=\"location indicator container\">\n                    <span class=\"h-1 w-1 bg-[#c8a96e]\" data-kid=\"1-1-5-1-1-1\" data-name=\"location indicator dot\">\n                    </span>\n                    <p class=\"hc-mono text-[10px] uppercase tracking-[0.22em] text-[#c8a96e]\" data-kid=\"1-1-5-1-1-2\" data-name=\"location address text\">\n                        Hardware Collection · Sakchi, Jamshedpur\n                    </p>\n                </div>\n                <h1 class=\"hc-serif text-[92px] leading-[0.84] font-normal tracking-[0.015em] text-[#e8e3d9]\" data-kid=\"1-1-5-1-2\" data-name=\"hero headline text\">\n                    The Art of\n                    <br data-kid=\"1-1-5-1-2-1\" data-name=\"headline line break\"/>\n                    <em class=\"not-italic text-[#e8e3d9]\" data-kid=\"1-1-5-1-2-2\" data-name=\"emphasized headline text\">\n                        the Finish.\n                    </em>\n                </h1>\n                <p class=\"mt-8 max-w-[395px] text-[15px] leading-[1.65] font-light text-[#d1ccc4]\" data-kid=\"1-1-5-1-3\" data-name=\"hero description text\">\n                    Architectural hardware chosen for spaces that deserve better details. Official partner for Häfele, Dorset, Labacha, Godrej & Hettich in Sakchi.\n                </p>\n                <div class=\"mt-10 flex items-center gap-6\" data-kid=\"1-1-5-1-4\" data-name=\"hero buttons container\">\n                    <button class=\"brass-plate h-[50px] px-6 bg-[#c8a96e] text-[#090909] text-[11px] font-bold uppercase tracking-[0.16em] flex items-center gap-7\" data-kid=\"1-1-5-1-4-1\" data-name=\"explore collections button\" type=\"button\">\n                        Explore collections\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"1-1-5-1-4-1-1\" data-name=\"explore collections arrow icon\" style=\"font-size:17px;line-height:1;color:#090909;width:17px;height:17px\">\n                        </i>\n                    </button>\n                    <button class=\"rail-button h-[50px] text-[11px] uppercase tracking-[0.16em] text-[#e8e3d9] flex items-center gap-2\" data-kid=\"1-1-5-1-4-2\" data-name=\"showroom directions button\" type=\"button\">\n                        Get showroom directions\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"1-1-5-1-4-2-1\" data-name=\"showroom directions arrow icon\" style=\"font-size:15px;line-height:1;color:#c8a96e;width:15px;height:15px\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <div aria-label=\"Hero product aperture\" class=\"aperture relative justify-self-end mr-[42px] h-[570px] w-[520px] border-x border-white/[0.14] bg-[#090909]/[0.92] overflow-hidden focus-within:border-[#c8a96e]/[0.75]\" data-kid=\"1-1-5-2\" data-name=\"hero product aperture card\" tabindex=\"0\">\n                <div class=\"absolute inset-x-0 top-0 h-px bg-[#c8a96e]/[0.8]\" data-kid=\"1-1-5-2-1\" data-name=\"aperture top border\">\n                </div>\n                <div class=\"absolute inset-x-0 bottom-0 h-px bg-[#c8a96e]/[0.4]\" data-kid=\"1-1-5-2-2\" data-name=\"aperture bottom border\">\n                </div>\n                <div class=\"absolute inset-y-0 left-0 w-px bg-[#c8a96e]/[0.22]\" data-kid=\"1-1-5-2-3\" data-name=\"aperture left border\">\n                </div>\n                <div class=\"absolute top-7 left-7 right-7 flex items-center justify-between hc-mono text-[9px] uppercase tracking-[0.2em] text-[#6e6a62]\" data-kid=\"1-1-5-2-4\" data-name=\"aperture header container\">\n                    <span data-kid=\"1-1-5-2-4-1\" data-name=\"aperture specimen label\">\n                        Selected specimen\n                    </span>\n                    <span data-kid=\"1-1-5-2-4-2\" data-name=\"aperture pagination count\">\n                        01 / 02\n                    </span>\n                </div>\n                <img alt=\"Close detail of a brass hardware finish\" class=\"aperture-image absolute inset-[46px_32px_84px] h-[440px] w-[456px] object-contain mix-blend-screen opacity-[0.9]\" data-kid=\"1-1-5-2-5\" data-name=\"aperture product detail image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/cinema/hero/HC-01-HERO-03.png\"/>\n                <div class=\"aperture-sweep\" data-kid=\"1-1-5-2-6\" data-name=\"aperture hover effect sweep\">\n                </div>\n                <div class=\"absolute bottom-7 left-7 right-7 flex items-end justify-between border-t border-white/[0.12] pt-4\" data-kid=\"1-1-5-2-7\" data-name=\"aperture footer container\">\n                    <div data-kid=\"1-1-5-2-7-1\" data-name=\"aperture footer label container\">\n                        <p class=\"hc-mono text-[9px] uppercase tracking-[0.18em] text-[#6e6a62]\" data-kid=\"1-1-5-2-7-1-1\" data-name=\"aperture finish study label\">\n                            Finish study\n                        </p>\n                        <p class=\"mt-1 text-[12px] uppercase tracking-[0.16em] text-[#d1ccc4]\" data-kid=\"1-1-5-2-7-1-2\" data-name=\"aperture material description text\">\n                            Solid brass · PVD satin gold\n                        </p>\n                    </div>\n                    <i aria-hidden=\"true\" class=\"ti ti-corner-down-right\" data-kid=\"1-1-5-2-7-2\" data-name=\"aperture navigation arrow icon\" style=\"font-size:18px;line-height:1;color:#c8a96e;width:18px;height:18px\">\n                    </i>\n                </div>\n            </div>\n        </div>\n        <div class=\"absolute bottom-0 left-[68px] right-[68px] z-10 border-t border-white/[0.18] h-[56px] flex items-center justify-between\" data-kid=\"1-1-6\" data-name=\"hero section bottom bar\">\n            <div class=\"flex items-center gap-4\" data-kid=\"1-1-6-1\" data-name=\"hero pagination container\">\n                <span class=\"hc-mono text-[10px] tracking-[0.16em] text-[#c8a96e]\" data-kid=\"1-1-6-1-1\" data-name=\"current slide index\">\n                    01\n                </span>\n                <span class=\"hc-mono text-[10px] tracking-[0.18em] text-[#6e6a62]\" data-kid=\"1-1-6-1-2\" data-name=\"total slide count\">\n                    / 02\n                </span>\n                <span class=\"h-px w-12 bg-[#c8a96e]/[0.55]\" data-kid=\"1-1-6-1-3\" data-name=\"pagination separator line\">\n                </span>\n                <span class=\"text-[10px] uppercase tracking-[0.18em] text-[#aaa49a]\" data-kid=\"1-1-6-1-4\" data-name=\"current slide title\">\n                    The threshold\n                </span>\n            </div>\n            <span class=\"hc-mono text-[10px] uppercase tracking-[0.18em] text-[#6e6a62]\" data-kid=\"1-1-6-2\" data-name=\"scroll hint text\">\n                Scroll to showroom families ↓\n            </span>\n        </div>\n    </section>\n    <section class=\"desktop-only px-[68px] pt-[92px] pb-[120px] bg-[#090909]\" data-kid=\"1-2\" data-name=\"showroom families section\">\n        <div class=\"flex items-end justify-between border-b border-white/[0.16] pb-6\" data-kid=\"1-2-1\" data-name=\"showroom section header container\">\n            <div data-kid=\"1-2-1-1\" data-name=\"showroom section title container\">\n                <p class=\"hc-mono text-[10px] uppercase tracking-[0.22em] text-[#c8a96e]\" data-kid=\"1-2-1-1-1\" data-name=\"showroom section subheadline\">\n                    Showroom families / 05\n                </p>\n                <h2 class=\"hc-serif mt-4 text-[57px] leading-none font-normal tracking-[0.02em] text-[#e8e3d9]\" data-kid=\"1-2-1-1-2\" data-name=\"showroom section headline\">\n                    Five thresholds\n                </h2>\n            </div>\n            <p class=\"max-w-[360px] text-right text-[13px] leading-[1.6] text-[#aaa49a]\" data-kid=\"1-2-1-2\" data-name=\"showroom section description\">\n                A considered route through architectural hardware, security, bath, kitchen systems and the joinery details that finish a room.\n            </p>\n        </div>\n        <div class=\"mt-9 grid grid-cols-[0.92fr_1.28fr_0.88fr_1.08fr_0.92fr] gap-[1px] bg-white/[0.13]\" data-kid=\"1-2-2\" data-name=\"showroom categories grid\">\n            <article class=\"threshold-card bg-[#11100f] pb-5\" data-kid=\"1-2-2-1\" data-name=\"handles and knobs card\">\n                <div class=\"threshold-image relative aspect-[5/7] overflow-hidden bg-[#181716]\" data-kid=\"1-2-2-1-1\" data-name=\"handles category image container\">\n                    <img alt=\"Handles and knobs showroom family\" class=\"h-full w-full object-cover opacity-[0.82]\" data-kid=\"1-2-2-1-1-1\" data-name=\"handles category image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/cinema/categories/HC-03-DOORS.png\"/>\n                    <div class=\"absolute inset-0 bg-[#090909]/[0.18]\" data-kid=\"1-2-2-1-1-2\" data-name=\"handles card overlay\">\n                    </div>\n                    <span class=\"absolute left-4 top-4 hc-mono text-[10px] tracking-[0.16em] text-[#c8a96e]\" data-kid=\"1-2-2-1-1-3\" data-name=\"handles category index\">\n                        01 / 05\n                    </span>\n                </div>\n                <div class=\"border-t border-[#c8a96e]/[0.65] bg-[#090909] px-5 pt-5 pb-4\" data-kid=\"1-2-2-1-2\" data-name=\"handles card content container\">\n                    <h3 class=\"hc-serif text-[30px] leading-[0.94] text-[#e8e3d9]\" data-kid=\"1-2-2-1-2-1\" data-name=\"handles card title\">\n                        Handles\n                        <br data-kid=\"1-2-2-1-2-1-1\" data-name=\"handles card title break\"/>\n                        & Knobs\n                    </h3>\n                    <p class=\"mt-4 text-[11px] leading-[1.5] text-[#aaa49a]\" data-kid=\"1-2-2-1-2-2\" data-name=\"handles card description\">\n                        Contemporary profiles to classical architectural detailing.\n                    </p>\n                    <p class=\"mt-4 border-t border-white/[0.12] pt-3 text-[10px] leading-[1.5] text-[#6e6a62]\" data-kid=\"1-2-2-1-2-3\" data-name=\"handles card detail text\">\n                        Solid forged brass pull handle, PVD Rose Gold.\n                    </p>\n                    <button class=\"threshold-action mt-5 flex items-center gap-3 text-[10px] uppercase tracking-[0.18em] text-[#d1ccc4]\" data-kid=\"1-2-2-1-2-4\" data-name=\"view handles button\" type=\"button\">\n                        View Handles & Knobs\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"1-2-2-1-2-4-1\" data-name=\"view handles arrow icon\" style=\"font-size:15px;line-height:1;color:#c8a96e;width:15px;height:15px\">\n                        </i>\n                    </button>\n                </div>\n            </article>\n            <article class=\"threshold-card bg-[#11100f] pb-5\" data-kid=\"1-2-2-2\" data-name=\"door hardware card\">\n                <div class=\"threshold-image relative aspect-[5/7] overflow-hidden bg-[#181716]\" data-kid=\"1-2-2-2-1\" data-name=\"door category image container\">\n                    <img alt=\"Door hardware showroom family\" class=\"h-full w-full object-cover opacity-[0.9]\" data-kid=\"1-2-2-2-1-1\" data-name=\"door category image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/cinema/categories/HC-03-SECURITY.png\"/>\n                    <div class=\"absolute inset-0 bg-[#090909]/[0.1]\" data-kid=\"1-2-2-2-1-2\" data-name=\"door card overlay\">\n                    </div>\n                    <span class=\"absolute left-4 top-4 hc-mono text-[10px] tracking-[0.16em] text-[#c8a96e]\" data-kid=\"1-2-2-2-1-3\" data-name=\"door category index\">\n                        02 / 05\n                    </span>\n                    <span class=\"absolute right-4 top-4 border border-[#c8a96e]/[0.5] px-2 py-1 hc-mono text-[8px] uppercase tracking-[0.14em] text-[#c8a96e]\" data-kid=\"1-2-2-2-1-4\" data-name=\"door category highlight label\">\n                        Focal family\n                    </span>\n                </div>\n                <div class=\"border-t border-[#c8a96e] bg-[#090909] px-6 pt-5 pb-4\" data-kid=\"1-2-2-2-2\" data-name=\"door card content container\">\n                    <h3 class=\"hc-serif text-[38px] leading-[0.9] text-[#e8e3d9]\" data-kid=\"1-2-2-2-2-1\" data-name=\"door card title\">\n                        Door\n                        <br data-kid=\"1-2-2-2-2-1-1\" data-name=\"door card title break\"/>\n                        Hardware\n                    </h3>\n                    <p class=\"mt-4 text-[11px] leading-[1.5] text-[#aaa49a]\" data-kid=\"1-2-2-2-2-2\" data-name=\"door card description\">\n                        High-security locking systems and precision entrance controls.\n                    </p>\n                    <p class=\"mt-4 border-t border-white/[0.12] pt-3 text-[10px] leading-[1.5] text-[#6e6a62]\" data-kid=\"1-2-2-2-2-3\" data-name=\"door card detail text\">\n                        Dorset biometric deadbolt & SS 304 mortise lockset.\n                    </p>\n                    <button class=\"threshold-action mt-5 flex items-center gap-3 text-[10px] uppercase tracking-[0.18em] text-[#d1ccc4]\" data-kid=\"1-2-2-2-2-4\" data-name=\"view door button\" type=\"button\">\n                        View Door Hardware\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-right\" data-kid=\"1-2-2-2-2-4-1\" data-name=\"view door arrow icon\" style=\"font-size:15px;line-height:1;color:#c8a96e;width:15px;height:15px\">\n                        </i>\n                    </button>\n                </div>\n            </article>\n            <article class=\"threshold-card bg-[#11100f] pb-5\" data-kid=\"1-2-2-3\" data-name=\"bathroom card\">\n                <div class=\"threshold-image relative aspect-[5/7] overflow-hidden bg-[#181716]\" data-kid=\"1-2-2-3-1\" data-name=\"bathroom category image container\">\n                    <img alt=\"Bathroom showroom family\" class=\"h-full w-full object-cover opacity-[0.78]\" data-kid=\"1-2-2-3-1-1\" data-name=\"bathroom category image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/cinema/categories/HC-03-BATHROOM.png\"/>\n                    <div class=\"absolute inset-0 bg-[#090909]/[0.2]\" data-kid=\"1-2-2-3-1-2\" data-name=\"bathroom card overlay\">\n                    </div>\n                    <span class=\"absolute left-4 top-4 hc-mono text-[10px] tracking-[0.16em] text-[#c8a96e]\" data-kid=\"1-2-2-3-1-3\" data-name=\"bathroom category index\">\n                        03 / 05\n                    </span>\n                </div>\n                <div class=\"border-t border-[#c8a96e]/[0.65] bg-[#090909] px-5 pt-5 pb-4\" data-kid=\"1-2-2-3-2\" data-name=\"bathroom card content container\">\n                    <h3 class=\"hc-serif text-[30px] leading-[0.94] text-[#e8e3d9]\" data-kid=\"1-2-2-3-2-1\" data-name=\"bathroom card title\">\n                        Bathroom\n                    </h3>\n                    <p class=\"mt-4 text-[11px] leading-[1.5] text-[#aaa49a]\" data-kid=\"1-2-2-3-2-2\" data-name=\"bathroom card description\">\n                        Luxury shower fittings, mirrors and precision stainless steel suites.\n                    </p>\n                    <p class=\"mt-4 border-t border-white/[0.12] pt-3 text-[10px] leading-[1.5] text-[#6e6a62]\" data-kid=\"1-2-2-3-2-3\" data-name=\"bathroom card detail text\">\n                        Solid brass thermostatic shower suite, matte black.\n                    </p>\n                    <button class=\"threshold-action mt-5 flex items-center gap-3 text-[10px] uppercase tracking-[0.18em] text-[#d1ccc4]\" data-kid=\"1-2-2-3-2-4\" data-name=\"view bathroom button\" ty