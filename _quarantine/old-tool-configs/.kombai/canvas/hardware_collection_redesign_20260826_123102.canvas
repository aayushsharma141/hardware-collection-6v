      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DM+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n  .catalogue-shell {\n    --black: #090909;\n    --obsidian: #11100f;\n    --graphite: #181716;\n    --bone: #e8e3d9;\n    --muted: #aaa49a;\n    --brass: #c8a96e;\n    --line: rgba(232,227,217,.15);\n    --soft-line: rgba(232,227,217,.08);\n    --ease: cubic-bezier(.22,1,.36,1);\n    font-family: 'DM Sans', sans-serif;\n    background: #090909;\n    color: #e8e3d9;\n  }\n  .font-editorial { font-family: 'Cormorant Garamond', Georgia, serif; }\n  .font-utility { font-family: 'DM Sans', sans-serif; }\n  .font-technical { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }\n  .hairline { border-color: rgba(232,227,217,.15); }\n  .softline { border-color: rgba(232,227,217,.08); }\n  .rail-row { position: relative; transition: color .22s var(--ease), border-color .22s var(--ease), background-color .22s var(--ease); }\n  .rail-row:hover { color: #e8e3d9; background: rgba(232,227,217,.035); }\n  .rail-row.selected { color: #c8a96e; }\n  .rail-row.selected::after { content: ''; position: absolute; right: -1px; bottom: -1px; width: 44px; height: 2px; background: #c8a96e; }\n  .filter-row { transition: background-color .2s var(--ease), color .2s var(--ease); }\n  .filter-row:hover { background: rgba(232,227,217,.045); color: #e8e3d9; }\n  .filter-row.selected { color: #c8a96e; background: rgba(200,169,110,.08); }\n  .filter-row.selected .filter-rule { background: #c8a96e; }\n  .filter-rule { width: 2px; height: 22px; background: rgba(232,227,217,.12); transition: background-color .2s var(--ease); }\n  .bench-plate { transition: border-color .22s var(--ease), background-color .22s var(--ease); }\n  .bench-plate:hover { border-color: rgba(200,169,110,.48); background: rgba(24,23,22,.92); }\n  .plate-button { position: relative; overflow: hidden; transition: background-color .22s var(--ease), color .22s var(--ease), border-color .22s var(--ease); }\n  .plate-button::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: 7px; height: 1px; background: #090909; transform: scaleX(.28); transform-origin: left; transition: transform .32s var(--ease); }\n  .plate-button:hover::after, .plate-button:focus-visible::after { transform: scaleX(1); }\n  .plate-button i { transition: transform .32s var(--ease); }\n  .plate-button:hover i, .plate-button:focus-visible i { transform: translate(4px,-4px); }\n  .outline-action { transition: border-color .22s var(--ease), color .22s var(--ease), background-color .22s var(--ease); }\n  .outline-action:hover, .outline-action:focus-visible { border-color: rgba(200,169,110,.62); color: #e8e3d9; background: rgba(200,169,110,.08); }\n  .product-tray { transition: border-color .22s var(--ease), background-color .22s var(--ease); }\n  .product-tray:hover, .product-tray:focus-within { border-color: rgba(200,169,110,.56); background: rgba(24,23,22,.72); }\n  .pedestal-reflection { transform: translateX(-10%); transition: transform .32s var(--ease), opacity .32s var(--ease); }\n  .product-tray:hover .pedestal-reflection, .product-tray:focus-within .pedestal-reflection { transform: translateX(8%); opacity: .85; }\n  .spec-link i { transition: transform .22s var(--ease); }\n  .spec-link:hover i, .spec-link:focus-visible i { transform: translateX(6px); }\n  .shortlist-control i { transition: transform .22s var(--ease); }\n  .shortlist-control:hover i, .shortlist-control:focus-visible i { transform: rotate(45deg); }\n  .phone-family { transition: background-color .2s var(--ease), color .2s var(--ease); }\n  .phone-family:hover { background: rgba(200,169,110,.08); color: #e8e3d9; }\n  .focus-ring:focus-visible { outline: 2px solid #c8a96e; outline-offset: 3px; }\n  .mobile-sheet-scroll { scrollbar-width: none; }\n  .mobile-sheet-scroll::-webkit-scrollbar { display: none; }\n</style>\n<div class=\"catalogue-shell min-h-screen bg-[#090909] text-[#e8e3d9] selection:bg-[#c8a96e] selection:text-[#090909]\" data-kid=\"1\" data-name=\"catalogue page container\">\n    <div class=\"mx-auto max-w-[1400px] px-8 py-8\" data-kid=\"1-1\" data-name=\"page layout wrapper\">\n        <div class=\"grid grid-cols-[minmax(0,1fr)_292px] gap-8 items-start\" data-kid=\"1-1-1\" data-name=\"grid content layout\">\n            <div class=\"min-w-0\" data-kid=\"1-1-1-1\" data-name=\"main content column\">\n                <header class=\"border border-white/[0.12] bg-[#11100f]\" data-kid=\"1-1-1-1-1\" data-name=\"catalogue header\">\n                    <div class=\"h-[58px] flex items-center justify-between border-b border-white/[0.1] px-6\" data-kid=\"1-1-1-1-1-1\" data-name=\"navigation bar container\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1-1-1-1\" data-name=\"brand logo area\">\n                            <div class=\"h-7 w-7 border border-[#c8a96e]/70 flex items-center justify-center text-[10px] font-technical font-bold tracking-[-0.08em] text-[#c8a96e]\" data-kid=\"1-1-1-1-1-1-1-1\" data-name=\"brand logo icon\">\n                                HC\n                            </div>\n                            <span class=\"font-editorial text-[21px] tracking-[0.04em] text-[#e8e3d9]\" data-kid=\"1-1-1-1-1-1-1-2\" data-name=\"brand name text\">\n                                Hardware Collection\n                            </span>\n                        </div>\n                        <nav class=\"flex items-center gap-0 text-[10px] font-utility uppercase tracking-[0.18em] text-[#aaa49a]\" data-kid=\"1-1-1-1-1-1-2\" data-name=\"navigation links container\">\n                            <a class=\"focus-ring flex h-[34px] items-center border-l border-white/[0.1] px-5 hover:text-[#e8e3d9]\" data-kid=\"1-1-1-1-1-1-2-1\" data-name=\"home link\" href=\"#home\">\n                                Home\n                            </a>\n                            <a class=\"focus-ring flex h-[34px] items-center border-l border-white/[0.1] px-5 text-[#c8a96e]\" data-kid=\"1-1-1-1-1-1-2-2\" data-name=\"collections link\" href=\"#collection\">\n                                Collections\n                            </a>\n                            <span class=\"flex h-[34px] items-center border-l border-white/[0.1] px-5 font-technical text-[9px] tracking-[0.12em] text-[#aaa49a]\" data-kid=\"1-1-1-1-1-1-2-3\" data-name=\"contact phone text\">\n                                +91 98351 90738\n                            </span>\n                            <a class=\"plate-button focus-ring ml-3 flex h-[34px] items-center gap-3 bg-[#c8a96e] px-4 text-[10px] font-utility font-bold uppercase tracking-[0.14em] text-[#090909]\" data-kid=\"1-1-1-1-1-1-2-4\" data-name=\"inquire call-to-action button\" href=\"#consult\">\n                                Inquire\n                                <i class=\"ti ti-arrow-up-right text-[13px]\" data-kid=\"1-1-1-1-1-1-2-4-1\" data-name=\"arrow icon\" style=\"color:#090909;width:13px;height:13px;display:inline-flex;align-items:center;justify-content:center\">\n                                </i>\n                            </a>\n                        </nav>\n                    </div>\n                    <div class=\"grid min-h-[187px] grid-cols-[1.1fr_.9fr] gap-10 px-8 pt-7 pb-6\" data-kid=\"1-1-1-1-1-2\" data-name=\"hero section\">\n                        <div class=\"flex flex-col justify-between\" data-kid=\"1-1-1-1-1-2-1\" data-name=\"hero content area\">\n                            <div data-kid=\"1-1-1-1-1-2-1-1\" data-name=\"hero sub-headline area\">\n                                <div class=\"mb-3 flex items-center gap-2 font-technical text-[9px] uppercase tracking-[0.22em] text-[#aaa49a]\" data-kid=\"1-1-1-1-1-2-1-1-1\" data-name=\"breadcrumb or indicator\">\n                                    <span class=\"h-1 w-1 bg-[#c8a96e]\" data-kid=\"1-1-1-1-1-2-1-1-1-1\" data-name=\"accent dot\">\n                                    </span>\n                                    Authorized showroom\n                                </div>\n                                <h1 class=\"font-editorial text-[66px] font-normal uppercase leading-[.86] tracking-[0.04em] text-[#e8e3d9]\" data-kid=\"1-1-1-1-1-2-1-1-2\" data-name=\"hero headline\">\n                                    The\n                                    <br data-kid=\"1-1-1-1-1-2-1-1-2-1\" data-name=\"line break\"/>\n                                    Collection\n                                </h1>\n                            </div>\n                            <p class=\"font-utility max-w-[31ch] text-[11px] leading-[1.55] text-[#aaa49a]\" data-kid=\"1-1-1-1-1-2-1-2\" data-name=\"hero description\">\n                                Architectural hardware for considered residential and commercial interiors. Browse selected products, references and specification support from our Sakchi showroom.\n                            </p>\n                        </div>\n                        <div class=\"flex flex-col justify-end border-l border-[#c8a96e]/60 pl-7\" data-kid=\"1-1-1-1-1-2-2\" data-name=\"hero bench info area\">\n                            <p class=\"mb-3 font-technical text-[9px] uppercase tracking-[0.2em] text-[#c8a96e]\" data-kid=\"1-1-1-1-1-2-2-1\" data-name=\"bench label\">\n                                The catalogue bench\n                            </p>\n                            <p class=\"max-w-[38ch] font-utility text-[14px] leading-[1.55] text-[#e8e3d9]\" data-kid=\"1-1-1-1-1-2-2-2\" data-name=\"bench description\">\n                                Selected hardware is presented as a measured contact sheet—one place to compare finish, fit and the next specification step.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center justify-between border-t border-white/[0.1] px-8 py-3 font-technical text-[9px] uppercase tracking-[0.19em] text-[#aaa49a]\" data-kid=\"1-1-1-1-1-3\" data-name=\"header footer bar\">\n                        <span data-kid=\"1-1-1-1-1-3-1\" data-name=\"showroom count text\">\n                            01 / 05 · showroom families\n                        </span>\n                        <span class=\"text-[#c8a96e]\" data-kid=\"1-1-1-1-1-3-2\" data-name=\"location text\">\n                            Sakchi · Jamshedpur\n                        </span>\n                    </div>\n                </header>\n                <div class=\"mt-8 grid grid-cols-[220px_minmax(0,1fr)] gap-8\" data-kid=\"1-1-1-1-2\" data-name=\"catalogue section\" id=\"collection\">\n                    <aside aria-label=\"Collection index\" class=\"border-r border-white/[0.14] pr-6\" data-kid=\"1-1-1-1-2-1\" data-name=\"collection index sidebar\">\n                        <div class=\"mb-4 flex items-center justify-between border-b border-white/[0.1] pb-3\" data-kid=\"1-1-1-1-2-1-1\" data-name=\"index header\">\n                            <span class=\"font-technical text-[9px] uppercase tracking-[0.2em] text-[#c8a96e]\" data-kid=\"1-1-1-1-2-1-1-1\" data-name=\"index title\">\n                                Collection index\n                            </span>\n                            <span class=\"font-technical text-[9px] text-[#aaa49a]\" data-kid=\"1-1-1-1-2-1-1-2\" data-name=\"index count\">\n                                18 total\n                            </span>\n                        </div>\n                        <a class=\"rail-row focus-ring flex min-h-[38px] items-center justify-between border-b border-white/[0.08] px-2 text-[10px] font-utility uppercase tracking-[0.12em] text-[#e8e3d9]\" data-kid=\"1-1-1-1-2-1-2\" data-name=\"all collections link\" href=\"#all\">\n                            <span data-kid=\"1-1-1-1-2-1-2-1\" data-name=\"all collections text\">\n                                All collections\n                            </span>\n                            <span class=\"font-technical text-[9px] text-[#aaa49a]\" data-kid=\"1-1-1-1-2-1-2-2\" data-name=\"all collections count\">\n                                18\n                            </span>\n                        </a>\n                        <p class=\"mb-2 mt-6 px-2 font-technical text-[8px] uppercase tracking-[0.2em] text-[#aaa49a]/60\" data-kid=\"1-1-1-1-2-1-3\" data-name=\"family category label\">\n                            Showroom families\n                        </p>\n                        <div class=\"space-y-0\" data-kid=\"1-1-1-1-2-1-4\" data-name=\"families list container\">\n                            <a class=\"rail-row focus-ring grid min-h-[42px] grid-cols-[27px_1fr_22px] items-center border-b border-white/[0.08] px-2 text-[#aaa49a]\" data-kid=\"1-1-1-1-2-1-4-1\" data-name=\"handles link\" href=\"#handles\">\n                                <span class=\"font-technical text-[9px] text-[#c8a96e]/70\" data-kid=\"1-1-1-1-2-1-4-1-1\" data-name=\"handle index\">\n                                    01\n                                </span>\n                                <span class=\"font-utility text-[10px] uppercase tracking-[0.08em]\" data-kid=\"1-1-1-1-2-1-4-1-2\" data-name=\"handle text\">\n                                    Handles & knobs\n                                </span>\n                                <span class=\"font-technical text-[9px] text-right\" data-kid=\"1-1-1-1-2-1-4-1-3\" data-name=\"handle count\">\n                                    2\n                                </span>\n                            </a>\n                            <div class=\"rail-row selected grid min-h-[42px] grid-cols-[27px_1fr_22px] items-center border-b border-white/[0.1] px-2\" data-kid=\"1-1-1-1-2-1-4-2\" data-name=\"door hardware link\">\n                                <span class=\"font-technical text-[9px]\" data-kid=\"1-1-1-1-2-1-4-2-1\" data-name=\"door hardware index\">\n                                    02\n                                </span>\n                                <span class=\"font-utility text-[10px] uppercase tracking-[0.08em]\" data-kid=\"1-1-1-1-2-1-4-2-2\" data-name=\"door hardware text\">\n                                    Door hardware\n                                </span>\n                                <span class=\"font-technical text-[9px] text-right\" data-kid=\"1-1-1-1-2-1-4-2-3\" data-name=\"door hardware count\">\n                                    6\n                                </span>\n                            </div>\n                            <div class=\"ml-[28px] border-l border-[#c8a96e]/45 py-1\" data-kid=\"1-1-1-1-2-1-4-3\" data-name=\"sub-menu container\">\n                                <a class=\"focus-ring flex min-h-[31px] items-center justify-between pl-3 pr-2 font-utility text-[10px] text-[#c8a96e]\" data-kid=\"1-1-1-1-2-1-4-3-1\" data-name=\"digital locks sub-link\" href=\"#digital\">\n                                    <span class=\"border-b border-[#c8a96e] pb-[2px]\" data-kid=\"1-1-1-1-2-1-4-3-1-1\" data-name=\"digital locks text\">\n                                        Digital locks\n                                    </span>\n                                    <span class=\"font-technical text-[9px]\" data-kid=\"1-1-1-1-2-1-4-3-1-2\" data-name=\"digital locks count\">\n                                        2\n                                    </span>\n                                </a>\n                                <a class=\"focus-ring flex min-h-[31px] items-center justify-between pl-3 pr-2 font-utility text-[10px] text-[#aaa49a]\" data-kid=\"1-1-1-1-2-1-4-3-2\" data-name=\"mortise locks sub-link\" href=\"#mortise\">\n                                    <span data-kid=\"1-1-1-1-2-1-4-3-2-1\" data-name=\"mortise locks text\">\n                                        Mortise & door locks\n                                    </span>\n                                    <span class=\"font-technical text-[9px]\" data-kid=\"1-1-1-1-2-1-4-3-2-2\" data-name=\"mortise locks count\">\n                                        2\n                                    </span>\n                                </a>\n                                <a class=\"focus-ring flex min-h-[31px] items-center justify-between pl-3 pr-2 font-utility text-[10px] text-[#aaa49a]\" data-kid=\"1-1-1-1-2-1-4-3-3\" data-name=\"glass hardware sub-link\" href=\"#glass\">\n                                    <span data-kid=\"1-1-1-1-2-1-4-3-3-1\" data-name=\"glass hardware text\">\n                                        Glass hardware\n                                    </span>\n                                    <span class=\"font-technical text-[9px]\" data-kid=\"1-1-1-1-2-1-4-3-3-2\" data-name=\"glass hardware count\">\n                                        1\n                                    </span>\n                                </a>\n                                <a class=\"focus-ring flex min-h-[31px] items-center justify-between pl-3 pr-2 font-utility text-[10px] text-[#aaa49a]\" data-kid=\"1-1-1-1-2-1-4-3-4\" data-name=\"door closers sub-link\" href=\"#closers\">\n                                    <span data-kid=\"1-1-1-1-2-1-4-3-4-1\" data-name=\"door closers text\">\n                                        Door closers\n                                    </span>\n                                    <span class=\"font-technical text-[9px]\" data-kid=\"1-1-1-1-2-1-4-3-4-2\" data-name=\"door closers count\">\n                                        0\n                                    </span>\n                                </a>\n                            </div>\n                            <a class=\"rail-row focus-ring grid min-h-[42px] grid-cols-[27px_1fr_22px] items-center border-b border-white/[0.08] px-2 text-[#aaa49a]\" data-kid=\"1-1-1-1-2-1-4-4\" data-name=\"bathroom link\" href=\"#bathroom\">\n                                <span class=\"font-technical text-[9px] text-[#c8a96e]/70\" data-kid=\"1-1-1-1-2-1-4-4-1\" data-name=\"bathroom index\">\n                                    03\n                                </span>\n                                <span class=\"font-utility text-[10px] uppercase tracking-[0.08em]\" data-kid=\"1-1-1-1-2-1-4-4-2\" data-name=\"bathroom text\">\n                                    Bathroom\n                                </span>\n                                <span class=\"font-technical text-[9px] text-right\" data-kid=\"1-1-1-1-2-1-4-4-3\" data-name=\"bathroom count\">\n                                    1\n                                </span>\n                            </a>\n                            <a class=\"rail-row focus-ring grid min-h-[42px] grid-cols-[27px_1fr_22px] items-center border-b border-white/[0.08] px-2 text-[#aaa49a]\" data-kid=\"1-1-1-1-2-1-4-5\" data-name=\"kitchen link\" href=\"#kitchen\">\n                                <span class=\"font-technical text-[9px] text-[#c8a96e]/70\" data-kid=\"1-1-1-1-2-1-4-5-1\" data-name=\"kitchen index\">\n                                    04\n                                </span>\n                                <span class=\"font-utility text-[10px] uppercase tracking-[0.08em]\" data-kid=\"1-1-1-1-2-1-4-5-2\" data-name=\"kitchen text\">\n                                    Kitchen & wardrobes\n                                </span>\n                                <span class=\"font-technical text-[9px] text-right\" data-kid=\"1-1-1-1-2-1-4-5-3\" data-name=\"kitchen count\">\n                                    6\n                                </span>\n                            </a>\n                            <a class=\"rail-row focus-ring grid min-h-[42px] grid-cols-[27px_1fr_22px] items-center border-b border-wh