iew\" class=\"relative h-[780px] w-[390px] overflow-hidden border border-white/[0.20] bg-[#090909]\" data-kid=\"1-4-1-2\">\n                <!-- Underlying mobile collection page remains visible at the top edge -->\n                <div class=\"absolute inset-0 bg-[#090909]\" data-kid=\"1-4-1-2-1\">\n                    <div class=\"flex h-[58px] items-center justify-between border-b border-white/[0.12] px-5\" data-kid=\"1-4-1-2-1-1\">\n                        <span class=\"flex items-center gap-2 font-['Cormorant_Garamond'] text-[20px]\" data-kid=\"1-4-1-2-1-1-1\" style=\"font-family:'Cormorant Garamond', serif;\">\n                            <span class=\"flex h-6 w-6 items-center justify-center border border-[#c8a96e]/50 text-[12px] text-[#c8a96e]\" data-kid=\"1-4-1-2-1-1-1-1\">\n                                HC\n                            </span>\n                            Hardware Collection\n                        </span>\n                        <span class=\"flex h-9 w-9 items-center justify-center border border-white/[0.18] text-[#aaa49a]\" data-kid=\"1-4-1-2-1-1-2\">\n                            <i aria-hidden=\"true\" class=\"ti ti-menu-2 text-[17px]\" data-kid=\"1-4-1-2-1-1-2-1\" style=\"width:17px;height:17px;color:#aaa49a\">\n                            </i>\n                        </span>\n                    </div>\n                    <div class=\"px-5 py-8\" data-kid=\"1-4-1-2-1-2\">\n                        <p class=\"font-mono text-[9px] uppercase tracking-[0.16em] text-[#c8a96e]\" data-kid=\"1-4-1-2-1-2-1\">\n                            The collection\n                        </p>\n                        <h3 class=\"mt-3 font-['Cormorant_Garamond'] text-[40px] uppercase leading-none\" data-kid=\"1-4-1-2-1-2-2\" style=\"font-family:'Cormorant Garamond', serif;\">\n                            Door hardware\n                        </h3>\n                        <button class=\"hc-focus mt-6 flex min-h-[56px] w-full items-center justify-be