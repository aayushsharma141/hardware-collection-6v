      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DM+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .hc-editorial { font-family: 'Cormorant Garamond', Georgia, serif; }\n  .hc-ui { font-family: 'DM Sans', Arial, sans-serif; }\n  .hc-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }\n  .hc-rule-sweep { transition: transform 320ms cubic-bezier(.22,1,.36,1); }\n  .hc-cta:hover .hc-rule-sweep { transform: translateX(12px); }\n  .hc-stage::after { content: ''; position: absolute; left: 0; right: 0; top: 43%; height: 1px; background: rgba(232,227,217,.08); pointer-events: none; }\n  .hc-stage::before { content: ''; position: absolute; left: 12%; right: 12%; bottom: 15%; height: 22%; background: linear-gradient(90deg, transparent, rgba(200,169,110,.16), transparent); opacity: .7; pointer-events: none; }\n  .hc-family:hover .hc-family-image, .hc-family:focus-within .hc-family-image { filter: contrast(1.08); }\n  .hc-family:hover .hc-family-rule, .hc-family:focus-within .hc-family-rule { background: #c8a96e; }\n  .hc-family:hover .hc-family-arrow, .hc-family:focus-within .hc-family-arrow { transform: translateX(6px); color: #c8a96e; }\n  .hc-family-arrow { transition: transform 240ms cubic-bezier(.22,1,.36,1), color 240ms ease; }\n  .hc-family-image { transition: filter 240ms ease; }\n  .hc-mobile-row:hover, .hc-mobile-row:focus-within { background: #181716; }\n  .hc-mobile-row:hover .hc-mobile-arrow, .hc-mobile-row:focus-within .hc-mobile-arrow { transform: translateX(6px); color: #c8a96e; }\n  .hc-mobile-arrow { transition: transform 240ms cubic-bezier(.22,1,.36,1), color 240ms ease; }\n  .hc-focus:focus-visible { outline: 2px solid #c8a96e; outline-offset: 3px; }\n</style>\n<div class=\"min-h-screen bg-[#090909] text-[#e8e3d9] hc-ui selection:bg-[#c8a96e] selection:text-[#090909]\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- DESKTOP / INSPECTION BENCH -->\n    <div class=\"hidden lg:block\" data-kid=\"1-1\" data-name=\"desktop site section\">\n        <header class=\"mx-auto max-w-[1280px] border-x border-b border-[#e8e3d9]/10 bg-[#090909]/95\" data-kid=\"1-1-1\" data-name=\"main site header\">\n            <nav aria-label=\"Architectural rail navigation\" class=\"grid grid-cols-[1.3fr_1fr_1.25fr] items-stretch min-h-[68px]\" data-kid=\"1-1-1-1\" data-name=\"architectural rail navigation\">\n                <a class=\"hc-focus flex items-center gap-3 border-r border-[#e8e3d9]/10 px-8 text-[#e8e3d9] no-underline\" data-kid=\"1-1-1-1-1\" data-name=\"company identity link\" href=\"#hero\">\n                    <span class=\"flex h-8 w-8 items-center justify-center border border-[#c8a96e]/70 text-[12px] font-semibold tracking-[-.08em] text-[#c8a96e]\" data-kid=\"1-1-1-1-1-1\" data-name=\"company logo monogram\">\n                        HC\n                    </span>\n                    <span class=\"hc-editorial text-[23px] tracking-[.05em]\" data-kid=\"1-1-1-1-1-2\" data-name=\"company name text\">\n                        Hardware Collection\n                    </span>\n                </a>\n                <div class=\"flex items-center justify-center gap-10 border-r border-[#e8e3d9]/10 px-6\" data-kid=\"1-1-1-1-2\" data-name=\"navigation menu links container\">\n                    <a class=\"hc-focus relative flex min-h-[44px] items-center text-[10px] font-semibold uppercase tracking-[.22em] text-[#e8e3d9] no-underline\" data-kid=\"1-1-1-1-2-1\" data-name=\"home navigation link\" href=\"#hero\">\n                        Home\n                        <span class=\"absolute bottom-0 left-0 right-0 h-px bg-[#c8a96e]\" data-kid=\"1-1-1-1-2-1-1\" data-name=\"active menu indicator bar\">\n                        </span>\n                    </a>\n                    <a class=\"hc-focus flex min-h-[44px] items-center text-[10px] font-semibold uppercase tracking-[.22em] text-[#aaa49a] no-underline hover:text-[#e8e3d9]\" data-kid=\"1-1-1-1-2-2\" data-name=\"collections navigation link\" href=\"#families\">\n                        Collections\n                    </a>\n                </div>\n                <div class=\"grid grid-cols-[1fr_auto] items-center\" data-kid=\"1-1-1-1-3\" data-name=\"header utility actions container\">\n                    <a class=\"hc-focus flex min-h-[44px] items-center justify-center gap-2 border-r border-[#e8e3d9]/10 px-5 text-[10px] font-semibold tracking-[.08em] text-[#aaa49a] no-underline hover:text-[#e8e3d9]\" data-kid=\"1-1-1-1-3-1\" data-name=\"phone contact link\" href=\"tel:+919835190738\">\n                        <i aria-hidden=\"true\" class=\"ti ti-phone text-[13px] text-[#c8a96e]\" data-kid=\"1-1-1-1-3-1-1\" data-name=\"phone icon\">\n                        </i>\n                        +91 98351 90738\n                    </a>\n                    <a class=\"hc-focus hc-cta flex min-h-[44px] items-center gap-3 px-7 text-[10px] font-bold uppercase tracking-[.2em] text-[#090909] no-underline\" data-kid=\"1-1-1-1-3-2\" data-name=\"inquire call-to-action button\" href=\"#consult\" style=\"background:#c8a96e\">\n                        <span data-kid=\"1-1-1-1-3-2-1\" data-name=\"inquire button text\">\n                            Inquire\n                        </span>\n                        <span class=\"relative flex items-center\" data-kid=\"1-1-1-1-3-2-2\" data-name=\"button arrow container\">\n                            <span class=\"hc-rule-sweep absolute -left-2 top-1/2 h-px w-3 bg-[#090909]\" data-kid=\"1-1-1-1-3-2-2-1\" data-name=\"button transition rule sweep\">\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-[15px]\" data-kid=\"1-1-1-1-3-2-2-2\" data-name=\"arrow-up-right icon\">\n                            </i>\n                        </span>\n                    </a>\n                </div>\n            </nav>\n        </header>\n        <main data-kid=\"1-1-2\" data-name=\"site content area\">\n            <section class=\"relative mx-auto max-w-[1280px] border-x border-b border-[#e8e3d9]/10 overflow-hidden\" data-kid=\"1-1-2-1\" data-name=\"hero section\" id=\"hero\" style=\"min-height:650px\">\n                <div aria-hidden=\"true\" class=\"absolute inset-0\" data-kid=\"1-1-2-1-1\" data-name=\"hero background wrapper\">\n                    <img alt=\"Architectural showroom environment\" class=\"h-full w-full object-cover opacity-40\" data-kid=\"1-1-2-1-1-1\" data-name=\"hero main background image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/cinema/hero/HC-01-HERO-01.png\"/>\n                    <div class=\"absolute inset-0\" data-kid=\"1-1-2-1-1-2\" data-name=\"hero background gradient overlay\" style=\"background:linear-gradient(90deg,rgba(9,9,9,.96) 0%,rgba(9,9,9,.82) 40%,rgba(9,9,9,.38) 72%,rgba(9,9,9,.78) 100%)\">\n                    </div>\n                </div>\n                <div class=\"relative grid min-h-[650px] grid-cols-12\" data-kid=\"1-1-2-1-2\" data-name=\"hero content grid\">\n                    <div class=\"col-span-5 flex flex-col justify-end border-r border-[#c8a96e]/80 px-16 pb-16 pt-32\" data-kid=\"1-1-2-1-2-1\" data-name=\"hero text content area\">\n                        <div class=\"max-w-[500px]\" data-kid=\"1-1-2-1-2-1-1\" data-name=\"hero intro text content\">\n                            <p class=\"hc-mono mb-8 flex items-center gap-3 text-[10px] uppercase tracking-[.22em] text-[#c8a96e]\" data-kid=\"1-1-2-1-2-1-1-1\" data-name=\"authorized showroom status label\">\n                                <span class=\"h-1 w-1 bg-[#c8a96e]\" data-kid=\"1-1-2-1-2-1-1-1-1\" data-name=\"status bullet point\">\n                                </span>\n                                Authorized showroom · Sakchi · Jamshedpur\n                            </p>\n                            <div class=\"mb-5 flex items-center gap-4\" data-kid=\"1-1-2-1-2-1-1-2\" data-name=\"selection study header\">\n                                <span class=\"h-px w-10 bg-[#c8a96e]\" data-kid=\"1-1-2-1-2-1-1-2-1\" data-name=\"header horizontal line\">\n                                </span>\n                                <span class=\"hc-mono text-[10px] uppercase tracking-[.2em] text-[#aaa49a]\" data-kid=\"1-1-2-1-2-1-1-2-2\" data-name=\"study label text\">\n                                    Selected hardware / finish study\n                                </span>\n                            </div>\n                            <h1 class=\"hc-editorial max-w-[560px] text-[78px] font-normal leading-[.86] tracking-[-.02em] text-[#e8e3d9]\" data-kid=\"1-1-2-1-2-1-1-3\" data-name=\"hero headline\">\n                                The Art of\n                                <br data-kid=\"1-1-2-1-2-1-1-3-1\" data-name=\"headline line break\"/>\n                                the Finish.\n                            </h1>\n                            <p class=\"mt-7 max-w-[39ch] text-[15px] leading-7 text-[#aaa49a]\" data-kid=\"1-1-2-1-2-1-1-4\" data-name=\"hero description text\">\n                                Architectural hardware chosen for spaces that deserve better details. Official partner for Häfele, Dorset, Labacha, Godrej & Hettich in Sakchi.\n                            </p>\n                            <div class=\"mt-9 flex flex-wrap items-center gap-6\" data-kid=\"1-1-2-1-2-1-1-5\" data-name=\"hero actions container\">\n                                <a class=\"hc-focus hc-cta relative inline-flex min-h-[52px] items-center gap-5 border border-[#090909] px-6 text-[11px] font-bold uppercase tracking-[.18em] text-[#090909] no-underline\" data-kid=\"1-1-2-1-2-1-1-5-1\" data-name=\"explore collections button\" href=\"#families\" style=\"background:#c8a96e;box-shadow:inset 0 0 0 1px rgba(232,227,217,.32)\">\n                                    <span data-kid=\"1-1-2-1-2-1-1-5-1-1\" data-name=\"button text\">\n                                        Explore collections\n                                    </span>\n                                    <span class=\"relative flex items-center\" data-kid=\"1-1-2-1-2-1-1-5-1-2\" data-name=\"button arrow container\">\n                                        <span class=\"hc-rule-sweep absolute -left-2 top-1/2 h-px w-3 bg-[#090909]\" data-kid=\"1-1-2-1-2-1-1-5-1-2-1\" data-name=\"button transition rule sweep\">\n                                        </span>\n                                        <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-[16px]\" data-kid=\"1-1-2-1-2-1-1-5-1-2-2\" data-name=\"arrow-up-right icon\">\n                                        </i>\n                                    </span>\n                                </a>\n                                <a class=\"hc-focus text-[11px] font-semibold uppercase tracking-[.16em] text-[#e8e3d9] underline decoration-[#c8a96e] decoration-1 underline-offset-8 hover:text-[#c8a96e]\" data-kid=\"1-1-2-1-2-1-1-5-2\" data-name=\"showroom visit link\" href=\"#showroom\">\n                                    Visit the Sakchi showroom\n                                </a>\n                            </div>\n                            <div class=\"mt-12 border-t border-[#e8e3d9]/10 pt-4\" data-kid=\"1-1-2-1-2-1-1-6\" data-name=\"alternate hero slides controls\">\n                                <p class=\"hc-mono mb-3 text-[9px] uppercase tracking-[.2em] text-[#6e6a62]\" data-kid=\"1-1-2-1-2-1-1-6-1\" data-name=\"controls instruction label\">\n                                    Alternate slide / explicit selection\n                                </p>\n                                <div class=\"grid grid-cols-2 gap-5\" data-kid=\"1-1-2-1-2-1-1-6-2\" data-name=\"slides control buttons\">\n                                    <button class=\"hc-focus border-b-2 