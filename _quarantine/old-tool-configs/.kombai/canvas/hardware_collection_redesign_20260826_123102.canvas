   </a>\n                        <a class=\"hc-directory-row hc-focus\" data-kid=\"1-2-3-2-1-4-4\" data-name=\"bath directory row\" href=\"#collections-bathroom\">\n                            <img alt=\"Bathroom family\" data-kid=\"1-2-3-2-1-4-4-1\" data-name=\"bath directory image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/cinema/categories/HC-03-BATHROOM.png\"/>\n                            <span class=\"hc-directory-number\" data-kid=\"1-2-3-2-1-4-4-2\" data-name=\"bath directory number\">\n                                03\n                            </span>\n                            <span class=\"hc-directory-info\" data-kid=\"1-2-3-2-1-4-4-3\" data-name=\"bath directory info\">\n                                <strong data-kid=\"1-2-3-2-1-4-4-3-1\" data-name=\"bath title\">\n                                    Bathroom\n                                </strong>\n                                <span data-kid=\"1-2-3-2-1-4-4-3-2\" data-name=\"bath description\">\n                                    Shower suites and stainless fixtures.\n                                </span>\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right hc-directory-arrow\" data-kid=\"1-2-3-2-1-4-4-4\" data-name=\"arrow-up-right icon\">\n                            </i>\n                        </a>\n                        <a class=\"hc-directory-row hc-focus\" data-kid=\"1-2-3-2-1-4-5\" data-name=\"kitchen directory row\" href=\"#collections-kitchen\">\n                            <img alt=\"Kitchen and wardrobes family\" data-kid=\"1-2-3-2-1-4-5-1\" data-name=\"kitchen directory image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/cinema/categories/HC-03-KITCHEN.png\"/>\n                            <span class=\"hc-directory-number\" data-kid=\"1-2-3-2-1-4-5-2\" data-name=\"kitchen directory number\">\n                                04\n                            