      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  @keyframes rule-draw {\n    from { transform: scaleX(0); transform-origin: left; }\n    to { transform: scaleX(1); transform-origin: left; }\n  }\n  @keyframes reflection-pass {\n    from { transform: translateX(-14%); opacity: .12; }\n    50% { opacity: .36; }\n    to { transform: translateX(14%); opacity: .12; }\n  }\n  @keyframes drawer-rise {\n    from { transform: translateY(18px); opacity: .4; }\n    to { transform: translateY(0); opacity: 1; }\n  }\n  .hc-rail-row { position: relative; }\n  .hc-rail-row::after { content: ''; position: absolute; left: 0; right: -44px; bottom: 0; height: 1px; background: #c8a96e; transform: scaleX(0); transform-origin: left; transition: transform 220ms cubic-bezier(.22,1,.36,1); }\n  .hc-rail-row:hover::after, .hc-rail-row[data-active='true']::after { transform: scaleX(1); }\n  .hc-rail-row:hover .hc-rail-label, .hc-rail-row[data-active='true'] .hc-rail-label { color: #e8e3d9; }\n  .hc-index-branch { position: relative; }\n  .hc-index-branch::before { content: ''; position: absolute; left: 0; top: 0; bottom: 10px; width: 1px; background: rgba(232,227,217,.18); }\n  .hc-index-branch button::before { content: ''; display: block; width: 12px; height: 1px; background: rgba(232,227,217,.24); margin-right: 8px; flex: 0 0 auto; }\n  .hc-shelf-item { position: relative; }\n  .hc-shelf-item::before { content: ''; position: absolute; left: 0; right: 0; top: -10px; height: 1px; background: rgba(232,227,217,.1); transition: background 220ms cubic-bezier(.22,1,.36,1); }\n  .hc-shelf-item:hover::before, .hc-shelf-item:focus-within::before { background: #c8a96e; }\n  .hc-shelf-item:hover .hc-spec-arrow, .hc-shelf-item:focus-within .hc-spec-arrow { transform: translateX(6px); }\n  .hc-specimen-stage { position: relative; overflow: hidden; background: #181716; }\n  .hc-specimen-stage::before { content: ''; position: absolute; inset: 8px; border: 1px solid rgba(232,227,217,.13); pointer-events: none; z-index: 2; transition: border-color 220ms cubic-bezier(.22,1,.36,1); }\n  .hc-specimen-stage::after { content: ''; position: absolute; left: 18%; right: 18%; bottom: 12%; height: 20%; background: linear-gradient(90deg, transparent, rgba(200,169,110,.22), transparent); opacity: .55; transform: translateX(-10%); transition: transform 220ms cubic-bezier(.22,1,.36,1), opacity 220ms cubic-bezier(.22,1,.36,1); pointer-events: none; z-index: 3; }\n  .hc-shelf-item:hover .hc-specimen-stage::before, .hc-shelf-item:focus-within .hc-specimen-stage::before { border-color: rgba(200,169,110,.55); }\n  .hc-shelf-item:hover .hc-specimen-stage::after, .hc-shelf-item:focus-within .hc-specimen-stage::after { transform: translateX(10%); opacity: .92; }\n  .hc-image { filter: saturate(.78) contrast(1.04); transition: filter 220ms cubic-bezier(.22,1,.36,1); }\n  .hc-shelf-item:hover .hc-image, .hc-shelf-item:focus-within .hc-image { filter: saturate(.95) contrast(1.1); }\n  .hc-brass-action { position: relative; overflow: hidden; }\n  .hc-brass-action::after { content: ''; position: absolute; left: 12px; right: 42px; bottom: 7px; height: 1px; background: rgba(9,9,9,.72); transform: scaleX(.28); transform-origin: left; transition: transform 220ms cubic-bezier(.22,1,.36,1); }\n  .hc-brass-action:hover::after, .hc-brass-action:focus-visible::after { transform: scaleX(1); }\n  .hc-mobile-drawer { animation: drawer-rise 420ms cubic-bezier(.22,1,.36,1) both; }\n  .hc-mobile-row { position: relative; min-height: 60px; }\n  .hc-mobile-row[data-active='true']::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: #c8a96e; }\n  .hc-focus:focus-visible { outline: 2px solid #c8a96e; outline-offset: 3px; }\n</style>\n<div class=\"min-h-screen bg-[#090909] text-[#e8e3d9] font-['DM_Sans']\" data-kid=\"1\" style=\"font-family:'DM Sans', sans-serif;\">\n    <!-- Rectilinear navigation rail -->\n    <header class=\"border-b border-white/[0.10] bg-[#090909]\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex h-[72px] max-w-[1440px] items-stretch border-x border-white/[0.06] px-12\" data-kid=\"1-1-1\">\n            <a class=\"hc-focus flex min-w-[248px] items-center gap-3 border-r border-white/[0.10] pr-8 text-[#e8e3d9] no-underline\" data-kid=\"1-1-1-1\" href=\"#collection\">\n                <span class=\"flex h-9 w-9 items-center justify-center border border-[#c8a96e]/55 text-[#c8a96e] font-['Cormorant_Garamond'] text-xl\" data-kid=\"1-1-1-1-1\" style=\"font-family:'Cormorant Garamond', serif;\">\n                    HC\n                </span>\n                <span class=\"font-['Cormorant_Garamond'] text-[23px] tracking-[0.04em]\" data-kid=\"1-1-1-1-2\" style=\"font-family:'Cormorant Garamond', serif;\">\n                    Hardware Collection\n                </span>\n            </a>\n            <nav class=\"flex flex-1 items-center justify-center gap-10 px-10 text-[10px] font-semibold uppercase tracking-[0.22em] text-[#aaa49a]\" data-kid=\"1-1-1-2\">\n                <a class=\"hc-focus border-b border-transparent py-3 hover:border-[#c8a96e] hover:text-[#e8e3d9]\" data-kid=\"1-1-1-2-1\" href=\"#home\">\n                    Home\n                </a>\n                <a class=\"hc-focus border-b border-[#c8a96e] py-3 text-[#e8e3d9]\" data-kid=\"1-1-1-2-2\" href=\"#collection\">\n                    Collections\n                </a>\n                <a class=\"hc-focus border-b border-transparent py-3 hover:border-[#c8a96e] hover:text-[#e8e3d9]\" data-kid=\"1-1-1-2-3\" href=\"#showroom\">\n                    Showroom\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-0 border-l border-white/[0.10] pl-6 text-[10px] uppercase tracking-[0.16em]\" data-kid=\"1-1-1-3\">\n                <a class=\"hc-focus flex h-full items-center border-r border-white/[0.10] px-5 text-[#aaa49a] hover:text-[#e8e3d9]\" data-kid=\"1-1-1-3-1\" href=\"tel:+919835190738\">\n                    +91 98351 90738\n                </a>\n                <a class=\"hc-focus hc-brass-action flex h-10 items-center gap-3 self-center bg-[#c8a96e] px-5 font-bold text-[#090909]\" data-kid=\"1-1-1-3-2\" href=\"#consult\">\n                    Inquire\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right inline-flex h-4 w-4 items-center justify-center text-[16px]\" data-kid=\"1-1-1-3-2-1\" style=\"width:16px;height:16px;color:#090909\">\n                    </i>\n                </a>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1440px]\" data-kid=\"1-2\" id=\"collection\">\n        <!-- Catalogue masthead: same grid as directory + gallery -->\n        <section class=\"grid min-h-[190px] grid-cols-[260px_1fr] gap-12 border-x border-b border-white/[0.10] px-12 py-10\" data-kid=\"1-2-1\">\n            <div class=\"flex flex-col justify-between border-r border-white/[0.10] pr-8\" data-kid=\"1-2-1-1\">\n                <span class=\"flex items-center gap-3 font-mono text-[10px] uppercase tracking-[0.2em] text-[#c8a96e]\" data-kid=\"1-2-1-1-1\">\n                    <span class=\"h-1 w-1 bg-[#c8a96e]\" data-kid=\"1-2-1-1-1-1\">\n                    </span>\n                    Authorized showroom\n                </span>\n                <h1 class=\"font-['Cormorant_Garamond'] text-[58px] font-normal uppercase leading-[.82] tracking-[0.04em] text-[#e8e3d9]\" data-kid=\"1-2-1-1-2\" style=\"font-family:'Cormorant Garamond', serif;\">\n                    The\n                    <br data-kid=\"1-2-1-1-2-1\"/>\n                    Collection\n                </h1>\n            </div>\n            <div class=\"flex flex-col justify-between\" data-kid=\"1-2-1-2\">\n                <p class=\"max-w-[42ch] text-[14px] leading-6 text-[#aaa49a]\" data-kid=\"1-2-1-2-1\">\n                    Curated architectural hardware for considered residential and commercial interiors. Authorized partner for Hafele, Dorset, Labacha, Godrej, Hettich & Kich.\n                </p>\n                <div class=\"flex items-end justify-between border-t border-[#c8a96e]/65 pt-3 font-mono text-[10px] uppercase tracking-[0.18em] text-[#aaa49a]\" data-kid=\"1-2-1-2-2\">\n                    <span data-kid=\"1-2-1-2-2-1\">\n                        Specification catalogue / 2026\n                    </span>\n                    <span class=\"text-[#c8a96e]\" data-kid=\"1-2-1-2-2-2\">\n                        Sakchi · Jamshedpur\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section class=\"grid grid-cols-[260px_1fr] gap-12 border-x border-white/[0.06] px-12 py-10\" data-kid=\"1-2-2\">\n            <!-- Fixed showroom directory / plan legend -->\n            <aside aria-label=\"Showroom directory\" class=\"sticky top-6 self-start border-r border-white/[0.14] pr-8\" data-kid=\"1-2-2-1\">\n                <div class=\"mb-7 flex items-center justify-between border-b border-white/[0.10] pb-4\" data-kid=\"1-2-2-1-1\">\n                    <span class=\"font-mono text-[10px] uppercase tracking-[0.18em] text-[#c8a96e]\" data-kid=\"1-2-2-1-1-1\">\n                        Collection index\n                    </span>\n                    <span class=\"font-mono text-[10px] text-[#aaa49a]\" data-kid=\"1-2-2-1-1-2\">\n                        07 total\n                    </span>\n                </div>\n                <button class=\"hc-focus mb-6 flex min-h-[44px] w-full items-center justify-between border-b border-[#c8a96e] pb-3 text-left text-[11px] font-semibold uppercase tracking-[0.15em] text-[#e8e3d9]\" data-kid=\"1-2-2-1-2\">\n                    <span data-kid=\"1-2-2-1-2-1\">\n                        All collections\n                    </span>\