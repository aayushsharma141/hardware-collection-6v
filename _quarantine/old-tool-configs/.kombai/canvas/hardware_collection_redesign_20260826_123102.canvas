=\"ti ti-chevron-down text-[15px]\" data-kid=\"1-4-1-2-3-2-2-6-4\" data-name=\"chevron down icon\" style=\"width:15px;height:15px;color:#aaa49a\">\n                                </i>\n                            </button>\n                            <button class=\"hc-focus hc-mobile-row flex w-full items-center gap-3 border-b border-white/[0.08] px-3 text-left\" data-kid=\"1-4-1-2-3-2-2-7\" data-name=\"mobile showroom family row\">\n                                <span class=\"w-6 font-mono text-[10px] text-[#c8a96e]\" data-kid=\"1-4-1-2-3-2-2-7-1\">\n                                    05\n                                </span>\n                                <span class=\"flex-1 text-[12px] uppercase tracking-[0.1em] text-[#aaa49a]\" data-kid=\"1-4-1-2-3-2-2-7-2\">\n                                    Furniture hardware\n                                </span>\n                                <span class=\"font-mono text-[10px] text-[#aaa49a]\" data-kid=\"1-4-1-2-3-2-2-7-3\">\n                                    02\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-chevron-down text-[15px]\" data-kid=\"1-4-1-2-3-2-2-7-4\" data-name=\"chevron down icon\" style=\"width:15px;height:15px;color:#aaa49a\">\n                                </i>\n                            </button>\n                        </div>\n                        <div class=\"mt-7\" data-kid=\"1-4-1-2-3-2-3\">\n                            <p class=\"mb-2 font-mono text-[9px] uppercase tracking-[0.18em] text-[#aaa49a]\" data-kid=\"1-4-1-2-3-2-3-1\">\n                                Brands\n                            </p>\n                            <div class=\"space-y-0\" data-kid=\"1-4-1-2-3-2-3-2\">\n                                <button class=\"hc-focus flex min-h-[52px] w-full items-center gap-3 border-b border-white/[0.08] text-left text-[12px] text-[#e8e3e9]\" data-kid=\"1-4-1-2-3-2-3-2-1\">\n                                    <span class=\"flex h-4 w-4 items-center justify-center border border-[#c8a96e] bg-[#c8a96e]\" data-kid=\"1-4-1-2-3-2-3-2-1-1\">\n                                        <i aria-hidden=\"true\" class=\"ti ti-check text-[11px]\" data-kid=\"1-4-1-2-3-2-3-2-1-1-1\" style=\"width:12px;height:12px;color:#090909\">\n                                        </i>\n                                    </span>\n                                    <span class=\"flex-1\" data-kid=\"1-4-1-2-3-2-3-2-1-2\">\n                                        All authorized brands\n                                    </span>\n                                    <span class=\"font-mono text-[9px] text-[#aaa49a]\" data-kid=\"1-4-1-2-3-2-3-2-1-3\">\n                                        07\n                                    </span>\n                                </button>\n                                <button class=\"hc-focus flex min-h-[52px] w-full items-center gap-3 border-b border-white/[0.08] text-left text-[12px] text-[#aaa49a]\" data-kid=\"1-4-1-2-3-2-3-2-2\">\n                                    <span class=\"h-4 w-4 border border-white/[0.28]\" data-kid=\"1-4-1-2-3-2-3-2-2-1\">\n                                    </span>\n                                    <span class=\"flex-1\" data-kid=\"1-4-1-2-3-2-3-2-2-2\">\n                                        Hafele\n                                    </span>\n                                </button>\n                                <button class=\"hc-focus flex min-h-[52px] w-full items-center gap-3 border-b border-white/[0.08] text-left text-[12px] text-[#aaa49a]\" data-kid=\"1-4-1-2-3-2-3-2-3\">\n                                    <span class=\"h-4 w-4 border border-white/[0.28]\" data-kid=\"1-4-1-2-3-2-3-2-3-1\">\n                                    </span>\n                                    <span class=\"flex-1\" data-kid=\"1-4-1-2-3-2-3-2-3-2\">\n                                        Dorset\n                                    </span>\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"absolute bottom-0 left-0 right-0 flex h-[76px] items-center gap-3 border-t border-white/[0.14] bg-[#11100f] px-5\" data-kid=\"1-4-1-2-3-3\" data-name=\"mobile drawer bottom action bar\">\n                        <button class=\"hc-focus min-h-[44px] flex-1 border-b border-[#c8a96e] text-left text-[11px] font-semibold uppercase tracking-[0.16em] text-[#c8a96e]\" data-kid=\"1-4-1-2-3-3-1\">\n                            Reset\n                        </button>\n                        <button class=\"hc-focus hc-brass-action flex min-h-[48px] flex-[2] items-center justify-center gap-2 bg-[#c8a96e] text-[11px] font-bold uppercase tracking-[0.16em] text-[#090909]\" data-kid=\"1-4-1-2-3-3-2\">\n                            Show results\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-right text-[16px]\" data-kid=\"1-4-1-2-3-3-2-1\" style=\"width:16px;height:16px;color:#090909\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n</div>\n",
