      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DM+Sans:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n.hc-shell{min-height:100%;background:#090909;color:#e8e3d9;font-family:'DM Sans',sans-serif;overflow:hidden;}\n.hc-serif{font-family:'Cormorant Garamond',Georgia,serif;}\n.hc-mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;}\n.hc-rule{height:1px;background:#e8e3d9;opacity:.16;}\n.hc-brass-rule{height:1px;background:#c8a96e;opacity:.78;}\n.hc-focus:focus-visible{outline:2px solid #c8a96e;outline-offset:3px;}\n.hc-rail{height:74px;border:1px solid rgba(232,227,217,.2);background:rgba(9,9,9,.92);display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 30px;position:absolute;z-index:20;left:5.5%;right:5.5%;top:22px;}\n.hc-brand{display:flex;align-items:center;gap:12px;letter-spacing:.08em;font-size:13px;font-weight:600;}\n.hc-mark{width:30px;height:30px;border:1px solid rgba(200,169,110,.7);display:grid;place-items:center;color:#c8a96e;font-family:'Cormorant Garamond',serif;font-size:18px;line-height:1;}\n.hc-nav{display:flex;align-items:center;gap:30px;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#aaa49a;}\n.hc-nav a{height:42px;display:flex;align-items:center;position:relative;}\n.hc-nav a:first-child{color:#e8e3d9;}\n.hc-nav a:first-child:after{content:'';position:absolute;bottom:4px;left:0;width:18px;height:2px;background:#c8a96e;}\n.hc-rail-actions{justify-self:end;display:flex;align-items:center;gap:18px;font-size:10px;letter-spacing:.12em;text-transform:uppercase;}\n.hc-phone{color:#aaa49a;padding-right:18px;border-right:1px solid rgba(232,227,217,.16);}\n.hc-rail-cta{height:40px;padding:0 18px;border:1px solid #c8a96e;color:#090909;background:#c8a96e;display:inline-flex;align-items:center;gap:9px;font-weight:700;}\n.hc-icon{font-size:15px;line-height:1;display:inline-block;width:15px;height:15px;}\n.hc-hero{height:765px;position:relative;isolation:isolate;border-bottom:1px solid rgba(232,227,217,.16);}\n.hc-hero-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.56) saturate(.72);}\n.hc-hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(9,9,9,.93) 0%,rgba(9,9,9,.68) 35%,rgba(9,9,9,.18) 61%,rgba(9,9,9,.76) 100%);z-index:1;}\n.hc-bay-overlay{position:absolute;top:0;bottom:0;background:#090909;opacity:.22;z-index:3;pointer-events:none;transition:opacity 280ms cubic-bezier(.22,1,.36,1);}\n.hc-bay-overlay:hover{opacity:.08;}\n.hc-structure-line{position:absolute;top:0;bottom:0;width:1px;background:#e8e3d9;opacity:.19;z-index:5;pointer-events:none;}\n.hc-structure-line.brass{background:#c8a96e;opacity:.64;width:2px;}\n.hc-hero-copy{position:absolute;left:8%;bottom:112px;z-index:8;width:43%;max-width:570px;}\n.hc-eyebrow{font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:#c8a96e;margin:0 0 22px;}\n.hc-hero-title{font-size:clamp(68px,7.4vw,122px);line-height:.82;font-weight:400;letter-spacing:-.035em;color:#e8e3d9;margin:0 0 28px;max-width:650px;}\n.hc-hero-title em{font-style:normal;color:#e8e3d9;display:block;margin-left:9.5vw;}\n.hc-hero-description{font-size:14px;line-height:1.75;color:#aaa49a;max-width:390px;margin:0 0 28px;}\n.hc-plate{min-height:52px;padding:0 18px 0 19px;background:#c8a96e;color:#090909;border:1px solid #c8a96e;box-shadow:inset 0 0 0 1px #090909;display:inline-flex;align-items:center;gap:32px;text-transform:uppercase;letter-spacing:.16em;font-size:10px;font-weight:700;}\n.hc-plate-rule{width:24px;height:1px;background:#090909;display:block;transition:transform 240ms cubic-bezier(.22,1,.36,1);}\n.hc-plate:hover .hc-plate-rule{transform:translateX(12px);}\n.hc-quiet-link{margin-left:25px;color:#e8e3d9;text-transform:uppercase;letter-spacing:.16em;font-size:10px;border-bottom:1px solid #aaa49a;padding-bottom:5px;}\n.hc-product-bay{position:absolute;left:51.5%;top:122px;bottom:82px;width:17%;z-index:6;border-left:1px solid rgba(232,227,217,.17);border-right:1px solid rgba(232,227,217,.17);background:rgba(9,9,9,.42);display:flex;align-items:center;justify-content:center;overflow:hidden;}\n.hc-product-bay img{width:174%;height:74%;object-fit:cover;opacity:.92;mix-blend-mode:screen;filter:contrast(1.08) saturate(.76);}\n.hc-product-bay:before{content:'PRODUCT SPECIMEN / 01';position:absolute;left:15px;top:16px;color:#aaa49a;font:9px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.16em;writing-mode:vertical-rl;transform:rotate(180deg);z-index:2;opacity:.78;}\n.hc-product-bay:after{content:'';position:absolute;left:10%;right:10%;bottom:20%;height:1px;background:linear-gradient(90deg,transparent,#c8a96e,transparent);opacity:.4;}\n.hc-macro-bay{position:absolute;right:0;top:0;bottom:0;width:21%;z-index:4;overflow:hidden;border-left:1px solid rgba(232,227,217,.2);}\n.hc-macro-bay img{width:100%;height:100%;object-fit:cover;opacity:.78;filter:brightness(.58) saturate(.72);}\n.hc-macro-bay:after{content:'MACRO / FINISH STUDY';position:absolute;right:18px;top:145px;color:#e8e3d9;font:9px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.2em;writing-mode:vertical-rl;opacity:.7;}\n.hc-sweep{position:absolute;top:-10%;bottom:-10%;left:-18%;width:20%;background:linear-gradient(90deg,transparent,rgba(232,227,217,.2),transparent);transform:skewX(-18deg) translateX(-130%);opacity:0;pointer-events:none;}\n.hc-product-bay:hover .hc-sweep{animation:hc-sweep .85s cubic-bezier(.22,1,.36,1) forwards;}\n@keyframes hc-sweep{0%{transform:skewX(-18deg) translateX(-130%);opacity:0}18%{opacity:.7}100%{transform:skewX(-18deg) translateX(760%);opacity:0}}\n.hc-threshold{position:absolute;left:8%;right:8%;bottom:27px;height:31px;border-top:1px solid rgba(232,227,217,.34);z-index:8;display:flex;align-items:flex-end;justify-content:space-between;padding-top:9px;font:9px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.16em;text-transform:uppercase;color:#aaa49a;}\n.hc-threshold strong{color:#c8a96e;font-weight:500;}\n.hc-threshold-route{color:#e8e3d9;text-decoration:underline;text-decoration-color:#c8a96e;text-underline-offset:5px;}\n.hc-section{background:#11100f;padding:86px 8% 98px;position:relative;}\n.hc-section-head{display:flex;justify-content:space-between;align-items:flex-end;gap:50px;border-bottom:1px solid rgba(232,227,217,.2);padding-bottom:22px;margin-bottom:28px;}\n.hc-section-kicker{font:10px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.2em;text-transform:uppercase;color:#c8a96e;margin:0 0 11px;}\n.hc-section-title{font-size:48px;line-height:.94;font-weight:400;letter-spacing:-.015em;color:#e8e3d9;margin:0;}\n.hc-section-note{font-size:12px;line-height:1.6;color:#aaa49a;max-width:340px;margin:0 0 2px;}\n.hc-elevation{display:grid;grid-template-columns:1.05fr 1.9fr .88fr 1.35fr .92fr;grid-template-rows:180px 180px 150px;gap:0;border-left:1px solid rgba(232,227,217,.18);border-top:1px solid rgba(232,227,217,.18);min-height:510px;}\n.hc-family{position:relative;display:flex;flex-direction:column;min-width:0;border-right:1px solid rgba(232,227,217,.18);border-bottom:1px solid rgba(232,227,217,.18);background:#090909;overflow:hidden;}\n.hc-family:hover,.hc-family:focus-within{background:#181716;}\n.hc-family:after{content:'';position:absolute;left:0;right:100%;bottom:0;height:2px;background:#c8a96e;transition:right 260ms cubic-bezier(.22,1,.36,1);z-index:8;}\n.hc-family:hover:after,.hc-family:focus-within:after{right:0;}\n.hc-family-image{width:100%;height:100%;object-fit:cover;position:absolute;inset:0;opacity:.47;filter:brightness(.7) saturate(.62);transition:opacity 280ms cubic-bezier(.22,1,.36,1),filter 280ms cubic-bezier(.22,1,.36,1);}\n.hc-family:hover .hc-family-image,.hc-family:focus-within .hc-family-image{opacity:.67;filter:brightness(.82) saturate(.72);}\n.hc-family-scrim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(9,9,9,.16),rgba(9,9,9,.92) 82%);}\n.hc-family-content{position:relative;z-index:4;margin-top:auto;padding:17px 16px 15px;}\n.hc-family-index{font:10px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.16em;color:#c8a96e;display:block;margin-bottom:8px;}\n.hc-family-title{font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;font-size:26px;line-height:.9;text-transform:uppercase;color:#e8e3d9;margin:0 0 9px;}\n.hc-family-tag{font-size:10px;line-height:1.45;color:#aaa49a;margin:0;max-width:270px;}\n.hc-family-meta{display:flex;justify-content:space-between;align-items:center;gap:10px;border-top:1px solid rgba(232,227,217,.18);margin-top:13px;padding-top:10px;font:9px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.1em;text-transform:uppercase;color:#aaa49a;}\n.hc-family-action{color:#e8e3d9;text-decoration:underline;text-decoration-color:#c8a96e;text-underline-offset:4px;white-space:nowrap;}\n.hc-family-action i{margin-left:6px;color:#c8a96e;transition:transform 220ms cubic-bezier(.22,1,.36,1);}\n.hc-family:hover .hc-family-action i,.hc-family:focus-within .hc-family-action i{transform:translateX(6px);}\n.hc-handles{grid-column:1;grid-row:1 / span 3;}\n.hc-door{grid-column:2 / span 2;grid-row:1 / span 3;}\n.hc-bath{grid-column:4;grid-row:1 / span 2;}\n.hc-kitchen{grid-column:4;grid-row:3;}\n.hc-furniture{grid-column:5;grid-row:1 / span 3;}\n.hc-door .hc-family-content{padding:21px 22px 19px;max-width:450px;}\n.hc-door .hc-family-title{font-size:44px;max-width:310px;}\n.hc-door .hc-family-tag{font-size:12px;max-width:340px;}\n.hc-door-list{display:grid;grid-template-columns:1fr 1fr;gap:0 20px;margin:16px 0 0;border-top:1px solid rgba(232,227,217,.2);padding-top:9px;}\n.hc-door-list span{font:9px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.03em;color:#aaa49a;padding:5px 0;border-bottom:1px solid rgba(232,227,217,.1);}\n.hc-door-list span:before{content:'—';color:#c8a96e;margin-right:6px;}\n.hc-bath .hc-family-title,.hc-furniture .hc-family-title{font-size:23px;}\n.hc-kitchen .hc-family-content{padding-top:12px;padding-bottom:12px;}\n.hc-kitchen .hc-family-title{font-size:24px;margin-bottom:5px;}\n.hc-kitchen .hc-family-tag{display:none;}\n.hc-furniture .hc-family-content{padding-left:14px;padding-right:14px;}\n.hc-furniture .hc-family-title{font-size:22px;}\n.hc-mobile-section{background:#090909;padding:82px 8% 96px;border-top:1px solid rgba(232,227,217,.18);}\n.hc-mobile-head{display:flex;justify-content:space-between;align-items:flex-end;border-bottom:1px solid rgba(232,227,217,.2);padding-bottom:18px;margin-bottom:30px;}\n.hc-mobile-head h2{font-family:'Cormorant Garamond',Georgia,serif;font-size:42px;line-height:.95;font-weight:400;margin:0;}\n.hc-mobile-head p{font:10px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.18em;color:#aaa49a;text-transform:uppercase;margin:0;}\n.hc-mobile-layout{display:grid;grid-template-columns:390px 1fr;gap:64px;align-items:start;}\n.hc-phone{background:#11100f;border:1px solid rgba(232,227,217,.25);padding:10px;width:390px;box-shadow:0 0 0 1px #090909;}\n.hc-phone-top{height:20px;display:flex;align-items:center;justify-content:space-between;padding:0 11px;color:#aaa49a;font:8px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.13em;}\n.hc-mobile-hero{position:relative;aspect-ratio:4/5;overflow:hidden;background:#181716;}\n.hc-mobile-hero img{width:100%;height:100%;object-fit:cover;filter:brightness(.72) saturate(.66);}\n.hc-mobile-hero:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(9,9,9,.06),rgba(9,9,9,.7));}\n.hc-mobile-copy{padding:19px 17px 17px;background:#11100f;border-bottom:1px solid rgba(232,227,217,.18);}\n.hc-mobile-copy .hc-eyebrow{font-size:8px;margin-bottom:9px;letter-spacing:.17em;}\n.hc-mobile-copy h3{font-family:'Cormorant Garamond',Georgia,serif;font-size:35px;line-height:.92;font-weight:400;margin:0 0 11px;max-width:260px;}\n.hc-mobile-copy p{font-size:10px;line-height:1.55;color:#aaa49a;margin:0 0 15px;}\n.hc-mobile-copy .hc-plate{width:100%;justify-content:space-between;min-height:49px;font-size:9px;}\n.hc-mobile-copy .hc-quiet-link{display:block;margin:12px 0 0;font-size:9px;width:max-content;}\n.hc-directory{border-top:1px solid rgba(232,227,217,.2);}\n.hc-directory-title{padding:15px 0 11px;font:9px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.19em;text-transform:uppercase;color:#c8a96e;}\n.hc-directory-row{display:grid;grid-template-columns:96px 31px 1fr 16px;min-height:108px;border-top:1px solid rgba(232,227,217,.15);align-items:stretch;text-decoration:none;color:#e8e3d9;}\n.hc-directory-row:hover,.hc-directory-row:focus-visible{background:#181716;outline:none;}\n.hc-directory-row img{width:96px;height:96px;align-self:center;object-fit:cover;filter:brightness(.72) saturate(.6);}\n.hc-directory-number{font:9px ui-monospace,SFMono-Regular,Menlo,monospace;color:#c8a96e;padding:14px 0 0 10px;}\n.hc-directory-info{padding:14px 8px 12px 12px;display:flex;flex-direction:column;justify-content:space-between;}\n.hc-directory-info strong{font-family:'Cormorant Garamond',Georgia,serif;font-size:23px;line-height:.9;font-weight:500;text-transform:uppercase;}\n.hc-directory-info span{font-size:9px;line-height:1.35;color:#aaa49a;max-width:240px;}\n.hc-directory-arrow{align-self:center;color:#c8a96e;font-size:16px;transition:transform 220ms cubic-bezier(.22,1,.36,1);}\n.hc-directory-row:hover .hc-directory-arrow,.hc-directory-row:focus-visible .hc-directory-arrow{transform:translateX(5px);}\n.hc-mobile-notes{padding-top:10px;max-width:470px;}\n.hc-mobile-notes .hc-section-kicker{margin-bottom:14px;}\n.hc-mobile-notes h3{font-family:'Cormorant Garamond',Georgia,serif;font-size:45px;line-height:.94;font-weight:400;margin:0 0 17px;max-width:430px;}\n.hc-mobile-notes p{font-size:13px;line-height:1.75;color:#aaa49a;max-width:410px;margin:0 0 22px;}\n.hc-note-line{display:flex;gap:14px;border-top:1px solid rgba(232,227,217,.18);padding:14px 0;color:#aaa49a;font-size:11px;line-height:1.55;}\n.hc-note-line strong{font:10px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.15em;color:#c8a96e;min-width:62px;}\n@media (max-width:900px){.hc-rail{left:16px;right:16px;grid-template-columns:1fr auto;height:62px;padding:0 14px}.hc-nav,.hc-phone{display:none}.hc-rail-actions{gap:0}.hc-rail-cta{height:38px}.hc-hero{height:620px}.hc-hero-copy{left:24px;bottom:73px;width:calc(100% - 48px)}.hc-hero-title{font-size:64px}.hc-hero-title em{margin-left:0}.hc-product-bay{left:58%;width:24%;top:90px;bottom:82px}.hc-macro-bay{width:30%}.hc-threshold{left:24px;right:24px}.hc-section,.hc-mobile-section{padding-left:24px;padding-right:24px}.hc-elevation{display:flex;flex-direction:column;min-height:0}.hc-family,.hc-handles,.hc-door,.hc-bath,.hc-kitchen,.hc-furniture{min-height:280px}.hc-door{min-height:420px}.hc-mobile-layout{grid-template-columns:1fr}.hc-phone{width:min(390px,100%)}.hc-mobile-notes{display:none}.hc-mobile-head{display:block}.hc-mobile-head p{margin-top:12px}}\n@media (prefers-reduced-motion:reduce){.hc-plate-rule,.hc-family-action i,.hc-directory-arrow,.hc-family:after,.hc-family-image{transition:none}.hc-product-bay:hover .hc-sweep{animation:none}}\n</style>\n<div class=\"hc-shell\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"hc-rail\" data-kid=\"1-1\" data-name=\"main navigation bar\">\n        <a aria-label=\"Hardware Collection home\" class=\"hc-brand hc-focus\" data-kid=\"1-1-1\" data-name=\"brand identity logo link\" href=\"#top\">\n            <span class=\"hc-mark\" data-kid=\"1-1-1-1\" data-name=\"brand mark icon\">\n                HC\n            </span>\n            <span data-kid=\"1-1-1-2\" data-name=\"brand name text\">\n                HARDWARE COLLECTION\n            </span>\n        </a>\n        <nav aria-label=\"Primary navigation\" class=\"hc-nav\" data-kid=\"1-1-2\" data-name=\"primary navigation menu\">\n            <a class=\"hc-focus\" data-kid=\"1-1-2-1\" data-name=\"home link\" href=\"#top\">\n                Home\n            </a>\n            <a class=\"hc-focus\" data-kid=\"1-1-2-2\" data-name=\"collections link\" href=\"#families\">\n                Collections\n            </a>\n            <a class=\"hc-focus\" data-kid=\"1-1-2-3\" data-name=\"showroom link\" href=\"#mobile-companion\">\n                Showroom\n            </a>\n        </nav>\n        <div class=\"hc-rail-actions\" data-kid=\"1-1-3\" data-name=\"rail actions container\">\n            <span class=\"hc-phone\" data-kid=\"1-1-3-1\" data-name=\"phone contact text\">\n                +91 98351 90738\n            </span>\n            <a class=\"hc-rail-cta hc-focus\" data-kid=\"1-1-3-2\" data-name=\"inquire call-to-action button\" href=\"#consult\">\n                Inquire\n                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right hc-icon\" data-kid=\"1-1-3-2-1\" data-name=\"arrow-up-right icon\">\n                </i>\n            </a>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content area\" id=\"top\">\n        <section aria-labelledby=\"hero-title\" class=\"hc-hero\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <img alt=\"Brushed brass door handle on a dark architectural door\" class=\"hc-hero-bg\" data-kid=\"1-2-1-1\" data-name=\"hero background image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/cinema/hero/HC-01-HERO-01.png\"/>\n            <div aria-hidden=\"true\" class=\"hc-hero-overlay\" data-kid=\"1-2-1-2\" data-name=\"hero gradient overlay\">\n            </div>\n            <div aria-hidden=\"true\" class=\"hc-bay-overlay\" data-kid=\"1-2-1-3\" data-name=\"left bay decorative overlay\" style=\"left:38%;width:14%\">\n            </div>\n            <div aria-hidden=\"true\" class=\"hc-bay-overlay\" data-kid=\"1-2-1-4\" data-name=\"right bay decorative overlay\" style=\"left:69%;width:10%\">\n            </div>\n            <span aria-hidden=\"true\" class=\"hc-structure-line\" data-kid=\"1-2-1-5\" data-name=\"left structure line\" style=\"left:38%\">\n            </span>\n            <span aria-hidden=\"true\" class=\"hc-structure-line brass\" data-kid=\"1-2-1-6\" data-name=\"left brass structure line\" style=\"left:51.5%\">\n            </span>\n            <span aria-hidden=\"true\" class=\"hc-structure-line\" data-kid=\"1-2-1-7\" data-name=\"right structure line\" style=\"left:69%\">\n            </span>\n            <span aria-hidden=\"true\" class=\"hc-structure-line brass\" data-kid=\"1-2-1-8\" data-name=\"right brass structure line\" style=\"left:79%\">\n            </span>\n            <div aria-label=\"Product specimen detail\" class=\"hc-product-bay\" data-kid=\"1-2-1-9\" data-name=\"product specimen detail bay\" tabindex=\"0\">\n                <img alt=\"Close detail of brushed brass lever handle\" data-kid=\"1-2-1-9-1\" data-name=\"brushed brass lever handle image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/cinema/hero/HC-01-HERO-02.png\"/>\n                <span aria-hidden=\"true\" class=\"hc-sweep\" data-dynamic=\"true\" data-kid=\"1-2-1-9-2\" data-name=\"sweep animation element\" data-reason=\"sweep animation replayed on hover by script\">\n                </span>\n            </div>\n            <div aria-hidden=\"true\" class=\"hc-macro-bay\" data-kid=\"1-2-1-10\" data-name=\"macro detail bay\">\n                <img alt=\"Macro detail of a brass hardware finish\" data-kid=\"1-2-1-10-1\" data-name=\"brass finish macro image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/cinema/hero/HC-01-HERO-03.png\"/>\n            </div>\n            <div class=\"hc-hero-copy\" data-kid=\"1-2-1-11\" data-name=\"hero copy content\">\n                <p class=\"hc-eyebrow\" data-kid=\"1-2-1-11-1\" data-name=\"hero eyebrow text\">\n                    Hardware Collection · Sakchi, Jamshedpur\n                </p>\n                <h1 class=\"hc-serif hc-hero-title\" data-kid=\"1-2-1-11-2\" data-name=\"hero title text\" id=\"hero-title\">\n                    The Art of\n                    <em data-kid=\"1-2-1-11-2-1\" data-name=\"hero title emphasis\">\n                        the Finish.\n                    </em>\n                </h1>\n                <p class=\"hc-hero-description\" data-kid=\"1-2-1-11-3\" data-name=\"hero description text\">\n                    Architectural hardware chosen for spaces that deserve better details. Official partner for Häfele, Dorset, Labacha, Godrej & Hettich in Sakchi.\n                </p>\n                <a class=\"hc-plate hc-focus\" data-kid=\"1-2-1-11-4\" data-name=\"hero explore collections button\" href=\"#families\">\n                    <span data-kid=\"1-2-1-11-4-1\" data-name=\"explore button label\">\n                        Explore collections\n                    </span>\n                    <span aria-hidden=\"true\" class=\"hc-plate-rule\" data-kid=\"1-2-1-11-4-2\" data-name=\"button decorative rule\">\n                    </span>\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right hc-icon\" data-kid=\"1-2-1-11-4-3\" data-name=\"arrow-up-right icon\">\n                    </i>\n                </a>\n                <a class=\"hc-quiet-link hc-focus\" data-kid=\"1-2-1-11-5\" data-name=\"showroom link\" href=\"#mobile-companion\">\n                    Visit the Sakchi showroom\n                </a>\n            </div>\n            <div class=\"hc-threshold\" data-kid=\"1-2-1-12\" data-name=\"hero threshold bar\">\n                <span data-kid=\"1-2-1-12-1\" data-name=\"threshold counter group\">\n                    <strong data-kid=\"1-2-1-12-1-1\" data-name=\"threshold counter text\">\n                        01 / 02\n                    </strong>\n                    Hero threshold\n                </span>\n                <a class=\"hc-threshold-route hc-focus\" data-kid=\"1-2-1-12-2\" data-name=\"threshold route link\" href=\"#mobile-companion\">\n                    Touch before you decide\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right hc-icon\" data-kid=\"1-2-1-12-2-1\" data-name=\"arrow-up-right icon\">\n                    </i>\n                </a>\n            </div>\n        </section>\n        <section aria-labelledby=\"families-title\" class=\"hc-section\" data-kid=\"1-2-2\" data-name=\"showroom families section\" id=\"families\">\n            <div class=\"hc-section-head\" data-kid=\"1-2-2-1\" data-name=\"section header container\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"section header title group\">\n                    <p class=\"hc-section-kicker\" data-kid=\"1-2-2-1-1-1\" data-name=\"section kicker text\">\n                        Showroom families / 05\n                    </p>\n                    <h2 class=\"hc-serif hc-section-title\" data-kid=\"1-2-2-1-1-2\" data-name=\"section title\" id=\"families-title\">\n                        A complete elevation\n                        <br data-kid=\"1-2-2-1-1-2-1\"/>\n                        of the showroom.\n                    </h2>\n                </div>\n                <p class=\"hc-section-note\" data-kid=\"1-2-2-1-2\" data-name=\"section note text\">\n                    Five practical families, arranged by the breadth of their specification. Browse products by the way hardware enters a space.\n                </p>\n            </div>\n            <div aria-label=\"Showroom family elevation\" class=\"hc-elevation\" data-kid=\"1-2-2-2\" data-name=\"showroom family elevation grid\">\n                <a class=\"hc-family hc-handles hc-focus\" data-kid=\"1-2-2-2-1\" data-name=\"handles family card\" href=\"#collections-handles\">\n                    <img alt=\"Main entrance door hardware in the showroom\" class=\"hc-family-image\" data-kid=\"1-2-2-2-1-1\" data-name=\"handles family image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/cinema/categories/HC-03-DOORS.png\"/>\n                    <span aria-hidden=\"true\" class=\"hc-family-scrim\" data-kid=\"1-2-2-2-1-2\" data-name=\"family card scrim\">\n                    </span>\n                    <div class=\"hc-family-content\" data-kid=\"1-2-2-2-1-3\" data-name=\"family card content\">\n                        <span class=\"hc-family-index\" data-kid=\"1-2-2-2-1-3-1\" data-name=\"family index text\">\n                            01 / 05\n                        </span>\n                        <h3 class=\"hc-family-title\" data-kid=\"1-2-2-2-1-3-2\" data-name=\"family title text\">\n                            Handles &\n                            <br data-kid=\"1-2-2-2-1-3-2-1\"/>\n                            Knobs\n                        </h3>\n                        <p class=\"hc-family-tag\" data-kid=\"1-2-2-2-1-3-3\" data-name=\"family tag text\">\n                            Contemporary profiles to classical architectural detailing.\n                        </p>\n                        <div class=\"hc-family-meta\" data-kid=\"1-2-2-2-1-3-4\" data-name=\"family meta group\">\n                            <span data-kid=\"1-2-2-2-1-3-4-1\" data-name=\"collection count text\">\n                                2 collections\n                            </span>\n                            <span class=\"hc-family-action\" data-kid=\"1-2-2-2-1-3-4-2\" data-name=\"browse link\">\n                                Browse products\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-right hc-icon\" data-kid=\"1-2-2-2-1-3-4-2-1\" data-name=\"arrow-right icon\">\n                                </i>\n                            </span>\n                        </div>\n                    </div>\n                </a>\n                <a class=\"hc-family hc-door hc-focus\" data-kid=\"1-2-2-2-2\" data-name=\"door family card\" href=\"#collections-door\">\n                    <img alt=\"Digital lock and door security