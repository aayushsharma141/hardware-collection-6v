      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DM+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  :root {\n    --black: #090909;\n    --obsidian: #11100f;\n    --graphite: #181716;\n    --bone: #e8e3d9;\n    --muted: #aaa49a;\n    --brass: #c8a96e;\n    --rule: rgba(232, 227, 217, 0.14);\n    --soft-rule: rgba(232, 227, 217, 0.08);\n    --brass-rule: rgba(200, 169, 110, 0.55);\n    --standard: cubic-bezier(0.25, 0.1, 0.25, 1);\n    --cinematic: cubic-bezier(0.22, 1, 0.36, 1);\n  }\n  .hc-root { font-family: 'DM Sans', sans-serif; background: var(--black); color: var(--bone); }\n  .hc-serif { font-family: 'Cormorant Garamond', Georgia, serif; }\n  .hc-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }\n  .hc-root button, .hc-root a, .hc-root input { font: inherit; }\n  .hc-focus:focus-visible { outline: 2px solid var(--brass); outline-offset: 3px; }\n  .architecture-rule { position: relative; }\n  .architecture-rule::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: var(--brass); transform: scaleX(0.18); transform-origin: left; transition: transform 220ms var(--standard); }\n  .architecture-rule:hover::after, .architecture-rule:focus-within::after { transform: scaleX(1); }\n  .specimen-tray { position: relative; background: var(--obsidian); border: 1px solid var(--rule); transition: border-color 220ms var(--standard); }\n  .specimen-tray:hover, .specimen-tray:focus-within { border-color: var(--brass-rule); }\n  .specimen-frame { position: relative; isolation: isolate; overflow: hidden; background: var(--graphite); border: 1px solid var(--soft-rule); }\n  .specimen-frame::before { content: ''; position: absolute; inset: 8px; border: 1px solid rgba(232,227,217,.10); pointer-events: none; z-index: 2; transition: border-color 220ms var(--standard); }\n  .specimen-frame::after { content: ''; position: absolute; left: 18%; right: 18%; bottom: 12%; height: 20%; z-index: 1; background: linear-gradient(90deg, transparent, rgba(200,169,110,.26), transparent); transform: translateX(-14%); transition: transform 220ms var(--cinematic), left 220ms var(--standard), right 220ms var(--standard); pointer-events: none; }\n  .specimen-tray:hover .specimen-frame::before, .specimen-tray:focus-within .specimen-frame::before { border-color: rgba(200,169,110,.48); }\n  .specimen-tray:hover .specimen-frame::after, .specimen-tray:focus-within .specimen-frame::after { transform: translateX(14%); left: 12%; right: 12%; }\n  .shortlist-control .ti-plus { transition: transform 180ms var(--standard); }\n  .shortlist-control:hover .ti-plus, .shortlist-control[aria-pressed='true'] .ti-plus { transform: rotate(45deg); }\n  .shortlist-control[aria-pressed='true'] { background: var(--brass); color: var(--black); border-color: var(--brass); }\n  .shortlist-control[aria-pressed='true'] .ti-plus::before { content: '\\ea5e'; }\n  .mobile-filter-row { position: relative; min-height: 56px; border-bottom: 1px solid var(--soft-rule); transition: background-color 180ms var(--standard), color 180ms var(--standard); }\n  .mobile-filter-row:hover { background: rgba(200,169,110,.08); }\n  .mobile-filter-row.is-selected::before { content: ''; position: absolute; top: 0; bottom: 0; left: 0; width: 3px; background: var(--brass); }\n  .check-box { width: 16px; height: 16px; border: 1px solid rgba(232,227,217,.32); display: inline-flex; align-items: center; justify-content: center; color: var(--black); flex: 0 0 auto; }\n  .check-box.is-checked { background: var(--brass); border-color: var(--brass); }\n  .index-row { min-height: 44px; border-bottom: 1px solid var(--soft-rule); }\n  .index-row.is-active { color: var(--bone); }\n  .index-row.is-active .index-rule { transform: scaleX(1); }\n  .index-rule { width: 34px; height: 2px; background: var(--brass); transform: scaleX(.35); transform-origin: left; transition: transform 180ms var(--standard); }\n  .mobile-phone { background: var(--black); border: 1px solid rgba(232,227,217,.22); }\n  .phone-notch { width: 112px; height: 20px; border: 1px solid rgba(232,227,217,.16); border-top: 0; background: var(--black); margin: 0 auto; }\n  .scanline { position: absolute; left: 0; right: 0; top: 46%; height: 1px; background: var(--brass); opacity: .7; }\n  .mobile-drawer { position: absolute; inset: 0; background: var(--obsidian); border-left: 1px solid var(--brass); z-index: 5; }\n  .mobile-drawer::after { content: ''; position: absolute; top: 0; bottom: 0; right: 0; width: 1px; background: rgba(232,227,217,.10); }\n</style>\n<div class=\"hc-root min-h-screen w-full bg-[#090909] text-[#e8e3d9]\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"mx-auto max-w-[1380px] px-8 py-7\" data-kid=\"1-1\" data-name=\"navigation and collection header container\">\n        <!-- Architectural navigation rail -->\n        <header class=\"border border-white/[0.14] bg-[#11100f]\" data-kid=\"1-1-1\" data-name=\"header navigation rail\">\n            <div class=\"grid grid-cols-[1fr_auto_1fr] items-center min-h-[62px]\" data-kid=\"1-1-1-1\" data-name=\"header navigation layout grid\">\n                <a class=\"hc-focus flex items-center gap-3 px-5 text-[#e8e3d9] no-underline\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo and title link\" href=\"#collection\">\n                    <span class=\"flex h-8 w-8 items-center justify-center border border-[#c8a96e]/60 text-[11px] font-semibold tracking-[0.08em] text-[#c8a96e]\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand icon\">\n                        HC\n                    </span>\n                    <span class=\"hc-serif text-[22px] tracking-[0.04em]\" data-kid=\"1-1-1-1-1-2\" data-name=\"brand title text\">\n                        Hardware Collection\n                    </span>\n                </a>\n                <nav aria-label=\"Primary navigation\" class=\"flex h-full items-center border-x border-white/[0.10]\" data-kid=\"1-1-1-1-2\" data-name=\"primary navigation menu\">\n                    <a class=\"hc-focus flex min-h-[62px] items-center px-7 text-[10px] uppercase tracking-[0.22em] text-[#aaa49a] no-underline hover:text-[#e8e3d9]\" data-kid=\"1-1-1-1-2-1\" data-name=\"home navigation link\" href=\"#home\">\n                        Home\n                    </a>\n                    <a class=\"hc-focus architecture-rule flex min-h-[62px] items-center px-7 text-[10px] font-semibold uppercase tracking-[0.22em] text-[#e8e3d9] no-underline\" data-kid=\"1-1-1-1-2-2\" data-name=\"collections navigation link\" href=\"#collection\">\n                        Collections\n                    </a>\n                </nav>\n                <div class=\"flex items-center justify-end divide-x divide-white/[0.10]\" data-kid=\"1-1-1-1-3\" data-name=\"contact navigation buttons container\">\n                    <a class=\"hc-focus flex min-h-[62px] items-center gap-2 px-5 text-[10px] uppercase tracking-[0.16em] text-[#aaa49a] no-underline hover:text-[#e8e3d9]\" data-kid=\"1-1-1-1-3-1\" data-name=\"phone number contact link\" href=\"tel:+919835190738\">\n                        <i aria-hidden=\"true\" class=\"ti ti-phone\" data-kid=\"1-1-1-1-3-1-1\" data-name=\"phone icon\" style=\"display:inline-flex;width:14px;height:14px;align-items:center;justify-content:center;color:#c8a96e;font-size:14px\">\n                        </i>\n                        +91 98351 90738\n                    </a>\n                    <a class=\"hc-focus flex min-h-[62px] items-center gap-2 bg-[#c8a96e] px-6 text-[10px] font-bold uppercase tracking-[0.20em] text-[#090909] no-underline hover:bg-[#e8e3d9]\" data-kid=\"1-1-1-1-3-2\" data-name=\"inquire call-to-action button\" href=\"#consult\">\n                        Inquire\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right\" data-kid=\"1-1-1-1-3-2-1\" data-name=\"arrow-up-right icon\" style=\"display:inline-flex;width:15px;height:15px;align-items:center;justify-content:center;font-size:15px;color:#090909\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n        </header>\n        <!-- Quiet two-axis masthead -->\n        <section class=\"grid grid-cols-12 gap-10 border-b border-[#c8a96e] pb-7 pt-20\" data-kid=\"1-1-2\" data-name=\"collection masthead section\" id=\"collection\">\n            <div class=\"col-span-7\" data-kid=\"1-1-2-1\" data-name=\"masthead title container\">\n                <div class=\"mb-4 flex items-center gap-3\" data-kid=\"1-1-2-1-1\" data-name=\"masthead status indicator container\">\n                    <span class=\"h-1 w-1 bg-[#c8a96e]\" data-kid=\"1-1-2-1-1-1\" data-name=\"status bullet\">\n                    </span>\n                    <span class=\"hc-mono text-[10px] uppercase tracking-[0.22em] text-[#aaa49a]\" data-kid=\"1-1-2-1-1-2\" data-name=\"status text\">\n                        Authorized digital showroom\n                    </span>\n                </div>\n                <h1 class=\"hc-serif m-0 text-[86px] font-normal uppercase leading-[0.86] tracking-[0.04em] text-[#e8e3d9]\" data-kid=\"1-1-2-1-2\" data-name=\"collection section headline\">\n                    The\n                    <br data-kid=\"1-1-2-1-2-1\" data-name=\"headline line break\"/>\n                    Collection\n                </h1>\n            </div>\n            <div class=\"col-span-5 flex flex-col justify-end pb-1\" data-kid=\"1-1-2-2\" data-name=\"masthead description and details container\">\n                <p class=\"max-w-[38ch] text-[14px] leading-7 text-[#aaa49a]\" data-kid=\"1-1-2-2-1\" data-name=\"collection description text\">\n                    Curated architectural hardware for considered residential and commercial interiors. Authorized partner for Hafele, Dorset, Labacha, Godrej, Hettich & Kich.\n                </p>\n                <div class=\"mt-7 flex items-center justify-between border-t border-white/[0.12] pt-3\" data-kid=\"1-1-2-2-2\" data-name=\"location and label container\">\n                    <span class=\"text-[10px] uppercase tracking-[0.18em] text-[#aaa49a]\" data-kid=\"1-1-2-2-2-1\" data-name=\"product specification label\">\n                        Product specification wall\n                    </span>\n                    <span class=\"hc-mono text-[10px] uppercase tracking-[0.18em] text-[#c8a96e]\" data-kid=\"1-1-2-2-2-2\" data-name=\"location text\">\n                        Sakchi · Jamshedpur\n                    </span>\n                </div>\n            </div>\n        </section>\n        <!-- Desktop specification wall -->\n        <div class=\"grid grid-cols-[250px_1fr] gap-10 pt-10\" data-kid=\"1-1-3\" data-name=\"collection specification wall container\">\n            <aside aria-label=\"Collection index\" class=\"border-r border-white/[0.14] pr-7\" data-kid=\"1-1-3-1\" data-name=\"collection index sidebar\">\n                <div class=\"mb-7 flex items-center justify-between\" data-kid=\"1-1-3-1-1\" data-name=\"index header container\">\n                    <span class=\"hc-mono text-[10px] uppercase tracking-[0.20em] text-[#c8a96e]\" data-kid=\"1-1-3-1-1-1\" data-name=\"index title\">\n                        Collection index\n                    </span>\n                    <span class=\"hc-mono text-[10px] text-[#aaa49a]\" data-kid=\"1-1-3-1-1-2\" data-name=\"index count text\">\n                        07 total\n                    </span>\n                </div>\n                <a class=\"index-row hc-focus flex items-center justify-between text-[11px] uppercase tracking-[0.14em] text-[#e8e3d9] no-underline\" data-kid=\"1-1-3-1-2\" data-name=\"all collections navigation link\" href=\"#all\">\n                    <span data-kid=\"1-1-3-1-2-1\" data-name=\"all collections text\">\n                        All collections\n                    </span>\n                    <span class=\"hc-mono text-[10px] text-[#aaa49a]\" data-kid=\"1-1-3-1-2-2\" data-name=\"all collections count\">\n                        07\n                    </span>\n                </a>\n                <div class=\"mt-8\" data-kid=\"1-1-3-1-3\" data-name=\"showroom families navigation group\">\n                    <p class=\"hc-mono mb-2 text-[9px] uppercase tracking-[0.20em] text-[#aaa49a]\" data-kid=\"1-1-3-1-3-1\" data-name=\"showroom families header\">\n                        Showroom families\n                    </p>\n                    <a class=\"index-row hc-focus flex items-center gap-3 text-[11px] uppercase tracking-[0.12em] text-[#aaa49a] no-underline hover:text-[#e8e3d9]\" data-kid=\"1-1-3-1-3-2\" data-name=\"handles and knobs navigation link\" href=\"#handles\">\n                        <span class=\"hc-mono w-6 text-[10px] text-[#c8a96e]\" data-kid=\"1-1-3-1-3-2-1\" data-name=\"family index number\">\n                            01\n                        </span>\n                        <span class=\"flex-1\" data-kid=\"1-1-3-1-3-2-2\" data-name=\"family name\">\n                            Handles & Knobs\n                        </span>\n                        <span class=\"hc-mono text-[10px]\" data-kid=\"1-1-3-1-3-2-3\" data-name=\"family count\">\n                            02\n                        </span>\n                    </a>\n                    <a class=\"index-row is-active hc-focus flex items-center gap-3 text-[11px] uppercase tracking-[0.12em] no-underline\" data-kid=\"1-1-3-1-3-3\" data-name=\"door hardware navigation link\" href=\"#door\">\n                        <span class=\"hc-mono w-6 text-[10px] text-[#c8a96e]\" data-kid=\"1-1-3-1-3-3-1\" data-name=\"family index number\">\n                            02\n                        </span>\n                        <span class=\"index-rule\" data-kid=\"1-1-3-1-3-3-2\" data-name=\"active state indicator\">\n                        </span>\n                        <span class=\"flex-1 font-semibold\" data-kid=\"1-1-3-1-3-3-3\" data-name=\"family name\">\n                            Door Hardware\n                        </span>\n                        <span class=\"hc-mono text-[10px] text-[#c8a96e]\" data-kid=\"1-1-3-1-3-3-4\" data-name=\"family count\">\n                            06\n                        </span>\n                    </a>\n                    <div class=\"border-l border-[#c8a96e]/35 ml-9 pl-4\" data-kid=\"1-1-3-1-3-4\" data-name=\"door hardware sub-categories container\">\n                        <a class=\"hc-focus flex min-h-[32px] items-center justify-between border-b border-white/[0.06] text-[10px] text-[#e8e3d9] no-underline\" data-kid=\"1-1-3-1-3-4-1\" data-name=\"digital locks sub-category link\" href=\"#digital-locks\">\n                            <span data-kid=\"1-1-3-1-3-4-1-1\" data-name=\"sub-category name\">\n                                Digital Locks\n                            </span>\n                            <span class=\"hc-mono text-[9px] text-[#c8a96e]\" data-kid=\"1-1-3-1-3-4-1-2\" data-name=\"sub-category count\">\n                                02\n                            </span>\n                        </a>\n                        <a class=\"hc-focus flex min-h-[32px] items-center justify-between border-b border-white/[0.06] text-[10px] text-[#aaa49a] no-underline\" data-kid=\"1-1-3-1-3-4-2\" data-name=\"mortise and door locks sub-category link\" href=\"#mortise\">\n                            <span data-kid=\"1-1-3-1-3-4-2-1\" data-name=\"sub-category name\">\n                                Mortise & Door Locks\n                            </span>\n                            <span class=\"hc-mono text-[9px]\" data-kid=\"1-1-3-1-3-4-2-2\" data-name=\"sub-category count\">\n                                00\n                            </span>\n                        </a>\n                        <a class=\"hc-focus flex min-h-[32px] items-center justify-between border-b border-white/[0.06] text-[10px] text-[#aaa49a] no-underline\" data-kid=\"1-1-3-1-3-4-3\" data-name=\"main door handles sub-category link\" href=\"#handles\">\n                            <span data-kid=\"1-1-3-1-3-4-3-1\" data-name=\"sub-category name\">\n                                Main Door Handles\n                            </span>\n                            <span class=\"hc-mono text-[9px]\" data-kid=\"1-1-3-1-3-4-3-2\" data-name=\"sub-category count\">\n                                00\n                            </span>\n                        </a>\n                        <a class=\"hc-focus flex min-h-[32px] items-center justify-between border-b border-white/[0.06] text-[10px] text-[#aaa49a] no-underline\" data-kid=\"1-1-3-1-3-4-4\" data-name=\"glass hardware sub-category link\" href=\"#glass\">\n                            <span data-kid=\"1-1-3-1-3-4-4-1\" data-name=\"sub-category name\">\n                                Glass Hardware\n                            </span>\n                            <span class=\"hc-mono text-[9px]\" data-kid=\"1-1-3-1-3-4-4-2\" data-name=\"sub-category count\">\n                                01\n                            </span>\n                        </a>\n                        <a class=\"hc-focus flex min-h-[32px] items-center justify-between border-b border-white/[0.06] text-[10px] text-[#aaa49a] no-underline\" data-kid=\"1-1-3-1-3-4-5\" data-name=\"door closers and stoppers sub-category link\" href=\"#closers\">\n                            <span data-kid=\"1-1-3-1-3-4-5-1\" data-name=\"sub-category name\">\n                                Door Closers & Stoppers\n                            </span>\n                            <span class=\"hc-mono text-[9px]\" data-kid=\"1-1-3-1-3-4-5-2\" data-name=\"sub-category count\">\n                                00\n                            </span>\n                        </a