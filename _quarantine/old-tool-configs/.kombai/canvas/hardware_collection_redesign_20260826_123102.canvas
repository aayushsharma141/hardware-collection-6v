         </div>\n                        <button aria-label=\"Close filter\" class=\"hc-focus flex h-11 w-11 items-center justify-center border border-white/[0.18] text-[#e8e3e9]\" data-kid=\"1-4-1-2-3-1-2\">\n                            <i aria-hidden=\"true\" class=\"ti ti-x text-[17px]\" data-kid=\"1-4-1-2-3-1-2-1\" style=\"width:17px;height:17px;color:#e8e3e9\">\n                            </i>\n                        </button>\n                    </div>\n                    <div class=\"min-h-0 flex-1 overflow-hidden px-5 pb-24 pt-5\" data-kid=\"1-4-1-2-3-2\" data-name=\"mobile filter option list\">\n                        <label class=\"block text-[9px] uppercase tracking-[0.18em] text-[#aaa49a]\" data-kid=\"1-4-1-2-3-2-1\">\n                            Search by product, brand or reference\n                            <span class=\"mt-2 flex h-12 items-center border border-white/[0.18] px-3 text-[11px] text-[#aaa49a]\" data-kid=\"1-4-1-2-3-2-1-1\">\n                                <i aria-hidden=\"true\" class=\"ti ti-search mr-2 text-[15px]\" data-kid=\"1-4-1-2-3-2-1-1-1\" style=\"width:15px;height:15px;color:#c8a96e\">\n                                </i>\n                                Search catalogue\n                            </span>\n                        </label>\n                        <div class=\"mt-7\" data-kid=\"1-4-1-2-3-2-2\">\n                            <p class=\"mb-2 font-mono text-[9px] uppercase tracking-[0.18em] text-[#aaa49a]\" data-kid=\"1-4-1-2-3-2-2-1\">\n                                Showroom families\n                            </p>\n                            <button class=\"hc-focus hc-mobile-row flex w-full items-center gap-3 border-b border-[#c8a96e] px-3 text-left\" data-active=\"true\" data-kid=\"1-4-1-2-3-2-2-2\" data-name=\"mobile showroom family row\">\n                                <span class=\"w-6 font-mono text-[10px] text-[#c8a96e]\" data-kid=\"1-4-1-2-3-2-2-2-1\">\n                                    02\n                                </span>\n                                <span class=\"flex-1 text-[12px] uppercase tracking-[0.1em] text-[#e8e3e9]\" data-kid=\"1-4-1-2-3-2-2-2-2\">\n                                    Door hardware\n                                </span>\n                                <span class=\"font-mono text-[10px] text-[#aaa49a]\" data-kid=\"1-4-1-2-3-2-2-2-3\">\n                                    06\n                                </span>\n                                <i aria-hidden=\"true\" class=\"ti ti-chevron-up text-[15px]\" data-kid=\"1-4-1-2-3-2-2-2-4\" data-name=\"chevron up icon\" style=\"width:15px;height:15px;color:#c8a96e\">\n                                </i>\n                            </button>\n                            <div class=\"hc-index-branch ml-5 pl-4\" data-kid=\"1-4-1-2-3-2-2-3\">\n                                <button class=\"hc-focus flex min-h-[42px] w-full items-center border-b border-white/[0.06] text-left text-[11px] text-[#e8e3e9]\" data-kid=\"1-4-1-2-3-2-2-3-1\">\n                                    <span class=\"flex-1\" data-kid=\"1-4-1-2-3-2-2-3-1-1\">\n                                        Digital Locks\n                                    </span>\n                                    <span class=\"font-mono text-[9px] text-[#c8a96e]\" data-kid=\"1-4-1-2-3-2-2-3-1-2\">\n                                        02\n                                    </span>\n                                </button>\n                                <button class=\"hc-focus flex min-h-[42px] w-full items-center border-b border-white/[0.06] text-left text-[11px] text-[#aaa49a]\" data-kid=\"1-4-1-2-3-2-2-3-2\">\n                                    <span class=\"flex-1\" data-kid=\"1-4-1-2-3-2-2-3-2-1\">\n                                        Mortise & Door Locks\n                                    </span>\n                                    <span class=\"font-mono text-[9px]\" data-kid=\"1-4-1-2-3-2-2