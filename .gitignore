# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
docs/evidence/*.key

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# test artifacts & traces
trace.json
lighthouse-report.html
/test-results/
/audit-reports/screenshots/
public/*.png
*.log

/src/generated/prisma

.vercel
.env*

# impeccable local state
.impeccable/
.impeccable/**

# ide & editor config
.claude/

# TypeScript incremental build cache (regenerated by every tsc run)
*.tsbuildinfo

# quarantined junk awaiting review
/_quarantine/
!/_quarantine/README.md
!/_quarantine/MANIFEST.tsv
/Hardware Collection/

# graphify generated artifacts (>100MB)
/graphify-out/
/.planning/graphs/

# local Sanity snapshots taken before destructive CMS migrations
/.backups/


# graft session cache
/graft/

# generated by scripts/build-catalog-index.mjs
/public/search-indexes/
